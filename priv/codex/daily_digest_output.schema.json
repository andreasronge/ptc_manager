{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "title",
    "summary",
    "what_shipped",
    "what_we_learned",
    "evidence_sha256",
    "window_started_at",
    "window_ended_at",
    "source_head_sha",
    "change_count",
    "pull_request_numbers"
  ],
  "properties": {
    "status": {"type": "string", "enum": ["published", "no-changes"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 180},
    "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
    "what_shipped": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "summary", "why_it_matters"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1, "maxLength": 80},
          "summary": {"type": "string", "minLength": 1, "maxLength": 800},
          "why_it_matters": {"type": "string", "minLength": 1, "maxLength": 800}
        }
      }
    },
    "what_we_learned": {
      "type": "array", "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_ids", "lesson"],
        "properties": {
          "source_ids": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
          "lesson": {"type": "string", "minLength": 1, "maxLength": 1200}
        }
      }
    },
    "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "window_started_at": {"type": "string", "format": "date-time"},
    "window_ended_at": {"type": "string", "format": "date-time"},
    "source_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "change_count": {"type": "integer", "minimum": 0, "maximum": 100},
    "pull_request_numbers": {
      "type": "array",
      "maxItems": 50,
      "items": {"type": "integer", "minimum": 1}
    }
  }
}
