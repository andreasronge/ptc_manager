{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outcome",
    "private_summary",
    "why_it_matters",
    "scope",
    "risk",
    "technical_evidence",
    "github_changes",
    "evidence",
    "decision_question",
    "decision_options",
    "created_issue_numbers",
    "suggestions"
  ],
  "properties": {
    "outcome": {
      "type": "string",
      "enum": ["ready", "blocked", "needs-decision", "reject", "followups-proposed", "followups-created", "no-followups", "merge-ready", "merge-blocked", "merge-needs-decision", "repaired", "repair-blocked"]
    },
    "private_summary": {"type": "string", "minLength": 1, "maxLength": 4000},
    "why_it_matters": {"type": "string", "minLength": 1, "maxLength": 4000},
    "scope": {"type": "string", "enum": ["small", "medium", "large"]},
    "risk": {"type": "string", "enum": ["low", "medium", "high"]},
    "technical_evidence": {"type": "string", "minLength": 1, "maxLength": 10000},
    "github_changes": {
      "type": "array",
      "maxItems": 50,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "evidence": {
      "type": "array",
      "maxItems": 50,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "decision_question": {"type": "string", "maxLength": 1000},
    "decision_options": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "description", "example"],
        "properties": {
          "label": {"type": "string", "minLength": 1, "maxLength": 120},
          "description": {"type": "string", "minLength": 1, "maxLength": 1000},
          "example": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "created_issue_numbers": {
      "type": "array",
      "maxItems": 50,
      "items": {"type": "integer", "minimum": 1}
    },
    "suggestions": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "simple_summary",
          "why_it_matters",
          "category",
          "technical_evidence",
          "suggested_issue_body"
        ],
        "properties": {
          "title": {"type": "string", "minLength": 1, "maxLength": 160},
          "simple_summary": {"type": "string", "minLength": 1, "maxLength": 1000},
          "why_it_matters": {"type": "string", "minLength": 1, "maxLength": 1000},
          "category": {
            "type": "string",
            "enum": ["potential-bug", "refactoring", "flaky-test", "missing-test", "surprise", "other"]
          },
          "technical_evidence": {"type": "string", "minLength": 1, "maxLength": 4000},
          "suggested_issue_body": {"type": "string", "minLength": 1, "maxLength": 10000}
        }
      }
    }
  }
}
