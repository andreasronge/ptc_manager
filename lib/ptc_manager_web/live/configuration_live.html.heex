<Layouts.app flash={@flash} current_path="/configuration">
  <div class="space-y-8">
    <section class="flex flex-col justify-between gap-5 lg:flex-row lg:items-end">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-teal-300">
          Configuration
        </p>
        <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">
          Agent prompt instructions
        </h1>
        <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-400">
          Add instructions to every prompt launched by a button. Saved changes affect prompts that start afterward; a prompt already running keeps the exact instructions it started with.
        </p>
      </div>
    </section>

    <aside class="rounded-2xl border border-amber-400/20 bg-amber-400/10 p-5 text-sm leading-6 text-amber-100">
      <p class="font-semibold">What stays protected</p>
      <p class="mt-1 text-amber-100/80">
        PtcManager still injects the exact repository, issue or PR number, branch, and verified SHA. Target limits and core authorization remain protected. In particular, conflict repair merges the latest main branch and uses a normal fast-forward push; it does not need force-push.
      </p>
    </aside>

    <section id="repository-health" aria-labelledby="repository-health-title">
      <div class="mb-4">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-teal-300">Repositories</p>
        <h2 id="repository-health-title" class="mt-1 text-2xl font-semibold">
          Configuration health
        </h2>
        <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-400">
          Each repository needs its own verified checkout, readable GitHub data, and a checked-in setup contract. Independent publication verification is optional and only needed when PtcManager publishes through its GitHub App broker.
        </p>
      </div>

      <details
        id="add-repository"
        class="mb-5 rounded-2xl border border-dashed border-teal-400/30 bg-teal-400/[0.04] p-5"
      >
        <summary class="cursor-pointer font-semibold text-teal-200">
          Add another GitHub repository
        </summary>
        <p class="mt-2 text-sm leading-6 text-slate-400">
          Register an existing dedicated checkout. The repository starts disabled and receives its own editable automation definitions. PtcManager never copies credentials or enables schedules automatically.
        </p>
        <.form
          for={%{}}
          as={:repository}
          phx-submit="add-repository"
          class="mt-4 grid gap-3 md:grid-cols-2"
        >
          <label class="text-xs text-slate-400">
            GitHub owner<input
              required
              name="repository[github_owner]"
              class="mt-1 w-full rounded-lg border border-white/10 bg-slate-950 p-2 text-sm"
            />
          </label>
          <label class="text-xs text-slate-400">
            Repository name<input
              required
              name="repository[github_name]"
              class="mt-1 w-full rounded-lg border border-white/10 bg-slate-950 p-2 text-sm"
            />
          </label>
          <label class="text-xs text-slate-400">
            Default branch<input
              required
              name="repository[default_branch]"
              value="main"
              class="mt-1 w-full rounded-lg border border-white/10 bg-slate-950 p-2 text-sm"
            />
          </label>
          <label class="text-xs text-slate-400">
            Dedicated checkout path<input
              required
              name="repository[local_path]"
              placeholder="/srv/ptc-manager/repos/project"
              class="mt-1 w-full rounded-lg border border-white/10 bg-slate-950 p-2 font-mono text-sm"
            />
          </label>
          <button class="w-fit rounded-xl bg-teal-400 px-4 py-2 text-sm font-semibold text-slate-950">
            Add disabled repository
          </button>
        </.form>
      </details>

      <div class="grid gap-5 xl:grid-cols-2">
        <article
          :for={health <- @repository_health}
          id={"repository-health-#{health.repository.id}"}
          class="rounded-2xl border border-white/10 bg-slate-900/70 p-5"
        >
          <div class="flex items-start justify-between gap-4">
            <div>
              <h3 class="font-semibold text-white">
                {health.repository.github_owner}/{health.repository.github_name}
              </h3>
              <p class="mt-1 text-xs text-slate-500">
                Default branch: {health.repository.default_branch}
              </p>
            </div>
            <span class={[
              "rounded-full px-2.5 py-1 text-xs font-semibold",
              if(health.repository.enabled,
                do: "bg-teal-400/15 text-teal-200",
                else: "bg-white/5 text-slate-400"
              )
            ]}>
              {if(health.repository.enabled, do: "Enabled", else: "Disabled")}
            </span>
          </div>

          <dl class="mt-5 space-y-3">
            <div
              :for={check <- [health.checkout, health.github, health.gate]}
              class="rounded-xl bg-white/[0.035] p-3"
            >
              <div class="flex flex-wrap items-center justify-between gap-2">
                <dt class="text-sm font-medium text-slate-200">{check.label}</dt>
                <span class={[
                  "rounded-full px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide",
                  health_classes(check.status)
                ]}>
                  {check.status}
                </span>
              </div>
              <dd class="mt-1 break-words font-mono text-xs leading-5 text-slate-500">
                {health_detail(check)}
              </dd>
            </div>
          </dl>
        </article>

        <div
          :if={@repository_health == []}
          class="rounded-2xl border border-dashed border-white/10 p-8 text-center text-sm text-slate-500"
        >
          No repositories are configured yet.
        </div>
      </div>
    </section>

    <section id="prompt-configuration" class="grid gap-5 xl:grid-cols-2">
      <article
        :for={prompt <- @prompts}
        id={"prompt-#{prompt.key}"}
        class="rounded-2xl border border-white/10 bg-slate-900/70 p-5 shadow-xl shadow-black/10"
      >
        <div class="flex items-start justify-between gap-4">
          <div>
            <h2 class="text-lg font-semibold text-white">{prompt.label}</h2>
            <p class="mt-1 text-xs font-medium uppercase tracking-wide text-teal-300">
              Button: {prompt.button}
            </p>
          </div>
          <span class={[
            "rounded-full px-2.5 py-1 text-xs font-semibold",
            if(prompt.customization,
              do: "bg-teal-400/15 text-teal-200",
              else: "bg-white/5 text-slate-400"
            )
          ]}>
            {if(prompt.customization, do: "Customized", else: "Default")}
          </span>
        </div>

        <p class="mt-3 text-sm leading-6 text-slate-400">{prompt.description}</p>

        <.form
          for={%{}}
          as={:customization}
          phx-submit="save-prompt"
          class="mt-5 space-y-3"
        >
          <input type="hidden" name="action-key" value={prompt.key} />
          <label
            for={"instructions-#{prompt.key}"}
            class="block text-sm font-medium text-slate-200"
          >
            Additional instructions
          </label>
          <textarea
            id={"instructions-#{prompt.key}"}
            name="customization[instructions]"
            rows="7"
            maxlength="20000"
            placeholder="Example: Prefer the smallest documentation-only repair and mention any skipped environment-specific test in the final evidence."
            class="block w-full rounded-xl border border-white/10 bg-slate-950/70 px-3 py-3 font-mono text-sm leading-6 text-slate-100 outline-none transition focus:border-teal-400/60 focus:ring-2 focus:ring-teal-400/20"
          >{prompt.customization && prompt.customization.instructions}</textarea>
          <div class="flex flex-wrap items-center gap-3">
            <button
              type="submit"
              class="rounded-xl bg-teal-400 px-4 py-2 text-sm font-semibold text-slate-950 transition hover:bg-teal-300"
            >
              Save instructions
            </button>
            <button
              type="button"
              phx-click="show-prompt-preview"
              phx-value-action-key={prompt.key}
              class="rounded-xl border border-teal-400/25 bg-teal-400/[0.06] px-4 py-2 text-sm font-semibold text-teal-200 transition hover:border-teal-400/40 hover:bg-teal-400/10"
            >
              Preview full prompt
            </button>
            <button
              :if={prompt.customization}
              type="button"
              phx-click="reset-prompt"
              phx-value-action-key={prompt.key}
              data-confirm="Reset this prompt to its built-in default instructions?"
              class="rounded-xl border border-white/10 px-4 py-2 text-sm font-semibold text-slate-300 transition hover:border-white/20 hover:text-white"
            >
              Reset to default
            </button>
            <span :if={prompt.customization} class="text-xs text-slate-500">
              Last saved by {prompt.customization.updated_by}
            </span>
          </div>
        </.form>
      </article>
    </section>

    <div
      :if={@preview_action_key}
      id="prompt-preview-overlay"
      class="fixed inset-0 z-50 flex items-end justify-center bg-slate-950/80 p-0 backdrop-blur-sm sm:items-center sm:p-6"
      phx-window-keydown="close-prompt-preview"
      phx-key="escape"
    >
      <%= if preview_prompt = selected_prompt(@prompts, @preview_action_key) do %>
        <section
          id="prompt-preview"
          aria-modal="true"
          role="dialog"
          aria-labelledby="prompt-preview-title"
          phx-click-away="close-prompt-preview"
          class="flex max-h-[92vh] w-full max-w-5xl flex-col overflow-hidden rounded-t-3xl border border-white/10 bg-slate-900 shadow-2xl shadow-black/50 sm:rounded-3xl"
        >
          <header class="flex items-start justify-between gap-4 border-b border-white/10 px-5 py-4 sm:px-6">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-teal-300">
                Example composed prompt
              </p>
              <h2 id="prompt-preview-title" class="mt-1 text-xl font-semibold text-white">
                {preview_prompt.label}
              </h2>
            </div>
            <button
              type="button"
              phx-click="close-prompt-preview"
              aria-label="Close prompt preview"
              class="rounded-xl border border-white/10 px-3 py-2 text-sm font-semibold text-slate-300 transition hover:border-white/20 hover:text-white"
            >
              Close
            </button>
          </header>

          <div class="overflow-y-auto p-5 sm:p-6">
            <div class="mb-4 grid gap-3 text-sm leading-6 sm:grid-cols-2">
              <div class="rounded-xl border border-amber-400/20 bg-amber-400/[0.08] p-4 text-amber-100/80">
                <p class="font-semibold text-amber-100">Protected instructions</p>
                <p class="mt-1">
                  The repository, target, authorization, and safety boundaries are generated by PtcManager and cannot be edited here.
                </p>
              </div>
              <div class="rounded-xl border border-teal-400/20 bg-teal-400/[0.06] p-4 text-teal-100/80">
                <p class="font-semibold text-teal-100">Your saved instructions</p>
                <p class="mt-1">
                  Customized text appears in a tagged maintainer block and remains subordinate to the protected boundaries.
                </p>
              </div>
            </div>

            <p class="mb-3 text-xs leading-5 text-slate-500">
              This safe example uses placeholder repository, issue, PR, branch, and SHA values. At execution time PtcManager substitutes the exact target and may append a source-snapshot record and structured-result file path.
            </p>

            <pre
              id={"full-prompt-preview-#{preview_prompt.key}"}
              class="overflow-x-auto whitespace-pre-wrap break-words rounded-2xl border border-white/10 bg-slate-950/80 p-4 font-mono text-xs leading-6 text-slate-200 sm:p-5"
            >{preview_prompt.preview}</pre>
          </div>
        </section>
      <% end %>
    </div>
  </div>
</Layouts.app>
