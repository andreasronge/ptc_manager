<Layouts.app flash={@flash} current_path="/configuration">
  <div class="space-y-8">
    <section class="flex flex-col justify-between gap-5 lg:flex-row lg:items-end">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-teal-300">
          Configuration
        </p>
        <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">
          Repository configuration
        </h1>
        <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-400">
          Register repositories and verify that each checkout is ready. Prompts, buttons, schedules, and agent selection are configured per repository on the Automations page.
        </p>
      </div>
    </section>

    <.link
      navigate="/execution-profiles"
      class="inline-block rounded-xl bg-teal-300 px-4 py-3 font-semibold text-slate-950"
    >
      Execution profiles and models
    </.link>

    <aside class="rounded-2xl border border-teal-400/20 bg-teal-400/[0.07] p-5 text-sm leading-6 text-teal-100">
      <p class="font-semibold">Prompts are repository-specific and fully editable</p>
      <p class="mt-1 text-teal-100/80">
        PtcManager provides one project-specific suggested prompt for each automation. You can replace it completely—including its safety guidance—and preview the generated runtime facts. Saving creates a new immutable version for future work; queued and running agents keep their original version.
      </p>
      <.link
        navigate={~p"/automations"}
        class="mt-3 inline-flex rounded-xl bg-teal-400 px-4 py-2 text-sm font-semibold text-slate-950 hover:bg-teal-300"
      >
        Configure repository automations
      </.link>
    </aside>

    <section
      id="agent-capacity"
      class="rounded-2xl border border-white/10 bg-slate-900/70 p-5"
      aria-labelledby="agent-capacity-title"
    >
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-teal-300">Machine</p>
        <h2 id="agent-capacity-title" class="mt-1 text-2xl font-semibold">Worker capacity</h2>
        <p class="mt-2 text-sm leading-6 text-slate-400">
          Light and heavy limits control agent sessions. Expensive-operation slots separately serialize memory-heavy build, test, lint, and verification commands used by managed agents. Normal commands on your Mac and in CI do not require this coordinator.
        </p>
      </div>

      <.form
        for={%{}}
        as={:capacity}
        phx-submit="save-capacity"
        class="mt-5 grid max-w-4xl gap-4 sm:grid-cols-3"
      >
        <label class="rounded-xl bg-white/[0.035] p-4 text-sm text-slate-300">
          <span class="font-semibold text-white">Light agents</span>
          <span class="mt-1 block text-xs leading-5 text-slate-500">
            Issue preparation, reviews, investigations, and updates.
          </span>
          <input
            type="number"
            min="1"
            max="8"
            required
            name="capacity[light_agent_capacity]"
            value={@capacity_setting.light_agent_capacity}
            class="mt-3 w-24 rounded-lg border border-white/10 bg-slate-950 p-2 text-sm"
          />
        </label>
        <label class="rounded-xl bg-white/[0.035] p-4 text-sm text-slate-300">
          <span class="font-semibold text-white">Heavy agents</span>
          <span class="mt-1 block text-xs leading-5 text-slate-500">
            Implementation, CI repair, conflict resolution, and merging.
          </span>
          <input
            type="number"
            min="1"
            max="8"
            required
            name="capacity[heavy_agent_capacity]"
            value={@capacity_setting.heavy_agent_capacity}
            class="mt-3 w-24 rounded-lg border border-white/10 bg-slate-950 p-2 text-sm"
          />
        </label>
        <label class="rounded-xl bg-white/[0.035] p-4 text-sm text-slate-300">
          <span class="font-semibold text-white">Expensive operations</span>
          <span class="mt-1 block text-xs leading-5 text-slate-500">
            Concurrent managed builds, test suites, linters, and verification process trees.
          </span>
          <input
            type="number"
            min="1"
            max="8"
            required
            name="capacity[operation_capacity]"
            value={@capacity_setting.operation_capacity}
            class="mt-3 w-24 rounded-lg border border-white/10 bg-slate-950 p-2 text-sm"
          />
        </label>
        <button class="w-fit rounded-xl bg-teal-400 px-4 py-2 text-sm font-semibold text-slate-950 hover:bg-teal-300 sm:col-span-3">
          Save worker limits
        </button>
      </.form>

      <div class="mt-4 rounded-xl border border-teal-400/15 bg-teal-400/[0.05] px-4 py-3 text-xs leading-5 text-slate-400">
        Heavy queue priority: <span class="font-semibold text-teal-200">merge → repair → new implementation</span>. Old work is kept in order within each priority.
      </div>
    </section>

    <section id="repository-health" aria-labelledby="repository-health-title">
      <div class="mb-4">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-teal-300">Repositories</p>
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 id="repository-health-title" class="mt-1 text-2xl font-semibold">
            Configuration health
          </h2>
          <button
            id="prepare-repositories"
            phx-click="prepare-repositories"
            class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-slate-200 hover:bg-white/10"
          >
            <.icon name="hero-wrench-screwdriver-mini" class="size-4" /> Prepare checkouts
          </button>
        </div>
        <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-400">
          Each repository needs its own verified checkout, readable GitHub data, the
          <code>ptc:</code>
          labels its agents are told to write, and a checked-in setup contract. Independent publication verification is optional and only needed when PtcManager publishes through its GitHub App broker.
        </p>
      </div>

      <details
        id="add-repository"
        class="mb-5 rounded-2xl border border-dashed border-teal-400/30 bg-teal-400/[0.04] p-5"
      >
        <summary class="cursor-pointer font-semibold text-teal-200">
          Add another GitHub repository
        </summary>
        <p class="mt-2 text-sm leading-6 text-slate-400">
          Register an accessible GitHub repository. Its checkout is expected at <code>/srv/&lt;repository-name&gt;</code>. The repository starts disabled and receives its own editable automation definitions.
        </p>
        <.form
          for={@repository_form}
          phx-submit="add-repository"
          class="mt-4 grid gap-3 md:grid-cols-2"
        >
          <label class="text-xs text-slate-400">
            GitHub owner<input
              required
              name="repository[github_owner]"
              value={@repository_form[:github_owner].value}
              class="mt-1 w-full rounded-lg border border-white/10 bg-slate-950 p-2 text-sm"
            />
          </label>
          <label class="text-xs text-slate-400">
            Repository name<input
              required
              name="repository[github_name]"
              value={@repository_form[:github_name].value}
              class="mt-1 w-full rounded-lg border border-white/10 bg-slate-950 p-2 text-sm"
            />
          </label>
          <label class="text-xs text-slate-400">
            Default branch<input
              required
              name="repository[default_branch]"
              value={@repository_form[:default_branch].value}
              class="mt-1 w-full rounded-lg border border-white/10 bg-slate-950 p-2 text-sm"
            />
          </label>
          <button class="w-fit rounded-xl bg-teal-400 px-4 py-2 text-sm font-semibold text-slate-950">
            Add repository
          </button>
        </.form>
      </details>

      <div class="grid gap-5 xl:grid-cols-2">
        <article
          :for={health <- @repository_health}
          id={"repository-health-#{health.repository.id}"}
          class="rounded-2xl border border-white/10 bg-slate-900/70 p-5"
        >
          <div class="flex items-start justify-between gap-4">
            <div>
              <h3 class="font-semibold text-white">
                {health.repository.github_owner}/{health.repository.github_name}
              </h3>
              <p class="mt-1 text-xs text-slate-500">
                Default branch: {health.repository.default_branch}
              </p>
              <p class="mt-1 break-all font-mono text-xs text-slate-500">
                Checkout: {health.repository.local_path}
              </p>
            </div>
            <span class={[
              "rounded-full px-2.5 py-1 text-xs font-semibold",
              if(health.repository.enabled,
                do: "bg-teal-400/15 text-teal-200",
                else: "bg-white/5 text-slate-400"
              )
            ]}>
              {if(health.repository.enabled, do: "Enabled", else: "Disabled")}
            </span>
          </div>

          <dl class="mt-5 space-y-3">
            <div
              :for={
                check <- [
                  health.checkout,
                  health.github,
                  health.labels,
                  health.gate,
                  health.service_access
                ]
              }
              class="rounded-xl bg-white/[0.035] p-3"
            >
              <div class="flex flex-wrap items-center justify-between gap-2">
                <dt class="text-sm font-medium text-slate-200">{check.label}</dt>
                <span class={[
                  "rounded-full px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide",
                  health_classes(check.status)
                ]}>
                  {check.status}
                </span>
              </div>
              <dd class="mt-1 break-words font-mono text-xs leading-5 text-slate-500">
                {health_detail(check)}
              </dd>
            </div>
          </dl>
          <button
            id={"toggle-repository-#{health.repository.id}"}
            phx-click="set-repository-enabled"
            phx-value-id={health.repository.id}
            phx-value-enabled={to_string(!health.repository.enabled)}
            data-confirm={
              if health.repository.enabled,
                do: nil,
                else:
                  "Enable #{health.repository.github_owner}/#{health.repository.github_name}? Synchronization will cover it and its automations become available."
            }
            class={[
              "rounded-lg px-3 py-2 text-xs font-semibold",
              if(health.repository.enabled,
                do: "bg-white/10 text-slate-200 hover:bg-white/15",
                else: "bg-teal-400 text-slate-950 hover:bg-teal-300"
              )
            ]}
          >
            {if health.repository.enabled, do: "Disable", else: "Enable"}
          </button>
          <section class="mt-5 rounded-xl bg-white/[0.035] p-4">
            <p class="text-sm font-medium text-slate-200">Automatically implement ready issues</p>
            <p class="mt-1 text-xs leading-5 text-slate-500">
              Authorize implementation of open, unassigned ptc:ready issues, including labels
              applied by preparation agents. Uses existing execution profiles and capacity limits.
              Up to the daily limit below per UTC day; previously attempted issues need a manual retry.
              Merging and deployment still require approval. Disabling prevents queued automatic
              jobs from starting; running jobs continue.
            </p>
            <button
              id={"auto-fix-#{health.repository.id}"}
              phx-click="set-auto-fix"
              phx-value-id={health.repository.id}
              phx-value-enabled={to_string(!health.repository.auto_fix_issues)}
              data-confirm={
                if !health.repository.auto_fix_issues,
                  do:
                    "Authorize automatic implementation of ready issues in this repository, including the existing backlog?",
                  else: nil
              }
              class="mt-3 rounded-lg bg-white/10 px-3 py-2 text-xs font-semibold text-slate-200 hover:bg-white/15"
            >
              {if health.repository.auto_fix_issues,
                do: "Disable automatic implementation",
                else: "Enable automatic implementation"}
            </button>
            <.form
              for={%{}}
              as={:auto_fix}
              id={"auto-fix-daily-limit-#{health.repository.id}"}
              phx-submit="set-auto-fix-daily-limit"
              class="mt-3 flex flex-wrap items-end gap-2"
            >
              <input type="hidden" name="auto_fix[repository_id]" value={health.repository.id} />
              <label class="text-xs text-slate-400">
                Issues per UTC day<input
                  type="number"
                  min="1"
                  max="50"
                  required
                  name="auto_fix[daily_limit]"
                  value={health.repository.auto_fix_daily_limit}
                  class="mt-1 block w-24 rounded-lg border border-white/10 bg-slate-950 p-2 text-sm"
                />
              </label>
              <button class="rounded-lg bg-white/10 px-3 py-2 text-xs font-semibold text-slate-200 hover:bg-white/15">
                Save limit
              </button>
            </.form>
          </section>
          <section
            id={"maintainer-labels-#{health.repository.id}"}
            class="mt-5 rounded-xl bg-white/[0.035] p-4"
          >
            <p class="text-sm font-medium text-slate-200">Your triage labels</p>
            <p class="mt-1 text-xs leading-5 text-slate-500">
              GitHub labels you use to sort the Planning backlog. A <strong>badge</strong>
              label is shown on the card; a <strong>park</strong>
              label moves the issue into Planning's Waiting group and changes nothing else. The
              label must already exist in the GitHub repository; PtcManager never creates one.
            </p>

            <ul :if={maintainer_labels(health.repository) != []} class="mt-3 flex flex-wrap gap-2">
              <li
                :for={label <- maintainer_labels(health.repository)}
                class="inline-flex items-center gap-2 rounded-full bg-white/5 px-3 py-1 text-xs text-slate-300 ring-1 ring-white/10"
              >
                <span class="font-medium">{label["name"]}</span>
                <span class="text-slate-500">{label["role"]}</span>
                <button
                  type="button"
                  phx-click="remove-maintainer-label"
                  phx-value-id={health.repository.id}
                  phx-value-name={label["name"]}
                  aria-label={"Remove #{label["name"]}"}
                  class="text-rose-300 hover:text-rose-200"
                >
                  ×
                </button>
              </li>
            </ul>

            <.form
              for={%{}}
              as={:label}
              id={"add-maintainer-label-#{health.repository.id}"}
              phx-submit="add-maintainer-label"
              class="mt-3 flex flex-wrap items-end gap-2"
            >
              <input type="hidden" name="label[repository_id]" value={health.repository.id} />
              <label class="text-xs text-slate-400">
                Label name<input
                  required
                  name="label[name]"
                  maxlength="50"
                  placeholder="wait"
                  class="mt-1 w-40 rounded-lg border border-white/10 bg-slate-950 p-2 text-sm"
                />
              </label>
              <label class="text-xs text-slate-400">
                Role<select
                  name="label[role]"
                  class="mt-1 block rounded-lg border border-white/10 bg-slate-950 p-2 text-sm"
                >
                  <option value="badge">badge</option>
                  <option value="park">park</option>
                </select>
              </label>
              <button class="rounded-lg bg-teal-400 px-3 py-2 text-xs font-semibold text-slate-950 hover:bg-teal-300">
                Add label
              </button>
            </.form>
          </section>

          <.link
            navigate={"/automations?repo=" <> URI.encode_www_form("#{health.repository.github_owner}/#{health.repository.github_name}")}
            class="mt-4 inline-flex rounded-lg border border-teal-400/25 px-3 py-2 text-xs font-semibold text-teal-200 hover:border-teal-400/40"
          >
            Edit prompts and automations
          </.link>
          <button
            type="button"
            phx-click="confirm-remove-repository"
            phx-value-id={health.repository.id}
            class="ml-2 mt-4 inline-flex rounded-lg border border-red-400/30 px-3 py-2 text-xs font-semibold text-red-200 hover:border-red-400/50"
          >
            Remove repository
          </button>

          <section
            id={"agent-environment-#{health.repository.id}"}
            class="mt-5 border-t border-white/10 pt-5"
            aria-label="Implementation agent environment"
          >
            <h4 class="text-sm font-semibold text-white">Implementation agent environment</h4>
            <p class="mt-1 text-xs leading-5 text-slate-500">
              Write-only repository variables. Values are encrypted and supplied only to implementation agents and their managed commands—not setup or maintainer-action agents.
            </p>

            <.form
              for={%{}}
              as={:variable}
              phx-submit="save-agent-environment-variable"
              class="mt-3 grid gap-2 sm:grid-cols-[1fr_1fr_auto]"
            >
              <input type="hidden" name="repository-id" value={health.repository.id} />
              <label class="text-xs text-slate-400">
                Name<input
                  required
                  name="variable[name]"
                  pattern="[A-Z_][A-Z0-9_]*"
                  autocomplete="off"
                  placeholder="OPENROUTER_API_KEY"
                  class="mt-1 w-full rounded-lg border border-white/10 bg-slate-950 p-2 font-mono text-sm"
                />
              </label>
              <label class="text-xs text-slate-400">
                Value<input
                  required
                  type="password"
                  name="variable[secret]"
                  autocomplete="new-password"
                  class="mt-1 w-full rounded-lg border border-white/10 bg-slate-950 p-2 font-mono text-sm"
                />
              </label>
              <button class="mt-5 h-fit rounded-lg bg-teal-400 px-3 py-2 text-xs font-semibold text-slate-950">
                Add or replace
              </button>
            </.form>

            <ul class="mt-3 space-y-2">
              <li
                :for={variable <- Map.fetch!(@agent_environment_variables, health.repository.id)}
                id={"agent-environment-variable-#{variable.id}"}
                class="flex items-center justify-between gap-3 rounded-lg bg-white/[0.035] px-3 py-2"
              >
                <div>
                  <span class="font-mono text-xs font-semibold text-slate-200">
                    {variable.name}
                  </span>
                  <span class="ml-2 text-[11px] text-slate-500">
                    Set {variable_set_at(variable.updated_at)}
                  </span>
                </div>
                <button
                  type="button"
                  phx-click="delete-agent-environment-variable"
                  phx-value-repository-id={health.repository.id}
                  phx-value-id={variable.id}
                  data-confirm={"Delete #{variable.name}?"}
                  class="text-xs font-semibold text-rose-300 hover:text-rose-200"
                >
                  Delete
                </button>
              </li>
            </ul>
          </section>
        </article>

        <div
          :if={@repository_health == []}
          class="rounded-2xl border border-dashed border-white/10 p-8 text-center text-sm text-slate-500"
        >
          No repositories are configured yet.
        </div>
      </div>
    </section>

    <section id="integrations" aria-labelledby="integrations-title">
      <div class="mb-4">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-teal-300">Integrations</p>
        <h2 id="integrations-title" class="mt-1 text-2xl font-semibold">
          What PtcManager may reach
        </h2>
        <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-400">
          Read-only GitHub synchronization, the write path that creates pull requests, private
          agent analysis, and the dispatcher. Planning keeps its own
          <strong>Sync GitHub now</strong>
          button; this section explains what that synchronization currently reaches.
        </p>
      </div>

      <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-4">
        <div class="rounded-2xl border border-white/10 bg-slate-900/70 p-5">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">GitHub</p>
          <p class="mt-1 text-sm text-slate-300">Read-only issue inbox</p>
          <div
            :for={repository <- @repositories}
            class="mt-4 border-t border-white/10 pt-3 text-xs"
          >
            <p class="text-slate-400">
              {repository.github_owner}/{repository.github_name}
              <span class={["ml-2", sync_classes(repository)]}>{sync_label(repository)}</span>
            </p>
            <p class="mt-1 text-slate-600">
              Last complete sync: {TimeFormat.utc(repository.last_synced_at)}
            </p>
            <p class="mt-1 text-slate-600">
              <%= if repository.github_viewer_login do %>
                Reads GitHub as @{repository.github_viewer_login}
              <% else %>
                GitHub identity unknown until the next sync
              <% end %>
            </p>
            <p :if={repository.last_sync_error} class="mt-2 text-rose-300">
              The last read-only sync failed. Check the service logs.
            </p>
          </div>
          <p :if={@repositories == []} class="mt-4 text-xs text-slate-600">
            No repository is configured yet.
          </p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-slate-900/70 p-5">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">
            Automatic PR publication
          </p>
          <p class="mt-1 text-sm text-slate-300">
            Approved profile → recorded review → verified commit → PR
          </p>
          <p :if={@agent_pr_enabled} class="mt-4 text-xs text-teal-300">
            New jobs use agent publication · authenticated worker creates the PR
          </p>
          <p :if={!@agent_pr_enabled && @publication_enabled} class="mt-4 text-xs text-teal-300">
            Publication enabled · exact-SHA GitHub App broker
          </p>
          <p :if={!@agent_pr_enabled && !@publication_enabled} class="mt-4 text-xs text-amber-300">
            Publication disabled · verified work waits safely without GitHub writes
          </p>
          <p :if={@pr_reconcile_enabled} class="mt-1 text-xs text-teal-300">
            Read-only PR status tracking enabled
          </p>
          <p :if={!@pr_reconcile_enabled} class="mt-1 text-xs text-amber-300">
            Read-only PR status tracking disabled
          </p>
          <p :for={repository <- @repositories} class="mt-2 text-xs text-slate-500">
            Execution profiles set implementation models, reviewer models, and review limits.
          </p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-slate-900/70 p-5">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">
            Private analysis
          </p>
          <p class="mt-1 text-sm text-slate-300">Lightweight Herdr repository investigation</p>
          <p :if={@agent_actions_enabled} class="mt-2 text-xs text-teal-300">
            Maintainer actions enabled · durable prompt queue
          </p>
          <p :if={!@agent_actions_enabled} class="mt-2 text-xs text-amber-300">
            Maintainer actions disabled · requests can be queued for later
          </p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-slate-900/70 p-5">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Dispatcher</p>
          <p class="mt-1 text-sm text-slate-300">Approved Herdr implementation work</p>
          <p :if={@dispatch_enabled} class="mt-4 text-xs text-teal-300">
            Enabled · fresh GitHub check · fenced worker lease
          </p>
          <p :if={!@dispatch_enabled} class="mt-4 text-xs text-amber-300">
            Disabled · approvals remain safely queued
          </p>
        </div>
      </div>
    </section>

    <div
      :if={@remove_repository}
      id="remove-repository-dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="remove-repository-title"
      class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/80 p-4"
    >
      <div class="max-w-lg rounded-2xl border border-red-400/25 bg-slate-900 p-6 shadow-2xl">
        <h2 id="remove-repository-title" class="text-xl font-semibold">Remove repository?</h2>
        <p class="mt-3 text-sm leading-6 text-slate-300">
          Remove
          <strong>{@remove_repository.github_owner}/{@remove_repository.github_name}</strong>
          and its PtcManager-owned configuration and synchronized records? This does not delete the GitHub repository, checkout at <code>{@remove_repository.local_path}</code>, branches, pull requests, issues, or worktrees.
        </p>
        <div class="mt-5 flex justify-end gap-3">
          <button
            type="button"
            phx-click="cancel-remove-repository"
            class="rounded-lg border border-white/15 px-4 py-2 text-sm font-semibold"
          >
            Cancel
          </button>
          <button
            type="button"
            phx-click="remove-repository"
            phx-value-id={@remove_repository.id}
            class="rounded-lg bg-red-500 px-4 py-2 text-sm font-semibold text-white"
          >
            Remove repository
          </button>
        </div>
      </div>
    </div>
  </div>
</Layouts.app>
