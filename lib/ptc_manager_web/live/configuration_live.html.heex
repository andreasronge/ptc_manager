<Layouts.app flash={@flash} current_path="/configuration">
  <div class="space-y-8">
    <section class="flex flex-col justify-between gap-5 lg:flex-row lg:items-end">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-teal-300">
          Configuration
        </p>
        <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">
          Repository configuration
        </h1>
        <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-400">
          Register repositories and verify that each checkout is ready. Prompts, buttons, schedules, and agent selection are configured per repository on the Automations page.
        </p>
      </div>
    </section>

    <.link
      navigate="/execution-profiles"
      class="inline-block rounded-xl bg-teal-300 px-4 py-3 font-semibold text-slate-950"
    >
      Execution profiles and models
    </.link>

    <aside class="rounded-2xl border border-teal-400/20 bg-teal-400/[0.07] p-5 text-sm leading-6 text-teal-100">
      <p class="font-semibold">Prompts are repository-specific and fully editable</p>
      <p class="mt-1 text-teal-100/80">
        PtcManager provides one project-specific suggested prompt for each automation. You can replace it completely—including its safety guidance—and preview the generated runtime facts. Saving creates a new immutable version for future work; queued and running agents keep their original version.
      </p>
      <.link
        navigate={~p"/automations"}
        class="mt-3 inline-flex rounded-xl bg-teal-400 px-4 py-2 text-sm font-semibold text-slate-950 hover:bg-teal-300"
      >
        Configure repository automations
      </.link>
    </aside>

    <section
      id="agent-capacity"
      class="rounded-2xl border border-white/10 bg-slate-900/70 p-5"
      aria-labelledby="agent-capacity-title"
    >
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-teal-300">Machine</p>
        <h2 id="agent-capacity-title" class="mt-1 text-2xl font-semibold">Worker capacity</h2>
        <p class="mt-2 text-sm leading-6 text-slate-400">
          Light and heavy limits control agent sessions. Expensive-operation slots separately serialize memory-heavy build, test, lint, and verification commands used by managed agents. Normal commands on your Mac and in CI do not require this coordinator.
        </p>
      </div>

      <.form
        for={%{}}
        as={:capacity}
        phx-submit="save-capacity"
        class="mt-5 grid max-w-4xl gap-4 sm:grid-cols-3"
      >
        <label class="rounded-xl bg-white/[0.035] p-4 text-sm text-slate-300">
          <span class="font-semibold text-white">Light agents</span>
          <span class="mt-1 block text-xs leading-5 text-slate-500">
            Issue preparation, reviews, investigations, and updates.
          </span>
          <input
            type="number"
            min="1"
            max="8"
            required
            name="capacity[light_agent_capacity]"
            value={@capacity_setting.light_agent_capacity}
            class="mt-3 w-24 rounded-lg border border-white/10 bg-slate-950 p-2 text-sm"
          />
        </label>
        <label class="rounded-xl bg-white/[0.035] p-4 text-sm text-slate-300">
          <span class="font-semibold text-white">Heavy agents</span>
          <span class="mt-1 block text-xs leading-5 text-slate-500">
            Implementation, CI repair, conflict resolution, and merging.
          </span>
          <input
            type="number"
            min="1"
            max="8"
            required
            name="capacity[heavy_agent_capacity]"
            value={@capacity_setting.heavy_agent_capacity}
            class="mt-3 w-24 rounded-lg border border-white/10 bg-slate-950 p-2 text-sm"
          />
        </label>
        <label class="rounded-xl bg-white/[0.035] p-4 text-sm text-slate-300">
          <span class="font-semibold text-white">Expensive operations</span>
          <span class="mt-1 block text-xs leading-5 text-slate-500">
            Concurrent managed builds, test suites, linters, and verification process trees.
          </span>
          <input
            type="number"
            min="1"
            max="8"
            required
            name="capacity[operation_capacity]"
            value={@capacity_setting.operation_capacity}
            class="mt-3 w-24 rounded-lg border border-white/10 bg-slate-950 p-2 text-sm"
          />
        </label>
        <button class="w-fit rounded-xl bg-teal-400 px-4 py-2 text-sm font-semibold text-slate-950 hover:bg-teal-300 sm:col-span-3">
          Save worker limits
        </button>
      </.form>

      <div class="mt-4 rounded-xl border border-teal-400/15 bg-teal-400/[0.05] px-4 py-3 text-xs leading-5 text-slate-400">
        Heavy queue priority: <span class="font-semibold text-teal-200">merge → repair → new implementation</span>. Old work is kept in order within each priority.
      </div>
    </section>

    <section id="repositories" aria-labelledby="repositories-title">
      <div class="mb-4">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-teal-300">Repositories</p>
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 id="repositories-title" class="mt-1 text-2xl font-semibold">
            Repositories
          </h2>
          <button
            id="prepare-repositories"
            phx-click="prepare-repositories"
            class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-slate-200 hover:bg-white/10"
          >
            <.icon name="hero-wrench-screwdriver-mini" class="size-4" /> Prepare checkouts
          </button>
        </div>
        <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-400">
          Open a repository to check its health and edit its settings. The badge shows its most urgent check.
        </p>
      </div>

      <details
        id="add-repository"
        open={@add_repository_open}
        class="mb-5 rounded-2xl border border-dashed border-teal-400/30 bg-teal-400/[0.04] p-5"
      >
        <summary
          phx-click="toggle-add-repository"
          class="cursor-pointer font-semibold text-teal-200"
        >
          Add another GitHub repository
        </summary>
        <p class="mt-2 text-sm leading-6 text-slate-400">
          Register an accessible GitHub repository. The default branch is read from GitHub once owner and name are entered; change it if work should target another branch. Its checkout is expected at <code>/srv/&lt;owner&gt;/&lt;name&gt;</code>;
          <strong>Prepare checkouts</strong>
          clones it, private repositories included, with the worker's GitHub credentials. The repository starts disabled and receives its own editable automation definitions.
        </p>
        <.form
          for={@repository_form}
          phx-change="lookup-repository"
          phx-submit="add-repository"
          class="mt-4 grid gap-3 md:grid-cols-2"
        >
          <label class="text-xs text-slate-400">
            GitHub owner<input
              required
              name="repository[github_owner]"
              value={@repository_form[:github_owner].value}
              phx-debounce="blur"
              class="mt-1 w-full rounded-lg border border-white/10 bg-slate-950 p-2 text-sm"
            />
          </label>
          <label class="text-xs text-slate-400">
            Repository name<input
              required
              name="repository[github_name]"
              value={@repository_form[:github_name].value}
              phx-debounce="blur"
              class="mt-1 w-full rounded-lg border border-white/10 bg-slate-950 p-2 text-sm"
            />
          </label>
          <label class="text-xs text-slate-400">
            Default branch<input
              name="repository[default_branch]"
              value={@repository_form[:default_branch].value}
              placeholder="GitHub's default branch"
              class="mt-1 w-full rounded-lg border border-white/10 bg-slate-950 p-2 text-sm"
            />
          </label>
          <button class="w-fit rounded-xl bg-teal-400 px-4 py-2 text-sm font-semibold text-slate-950">
            Add repository
          </button>
        </.form>
      </details>

      <ul
        id="repository-list"
        class="divide-y divide-white/10 overflow-hidden rounded-2xl border border-white/10 bg-slate-900/70"
      >
        <li :for={repository <- @repositories} id={"repository-#{repository.id}"}>
          <.link
            navigate={~p"/configuration/repositories/#{repository.id}"}
            class="flex flex-wrap items-center gap-x-4 gap-y-2 px-5 py-4 hover:bg-white/[0.03]"
          >
            <span class="min-w-0 flex-1 font-semibold text-white">{full_name(repository)}</span>
            <span class={[
              "rounded-full px-2.5 py-1 text-xs font-semibold",
              if(repository.enabled,
                do: "bg-teal-400/15 text-teal-200",
                else: "bg-white/5 text-slate-400"
              )
            ]}>
              {if(repository.enabled, do: "Enabled", else: "Disabled")}
            </span>
            <span class={["text-xs", sync_classes(repository)]}>{sync_label(repository)}</span>
            <span class={[
              "rounded-full px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide",
              health_classes(Map.fetch!(@repository_health, repository.id))
            ]}>
              {Map.fetch!(@repository_health, repository.id)}
            </span>
            <.icon name="hero-chevron-right-mini" class="size-4 text-slate-500" />
          </.link>
        </li>
        <li :if={@repositories == []} class="p-8 text-center text-sm text-slate-500">
          No repositories are configured yet.
        </li>
      </ul>
    </section>

    <section id="integrations" aria-labelledby="integrations-title">
      <div class="mb-4">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-teal-300">Integrations</p>
        <h2 id="integrations-title" class="mt-1 text-2xl font-semibold">
          What PtcManager may reach
        </h2>
        <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-400">
          Read-only GitHub synchronization, the write path that creates pull requests, private
          agent analysis, and the dispatcher. Planning keeps its own
          <strong>Sync GitHub now</strong>
          button; this section explains what that synchronization currently reaches.
        </p>
      </div>

      <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-4">
        <div class="rounded-2xl border border-white/10 bg-slate-900/70 p-5">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">GitHub</p>
          <p class="mt-1 text-sm text-slate-300">Read-only issue inbox</p>
          <div
            :for={repository <- @repositories}
            class="mt-4 border-t border-white/10 pt-3 text-xs"
          >
            <p class="text-slate-400">
              {repository.github_owner}/{repository.github_name}
              <span class={["ml-2", sync_classes(repository)]}>{sync_label(repository)}</span>
            </p>
            <p class="mt-1 text-slate-600">
              Last complete sync: {TimeFormat.utc(repository.last_synced_at)}
            </p>
            <p class="mt-1 text-slate-600">
              <%= if repository.github_viewer_login do %>
                Reads GitHub as @{repository.github_viewer_login}
              <% else %>
                GitHub identity unknown until the next sync
              <% end %>
            </p>
            <p :if={repository.last_sync_error} class="mt-2 text-rose-300">
              The last read-only sync failed. Check the service logs.
            </p>
          </div>
          <p :if={@repositories == []} class="mt-4 text-xs text-slate-600">
            No repository is configured yet.
          </p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-slate-900/70 p-5">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">
            Automatic PR publication
          </p>
          <p class="mt-1 text-sm text-slate-300">
            Approved profile → recorded review → verified commit → PR
          </p>
          <p :if={@agent_pr_enabled} class="mt-4 text-xs text-teal-300">
            New jobs use agent publication · authenticated worker creates the PR
          </p>
          <p :if={!@agent_pr_enabled && @publication_enabled} class="mt-4 text-xs text-teal-300">
            Publication enabled · exact-SHA GitHub App broker
          </p>
          <p :if={!@agent_pr_enabled && !@publication_enabled} class="mt-4 text-xs text-amber-300">
            Publication disabled · verified work waits safely without GitHub writes
          </p>
          <p :if={@pr_reconcile_enabled} class="mt-1 text-xs text-teal-300">
            Read-only PR status tracking enabled
          </p>
          <p :if={!@pr_reconcile_enabled} class="mt-1 text-xs text-amber-300">
            Read-only PR status tracking disabled
          </p>
          <p class="mt-2 text-xs text-slate-500">
            Execution profiles set implementation models, reviewer models, and review limits.
          </p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-slate-900/70 p-5">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">
            Private analysis
          </p>
          <p class="mt-1 text-sm text-slate-300">Lightweight Herdr repository investigation</p>
          <p :if={@agent_actions_enabled} class="mt-2 text-xs text-teal-300">
            Maintainer actions enabled · durable prompt queue
          </p>
          <p :if={!@agent_actions_enabled} class="mt-2 text-xs text-amber-300">
            Maintainer actions disabled · requests can be queued for later
          </p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-slate-900/70 p-5">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Dispatcher</p>
          <p class="mt-1 text-sm text-slate-300">Approved Herdr implementation work</p>
          <p :if={@dispatch_enabled} class="mt-4 text-xs text-teal-300">
            Enabled · fresh GitHub check · fenced worker lease
          </p>
          <p :if={!@dispatch_enabled} class="mt-4 text-xs text-amber-300">
            Disabled · approvals remain safely queued
          </p>
        </div>
      </div>
    </section>
  </div>
</Layouts.app>
