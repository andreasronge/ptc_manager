<Layouts.app flash={@flash} current_path="/operations">
  <section class="mb-6">
    <p class="text-xs font-semibold uppercase tracking-[0.24em] text-teal-300">Machine room</p>
    <div class="mt-3 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">
          {tab_title(@live_action)}
        </h1>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-400">
          {tab_description(@live_action)}
        </p>
      </div>
      <div
        id="capacity-recommendation"
        class={["rounded-xl border px-4 py-3 text-sm font-medium", capacity_classes(assigns)]}
      >
        {capacity_label(assigns)}
      </div>
    </div>
    <nav
      id="operations-tabs"
      aria-label="Operations sections"
      class="mt-6 flex gap-1 overflow-x-auto border-b border-white/10"
    >
      <.link
        :for={tab <- tabs()}
        patch={tab.path}
        aria-current={if @live_action == tab.action, do: "page"}
        class={[
          "-mb-px whitespace-nowrap border-b-2 px-4 py-2.5 text-sm font-medium transition",
          @live_action == tab.action && "border-teal-400 text-white",
          @live_action != tab.action &&
            "border-transparent text-slate-400 hover:border-white/20 hover:text-white"
        ]}
      >
        {tab.label}
      </.link>
    </nav>
  </section>

  <%= case @live_action do %>
    <% :agents -> %>
      {agents_tab(assigns)}
    <% :performance -> %>
      {performance_tab(assigns)}
    <% _index -> %>
      {now_tab(assigns)}
  <% end %>

  <div
    :if={@selected_run}
    id="agent-detail-panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="agent-detail-title"
    phx-window-keydown="close_agent"
    phx-key="escape"
    class="fixed inset-0 z-50 flex justify-end"
  >
    <.link
      patch={close_path(assigns)}
      aria-label="Close agent output"
      class="absolute inset-0 bg-slate-950/75 backdrop-blur-sm"
    >
    </.link>
    <aside class="relative flex h-full w-full max-w-2xl flex-col border-l border-white/10 bg-slate-950 shadow-2xl">
      <header class="border-b border-white/10 px-5 py-5 sm:px-7">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-teal-300">
              Read-only terminal
            </p>
            <h2 id="agent-detail-title" class="mt-2 text-xl font-semibold">
              {run_name(@selected_run)}
            </h2>
            <p class="mt-2 text-sm leading-6 text-slate-400">{run_task(@selected_run)}</p>
          </div>
          <.link
            id="close-agent-detail"
            patch={close_path(assigns)}
            class="rounded-lg border border-white/10 px-3 py-2 text-sm text-slate-300 hover:border-white/20 hover:text-white"
          >
            Close
          </.link>
        </div>
        <div class="mt-4 flex flex-wrap gap-2 text-xs">
          <.work_status state={@selected_run.state} label={@selected_run.state} />
          <span class="rounded-full bg-white/5 px-2.5 py-1 text-slate-400 ring-1 ring-white/10">
            {terminal_refresh_label(@selected_run)}
          </span>
          <span class="rounded-full bg-white/5 px-2.5 py-1 text-slate-400 ring-1 ring-white/10">
            No input controls
          </span>
        </div>
      </header>
      <div class="min-h-0 flex-1 overflow-auto p-4 sm:p-6">
        <% timing = phase_timing(@selected_run) %>
        <section
          :if={timing}
          id="agent-phase-timing"
          class="mb-4 rounded-xl border border-sky-400/20 bg-sky-400/[0.07] p-4"
        >
          <p class="text-xs font-semibold uppercase tracking-wide text-sky-300">
            Recorded timing
          </p>
          <p class="mt-2 text-sm font-medium text-slate-100">{timing.label}</p>
          <p class="mt-1 text-xs leading-5 text-slate-400">{timing.detail}</p>
        </section>
        <section
          :if={@selected_run.workspace_setup_state}
          id="agent-workspace-setup"
          class="mb-4 rounded-xl border border-white/10 bg-white/[0.03] p-4"
        >
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">
                Workspace preparation
              </p>
              <p class="mt-2 break-all font-mono text-xs text-slate-300">
                {@selected_run.workspace_setup_script || "Setup script unavailable"}
              </p>
            </div>
            <.work_status
              state={@selected_run.workspace_setup_state}
              label={@selected_run.workspace_setup_state}
            />
          </div>
          <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-slate-400">
            <span>Setup {workspace_setup_duration(@selected_run)}</span>
            <span :if={@selected_run.workspace_setup_exit_status != nil}>
              Exit {@selected_run.workspace_setup_exit_status}
            </span>
            <span :if={workspace_cache_label(@selected_run)}>
              {workspace_cache_label(@selected_run)}
            </span>
          </div>
          <div
            :if={workspace_setup_phases(@selected_run) != []}
            class="mt-3 flex flex-wrap gap-2 text-[11px] text-slate-400"
          >
            <span
              :for={{label, timing} <- workspace_setup_phases(@selected_run)}
              class="rounded-md border border-white/10 bg-white/[0.03] px-2 py-1"
            >
              {label} {timing}
            </span>
          </div>
          <p
            :if={@selected_run.workspace_setup_error}
            class="mt-3 rounded-lg bg-rose-400/[0.07] px-3 py-2 text-xs text-rose-200"
          >
            {@selected_run.workspace_setup_error}
          </p>
          <details
            :if={@selected_run.workspace_setup_output not in [nil, ""]}
            id="agent-workspace-setup-output"
            class="mt-3"
          >
            <summary class="cursor-pointer text-xs font-medium text-sky-300">
              Setup output
            </summary>
            <pre class="mt-2 max-h-48 overflow-auto whitespace-pre-wrap break-words rounded-lg bg-black/30 p-3 font-mono text-[11px] leading-5 text-slate-400">{@selected_run.workspace_setup_output}</pre>
          </details>
        </section>
        <p
          :if={@agent_output_error}
          class="rounded-xl border border-amber-400/20 bg-amber-400/[0.07] p-4 text-sm text-amber-200"
        >
          {@agent_output_error}
        </p>
        <pre
          :if={@agent_output}
          id="agent-terminal-output"
          aria-live="polite"
          class="min-h-full whitespace-pre-wrap break-words rounded-xl border border-white/10 bg-black/40 p-4 font-mono text-xs leading-5 text-slate-300 sm:text-sm"
        >{@agent_output}</pre>
      </div>
    </aside>
  </div>
</Layouts.app>
