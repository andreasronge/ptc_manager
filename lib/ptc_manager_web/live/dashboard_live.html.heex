<Layouts.app flash={@flash} current_path="/">
  <section class="mb-8">
    <p class="text-xs font-semibold uppercase tracking-[0.24em] text-teal-300">
      One place to decide
    </p>
    <div class="mt-3 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">
          Work that needs your attention
        </h1>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-400">
          Private summaries stay here. Approved agents prepare pull requests; merging still requires your approval.
        </p>
      </div>
      <div class="flex gap-3 text-sm">
        <div class="rounded-xl border border-white/10 bg-white/5 px-4 py-3">
          <span class="block text-2xl font-semibold">{length(@issues)}</span>
          <span class="text-slate-500">issues</span>
        </div>
        <div class="rounded-xl border border-white/10 bg-white/5 px-4 py-3">
          <span id="active-agent-count" class="block text-2xl font-semibold">
            {length(@active_agent_runs)}
          </span>
          <span class="text-slate-500">active agents</span>
        </div>
      </div>
    </div>
  </section>

  <section
    id="integrations"
    aria-label="Integrations"
    class="mb-8 grid gap-3 md:grid-cols-2 xl:grid-cols-4"
  >
    <div class="rounded-2xl border border-white/10 bg-slate-900/70 p-5">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">GitHub</p>
          <p class="mt-1 text-sm text-slate-300">Read-only issue inbox</p>
        </div>
        <button
          id="sync-github"
          phx-click="sync-github"
          disabled={@github_syncing || @repositories == []}
          class="rounded-lg bg-white/10 px-3 py-2 text-xs font-semibold text-white hover:bg-white/15 disabled:cursor-not-allowed disabled:text-slate-500"
        >
          {if @github_syncing, do: "Syncing…", else: "Sync now"}
        </button>
      </div>
      <div :for={repository <- @repositories} class="mt-4 border-t border-white/10 pt-3 text-xs">
        <p class="text-slate-400">
          {repository.github_owner}/{repository.github_name}
          <span class={["ml-2", sync_classes(repository)]}>{sync_label(repository)}</span>
        </p>
        <p class="mt-1 text-slate-600">
          Last complete sync: {short_time(repository.last_synced_at)}
        </p>
        <p :if={repository.last_sync_error} class="mt-2 text-rose-300">
          The last read-only sync failed. Check the service logs.
        </p>
      </div>
    </div>

    <div class="rounded-2xl border border-white/10 bg-slate-900/70 p-5">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">
        Automatic PR publication
      </p>
      <p class="mt-1 text-sm text-slate-300">
        Prompted test/review workflow → verified commit → PR
      </p>
      <p :if={@agent_pr_enabled} class="mt-4 text-xs text-teal-300">
        New jobs use agent publication · authenticated worker creates the PR
      </p>
      <p :if={!@agent_pr_enabled && @publication_enabled} class="mt-4 text-xs text-teal-300">
        Publication enabled · exact-SHA GitHub App broker
      </p>
      <p :if={!@agent_pr_enabled && !@publication_enabled} class="mt-4 text-xs text-amber-300">
        Publication disabled · verified work waits safely without GitHub writes
      </p>
      <p :if={@pr_reconcile_enabled} class="mt-1 text-xs text-teal-300">
        Read-only PR status tracking enabled
      </p>
      <p :if={!@pr_reconcile_enabled} class="mt-1 text-xs text-amber-300">
        Read-only PR status tracking disabled
      </p>
      <p :for={repository <- @repositories} class="mt-2 text-xs text-slate-500">
        Agent prompt requests {required_reviews(repository)} Codex review pass(es)
      </p>
    </div>

    <div class="rounded-2xl border border-white/10 bg-slate-900/70 p-5">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Private manager</p>
      <p class="mt-1 text-sm text-slate-300">Codex repository investigation</p>
      <p :if={@manager_enabled} class="mt-4 text-xs text-teal-300">
        Enabled · read-only sandbox · no GitHub writes
      </p>
      <p :if={!@manager_enabled} class="mt-4 text-xs text-amber-300">
        Disabled until a local checkout and explicit server setting are configured
      </p>
      <p :if={@agent_actions_enabled} class="mt-2 text-xs text-teal-300">
        Maintainer actions enabled · durable prompt queue
      </p>
      <p :if={!@agent_actions_enabled} class="mt-2 text-xs text-amber-300">
        Maintainer actions disabled · requests can be queued for later
      </p>
    </div>

    <div class="rounded-2xl border border-white/10 bg-slate-900/70 p-5">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Dispatcher</p>
      <p class="mt-1 text-sm text-slate-300">Approved Herdr implementation work</p>
      <p :if={@dispatch_enabled} class="mt-4 text-xs text-teal-300">
        Enabled · fresh GitHub check · fenced worker lease
      </p>
      <p :if={!@dispatch_enabled} class="mt-4 text-xs text-amber-300">
        Disabled · approvals remain safely queued
      </p>
    </div>
  </section>

  <div class="grid gap-8 xl:grid-cols-[minmax(0,1.5fr)_minmax(320px,0.8fr)]">
    <section aria-labelledby="issue-inbox-title" class="min-w-0">
      <div class="mb-4 flex items-center justify-between">
        <h2 id="issue-inbox-title" class="text-lg font-semibold">Issue inbox</h2>
        <span class="text-xs text-slate-500">Newest GitHub update first</span>
      </div>

      <div id="issue-inbox" class="space-y-4">
        <article
          :for={item <- @issues}
          id={"issue-#{item.issue.id}"}
          class="rounded-2xl border border-white/10 bg-slate-900/70 p-5 shadow-xl shadow-black/10 sm:p-6"
        >
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <p class="text-xs font-medium text-slate-500">
                {item.issue.repository.github_owner}/{item.issue.repository.github_name} · #{item.issue.number}
                <span :if={item.issue.state != "open"}>{" · #{item.issue.state}"}</span>
              </p>
              <h3 class="mt-1 text-lg font-semibold leading-7">{item.issue.title}</h3>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <span
                :if={claimed?(item.issue)}
                id={"issue-#{item.issue.id}-claimed"}
                title="GitHub assignment is advisory, but PtcManager will not start duplicate work."
                class="inline-flex w-fit items-center gap-1.5 rounded-full bg-sky-400/15 px-2.5 py-1 text-xs text-sky-300 ring-1 ring-sky-400/20"
              >
                <.icon name="hero-user-circle-mini" class="size-4" />
                {claim_label(item.issue)}
              </span>
              <span
                :if={not item.issue.github_assignment_projected}
                id={"issue-#{item.issue.id}-claim-unknown"}
                class="inline-flex w-fit items-center gap-1.5 rounded-full bg-amber-400/15 px-2.5 py-1 text-xs text-amber-300 ring-1 ring-amber-400/20"
              >
                <.icon name="hero-arrow-path-mini" class="size-4" /> Claim status needs sync
              </span>
              <span
                :if={item.proposal}
                class={[
                  "w-fit rounded-full px-2.5 py-1 text-xs ring-1",
                  state_classes(item.proposal.readiness)
                ]}
              >
                {String.replace(item.proposal.readiness, "_", " ")}
              </span>
              <span
                :if={item.issue.workflow_label}
                class="w-fit rounded-full bg-violet-400/15 px-2.5 py-1 text-xs text-violet-300 ring-1 ring-violet-400/20"
              >
                {item.issue.workflow_label}
              </span>
              <span
                :if={item.issue.workflow_label_conflict}
                class="w-fit rounded-full bg-amber-400/15 px-2.5 py-1 text-xs text-amber-300 ring-1 ring-amber-400/20"
              >
                conflicting ptc labels
              </span>
            </div>
          </div>

          <div
            :if={
              item.dependencies != [] or item.issue.dependency_overflow or
                not item.issue.dependencies_projected
            }
            id={"issue-dependencies-#{item.issue.id}"}
            class="mt-4 rounded-xl border border-amber-400/15 bg-amber-400/[0.05] p-4"
          >
            <p class="text-xs font-semibold uppercase tracking-wide text-amber-300">
              Dependencies
            </p>
            <div class="mt-2 flex flex-wrap gap-2">
              <a
                :for={dependency <- item.dependencies}
                id={"issue-#{item.issue.id}-blocked-by-#{dependency.number}"}
                href={dependency_url(item.issue.repository, dependency)}
                target="_blank"
                rel="noreferrer"
                class="rounded-lg bg-white/5 px-3 py-2 text-xs text-slate-300 ring-1 ring-white/10 hover:bg-white/10"
              >
                Blocked by #{dependency.number} · {dependency_status(dependency)} ↗
              </a>
            </div>
            <p
              :if={not item.issue.dependencies_projected}
              class="mt-3 text-xs text-amber-300"
            >
              Dependency state has not been synchronized yet. Run GitHub sync before approval.
            </p>
            <p
              :if={item.issue.dependency_overflow}
              class="mt-3 text-xs text-amber-300"
            >
              More than 100 blockers were declared. Simplify the dependency list before approval.
            </p>
            <p
              :if={
                item.issue.dependencies_projected and not item.issue.dependency_overflow and
                  dependencies_resolved?(item.dependencies)
              }
              class="mt-3 text-xs text-teal-300"
            >
              All recorded blockers are complete. Run Prepare issue again before approval.
            </p>
          </div>

          <div :if={item.proposal} class="mt-5 grid gap-4 sm:grid-cols-2">
            <div class="rounded-xl bg-white/[0.035] p-4 sm:col-span-2">
              <p class="text-xs font-semibold uppercase tracking-wide text-teal-300">
                In plain language
              </p>
              <p class="mt-2 leading-7 text-slate-200">{item.proposal.plain_summary}</p>
            </div>
            <div>
              <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">
                Why it matters
              </p>
              <p class="mt-1 text-sm leading-6 text-slate-300">{item.proposal.why_it_matters}</p>
            </div>
            <div class="flex gap-3 sm:justify-end">
              <span class="rounded-lg bg-white/5 px-3 py-2 text-xs text-slate-300">
                Scope: {item.proposal.scope}
              </span>
              <span class="rounded-lg bg-white/5 px-3 py-2 text-xs text-slate-300">
                Risk: {item.proposal.risk}
              </span>
            </div>
          </div>

          <p :if={!item.proposal} class="mt-4 text-sm text-amber-300">
            This issue still needs a manager investigation.
          </p>

          <details
            :if={item.proposal}
            id={"technical-evidence-#{item.issue.id}"}
            phx-mounted={JS.ignore_attributes("open")}
            class="group mt-5 rounded-xl border border-white/10 px-4 py-3"
          >
            <summary class="cursor-pointer text-sm font-medium text-slate-300">
              Technical evidence
            </summary>
            <p class="mt-3 whitespace-pre-line text-sm leading-6 text-slate-400">
              {item.proposal.technical_evidence}
            </p>
          </details>

          <div class="mt-5 flex flex-wrap items-center gap-3">
            <button
              :if={item.issue.state == "open"}
              id={"investigate-issue-#{item.issue.id}"}
              phx-click="investigate"
              phx-value-issue-id={item.issue.id}
              disabled={!@manager_enabled || investigating?(@investigating, item.issue.id)}
              class="rounded-xl bg-white/10 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-white/15 disabled:cursor-not-allowed disabled:text-slate-500"
            >
              <%= cond do %>
                <% investigating?(@investigating, item.issue.id) -> %>
                  Investigating…
                <% item.proposal && !fresh?(item) -> %>
                  Investigate again
                <% item.proposal -> %>
                  Refresh analysis
                <% true -> %>
                  Investigate privately
              <% end %>
            </button>
            <button
              :for={action <- ActionCatalog.issue_actions(item.issue)}
              id={"agent-action-#{action.key}-issue-#{item.issue.id}"}
              phx-click="run-agent-action"
              phx-value-action-key={action.key}
              phx-value-target-id={item.issue.id}
              disabled={active_agent_action?(item.issue_agent_action)}
              title={action.description}
              class="rounded-xl bg-violet-400 px-4 py-2.5 text-sm font-semibold text-slate-950 transition hover:bg-violet-300 disabled:cursor-not-allowed disabled:bg-slate-700 disabled:text-slate-400"
            >
              {action.label}
            </button>
            <span
              :if={item.issue_agent_action}
              class={[
                "rounded-xl px-3 py-2 text-xs",
                state_classes(item.issue_agent_action.state)
              ]}
            >
              {agent_action_label(item.issue_agent_action)}
            </span>
            <button
              :if={!item.active_job}
              id={"approve-issue-#{item.issue.id}"}
              phx-click="approve"
              phx-value-issue-id={item.issue.id}
              disabled={!approvable?(item)}
              class="rounded-xl bg-teal-400 px-4 py-2.5 text-sm font-semibold text-slate-950 transition hover:bg-teal-300 disabled:cursor-not-allowed disabled:bg-slate-700 disabled:text-slate-400"
            >
              Approve and start
            </button>
            <span
              :if={item.active_job}
              class="rounded-xl bg-sky-400/15 px-4 py-2.5 text-sm text-sky-300"
            >
              Job {job_label(item.active_job.state)}
            </span>
            <button
              :if={
                item.active_job &&
                  item.active_job.state in ["awaiting_reconciliation", "verifying_result"]
              }
              id={"reconcile-job-#{item.active_job.id}"}
              phx-click="reconcile-result"
              phx-value-job-id={item.active_job.id}
              disabled={reconciling_result?(@reconciling_results, item.active_job.id)}
              class="rounded-xl bg-white/10 px-4 py-2.5 text-sm font-semibold text-white hover:bg-white/15 disabled:cursor-not-allowed disabled:text-slate-500"
            >
              {if reconciling_result?(@reconciling_results, item.active_job.id),
                do: "Checking branch…",
                else:
                  if(item.active_job.state == "verifying_result",
                    do: "Check verification status",
                    else: "Check committed branch"
                  )}
            </button>
            <span
              :if={!item.active_job && item.latest_job}
              class={[
                "rounded-xl px-4 py-2.5 text-sm",
                state_classes(item.latest_job.state)
              ]}
            >
              Last job {item.latest_job.state}
            </span>
            <a
              href={item.issue.html_url}
              target="_blank"
              class="text-sm text-slate-400 hover:text-white"
            >
              Open on GitHub ↗
            </a>
            <span :if={item.proposal && !fresh?(item)} class="text-xs text-amber-300">
              Summary is stale
            </span>
          </div>
          <div
            :if={agent_action_private_summary(item.issue_agent_action)}
            class="mt-4 rounded-xl border border-violet-400/20 bg-violet-400/[0.06] p-4"
          >
            <p class="text-xs font-semibold uppercase tracking-wide text-violet-300">
              Private agent result · {agent_action_outcome(item.issue_agent_action)}
            </p>
            <p class="mt-2 text-sm leading-6 text-slate-200">
              {agent_action_private_summary(item.issue_agent_action)}
            </p>
            <details
              :if={
                agent_action_result_items(item.issue_agent_action, "github_changes") != [] or
                  agent_action_result_items(item.issue_agent_action, "evidence") != []
              }
              class="mt-3 text-xs text-slate-400"
            >
              <summary class="cursor-pointer font-medium text-slate-300">Action details</summary>
              <ul class="mt-2 list-disc space-y-1 pl-5">
                <li :for={
                  change <-
                    agent_action_result_items(item.issue_agent_action, "github_changes")
                }>
                  {change}
                </li>
                <li :for={
                  evidence <- agent_action_result_items(item.issue_agent_action, "evidence")
                }>
                  {evidence}
                </li>
              </ul>
            </details>
          </div>
          <p
            :if={agent_action_failure(item.issue_agent_action)}
            class="mt-3 text-xs leading-5 text-amber-300"
          >
            {agent_action_failure(item.issue_agent_action)}
          </p>
          <div
            :if={
              item.active_job &&
                item.active_job.state in [
                  "ready_for_pr",
                  "publishing_pr",
                  "pr_open",
                  "publish_blocked"
                ]
            }
            class="mt-4 rounded-xl border border-teal-400/20 bg-teal-400/[0.06] p-4 text-sm"
          >
            <p class="font-semibold text-teal-300">
              <%= cond do %>
                <% item.publication && item.publication.state == "published" -> %>
                  PR published
                <% item.publication && item.publication.state == "publishing" -> %>
                  Publishing exact verified commit…
                <% item.publication && item.publication.state == "blocked" -> %>
                  PR verification needs attention
                <% true -> %>
                  Waiting for publication
              <% end %>
            </p>
            <p class="mt-1 text-slate-400">
              {item.active_job.result_commit_count} committed change(s) verified against <span class="font-mono">{String.slice(item.active_job.result_base_sha, 0, 8)}</span>.
              Head <span class="font-mono">{String.slice(item.active_job.result_head_sha, 0, 8)}</span>.
            </p>
            <%= cond do %>
              <% item.publication && item.publication.state == "published" -> %>
                <a
                  id={"publication-pr-#{item.publication.id}"}
                  href={item.publication.pr_url}
                  target="_blank"
                  class="mt-2 inline-block text-xs font-semibold text-teal-300 hover:text-teal-200"
                >
                  Open PR #{item.publication.pr_number} ↗
                </a>
                <div class="mt-3 flex flex-wrap items-center gap-3">
                  <button
                    :for={action <- ActionCatalog.pull_request_actions(item.publication)}
                    id={"agent-action-#{action.key}-pr-#{item.publication.id}"}
                    phx-click="run-agent-action"
                    phx-value-action-key={action.key}
                    phx-value-target-id={item.publication.id}
                    disabled={active_agent_action?(item.pr_agent_action)}
                    title={action.description}
                    class="rounded-lg bg-violet-400 px-3 py-2 text-xs font-semibold text-slate-950 hover:bg-violet-300 disabled:cursor-not-allowed disabled:bg-slate-700 disabled:text-slate-400"
                  >
                    {action.label}
                  </button>
                  <span
                    :if={item.pr_agent_action}
                    class={[
                      "rounded-lg px-3 py-2 text-xs",
                      state_classes(item.pr_agent_action.state)
                    ]}
                  >
                    {agent_action_label(item.pr_agent_action)}
                  </span>
                </div>
              <% item.publication && item.publication.state == "blocked" -> %>
                <p class="mt-2 text-xs text-amber-300">
                  {publication_error(item.publication.last_error)} No merge can occur; retry after correcting the cause.
                </p>
                <button
                  id={"retry-publication-#{item.publication.id}"}
                  phx-click="retry-publication"
                  phx-value-publication-id={item.publication.id}
                  class="mt-3 rounded-lg bg-white/10 px-3 py-2 text-xs font-semibold text-white hover:bg-white/15"
                >
                  Retry publishing
                </button>
              <% item.publication && item.publication.state == "publishing" -> %>
                <p class="mt-2 text-xs text-slate-500">
                  PtcManager is publishing the exact verified commit through its isolated broker.
                </p>
              <% agent_publication?(item) -> %>
                <p class="mt-2 text-xs text-slate-500">
                  Waiting for GitHub to report the agent-created PR for this exact branch and commit.
                </p>
              <% @publication_enabled -> %>
                <p class="mt-2 text-xs text-slate-500">
                  PtcManager will publish this exact commit after its local branch result is verified.
                </p>
                <p
                  :if={item.publication && item.publication.last_error}
                  class="mt-1 text-xs text-amber-300"
                >
                  The last PR verification did not match yet. PtcManager will check again.
                </p>
              <% true -> %>
                <p class="mt-2 text-xs text-amber-300">
                  Waiting safely until automatic publication is enabled.
                </p>
            <% end %>
            <div
              :if={item.pr_analysis}
              id={"pr-analysis-#{item.pr_analysis.id}"}
              class="mt-3 rounded-lg border border-violet-400/20 bg-violet-400/[0.06] p-3"
            >
              <p class="text-xs font-semibold uppercase tracking-wide text-violet-300">
                Private merge decision · {String.replace(item.pr_analysis.outcome, "-", " ")}
              </p>
              <p class="mt-2 text-sm leading-6 text-slate-200">
                {item.pr_analysis.plain_summary}
              </p>
              <p class="mt-2 text-xs leading-5 text-slate-400">
                {item.pr_analysis.why_it_matters}
              </p>
              <div class="mt-3 flex flex-wrap gap-2 text-xs text-slate-400">
                <span class="rounded bg-white/5 px-2 py-1">Scope: {item.pr_analysis.scope}</span>
                <span class="rounded bg-white/5 px-2 py-1">Risk: {item.pr_analysis.risk}</span>
                <span class="rounded bg-white/5 px-2 py-1 font-mono">
                  Head {String.slice(item.pr_analysis.head_sha, 0, 8)}
                </span>
              </div>
              <details
                phx-mounted={JS.ignore_attributes("open")}
                class="mt-3 text-xs text-slate-400"
              >
                <summary class="cursor-pointer font-medium text-slate-300">
                  Technical evidence
                </summary>
                <p class="mt-2 whitespace-pre-line leading-5">
                  {item.pr_analysis.technical_evidence}
                </p>
              </details>
              <button
                :if={!item.merge_approval}
                id={"approve-merge-#{item.publication.id}"}
                phx-click="approve-merge"
                phx-value-publication-id={item.publication.id}
                disabled={!merge_approvable?(item)}
                class="mt-3 rounded-lg bg-teal-400 px-3 py-2 text-xs font-semibold text-slate-950 hover:bg-teal-300 disabled:cursor-not-allowed disabled:bg-slate-700 disabled:text-slate-400"
              >
                Approve for merge
              </button>
              <p
                :if={item.merge_approval && merge_approval_fresh?(item)}
                class="mt-3 text-xs font-semibold text-teal-300"
              >
                Approved for merge at head <span class="font-mono">{String.slice(item.merge_approval.head_sha, 0, 8)}</span>.
                Automatic merge is not enabled yet.
              </p>
              <p
                :if={item.merge_approval && !merge_approval_fresh?(item)}
                class="mt-3 text-xs font-semibold text-amber-300"
              >
                The previous merge approval is stale. Prepare a new merge decision.
              </p>
            </div>
          </div>
          <div
            :if={
              !item.active_job && item.publication &&
                item.publication.pr_state in ["merged", "closed"]
            }
            class="mt-4 rounded-xl border border-white/10 bg-white/[0.035] p-4 text-sm"
          >
            <p class="font-semibold text-slate-200">
              Pull request {item.publication.pr_state}
            </p>
            <p class="mt-1 text-xs text-slate-500">
              GitHub is authoritative; this implementation no longer occupies the active queue.
            </p>
            <a
              href={item.publication.pr_url}
              target="_blank"
              class="mt-2 inline-block text-xs font-semibold text-teal-300 hover:text-teal-200"
            >
              Open PR #{item.publication.pr_number} ↗
            </a>
            <div class="mt-3 flex flex-wrap items-center gap-3">
              <button
                :for={action <- ActionCatalog.pull_request_actions(item.publication)}
                id={"agent-action-#{action.key}-pr-#{item.publication.id}"}
                phx-click="run-agent-action"
                phx-value-action-key={action.key}
                phx-value-target-id={item.publication.id}
                disabled={active_agent_action?(item.pr_agent_action)}
                title={action.description}
                class="rounded-lg bg-violet-400 px-3 py-2 text-xs font-semibold text-slate-950 hover:bg-violet-300 disabled:cursor-not-allowed disabled:bg-slate-700 disabled:text-slate-400"
              >
                {action.label}
              </button>
              <span
                :if={item.pr_agent_action}
                class={[
                  "rounded-lg px-3 py-2 text-xs",
                  state_classes(item.pr_agent_action.state)
                ]}
              >
                {agent_action_label(item.pr_agent_action)}
              </span>
            </div>
            <div
              :if={agent_action_private_summary(item.pr_agent_action)}
              class="mt-3 rounded-lg bg-violet-400/[0.06] p-3"
            >
              <p class="text-xs font-semibold text-violet-300">
                Private retrospective · {agent_action_outcome(item.pr_agent_action)}
              </p>
              <p class="mt-1 text-xs leading-5 text-slate-300">
                {agent_action_private_summary(item.pr_agent_action)}
              </p>
            </div>
          </div>
          <p
            :if={
              item.active_job && item.active_job.state == "awaiting_reconciliation" &&
                item.active_job.last_error
            }
            class="mt-3 text-xs text-amber-300"
          >
            Branch verification is pending. You can retry the read-only check safely.
          </p>
          <p
            :if={!item.active_job && item.latest_job && item.latest_job.last_error}
            class="mt-3 text-xs text-rose-300"
          >
            The last attempt stopped safely. Review the service audit log before trying again.
          </p>
        </article>

        <div
          :if={@issues == []}
          class="rounded-2xl border border-dashed border-white/10 p-10 text-center text-slate-500"
        >
          No issues have been synchronized yet.
        </div>
      </div>
    </section>

    <aside aria-labelledby="agent-activity-title" class="min-w-0">
      <div class="mb-4 flex items-center justify-between">
        <h2 id="agent-activity-title" class="text-lg font-semibold">Agent activity</h2>
        <span class="size-2 rounded-full bg-teal-400 shadow-[0_0_12px_rgba(45,212,191,0.8)]">
        </span>
      </div>

      <div id="agent-activity" class="space-y-3 xl:sticky xl:top-24">
        <article
          :for={worker <- @workers}
          id={"worker-capacity-#{worker.id}"}
          class="rounded-2xl border border-white/10 bg-slate-900/70 p-5"
        >
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-sm font-semibold">{worker.name}</p>
              <p class="mt-0.5 text-xs text-slate-500">Implementation worktrees</p>
            </div>
            <span class="rounded-full bg-white/5 px-2.5 py-1 text-xs text-slate-300 ring-1 ring-white/10">
              {occupied_worktrees(worker)} / {worker_capacity(worker)}
            </span>
          </div>
          <div :if={worker.worktree_allocations != []} class="mt-3 space-y-2">
            <div
              :for={allocation <- worker.worktree_allocations}
              :if={allocation.state != "removed"}
              id={"worktree-allocation-#{allocation.id}"}
              class="rounded-lg bg-white/[0.035] px-3 py-2 text-xs"
            >
              <div class="flex items-center justify-between gap-2">
                <span class="text-slate-300">
                  <%= if allocation.job do %>
                    #{allocation.job.issue.number} · {allocation.job.repository.github_name}
                  <% else %>
                    Unattached worktree
                  <% end %>
                </span>
                <span class="text-slate-500">{worktree_state_label(allocation.state)}</span>
              </div>
              <p :if={allocation.last_error} class="mt-1 text-amber-300">
                Cleanup requires attention
              </p>
            </div>
          </div>
          <p :if={worker.worktree_allocations == []} class="mt-3 text-xs text-slate-600">
            No worktrees allocated
          </p>
        </article>

        <div class="flex items-center justify-between pt-2">
          <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-500">Active now</h3>
          <span class="text-xs text-slate-600">{length(@active_agent_runs)}</span>
        </div>

        <article
          :for={run <- @active_agent_runs}
          id={"agent-run-#{run.id}"}
          class="rounded-2xl border border-white/10 bg-slate-900/70 p-5"
        >
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-sm font-semibold capitalize">{agent_name(run)}</p>
              <p class="mt-0.5 text-xs text-slate-500">
                {run.worker.name} · <span class="capitalize">{run.role} agent</span>
              </p>
            </div>
            <span class={["rounded-full px-2.5 py-1 text-xs ring-1", state_classes(run.state)]}>
              {run.state}
            </span>
          </div>

          <div :if={run.job} class="mt-4">
            <p class="text-xs text-slate-500">
              {run.job.repository.github_name} · #{run.job.issue.number}
            </p>
            <p class="mt-1 text-sm leading-6 text-slate-200">{run.job.issue.title}</p>
          </div>

          <div :if={run.agent_action} class="mt-4">
            <p class="text-xs text-slate-500">{run.agent_action.target_label}</p>
            <p class="mt-1 text-sm capitalize leading-6 text-slate-200">
              {String.replace(run.agent_action.action_key, "_", " ")}
            </p>
          </div>

          <p :if={!run.job && !run.agent_action} class="mt-4 text-sm text-slate-300">
            Repository maintenance
          </p>
          <p :if={run.status_text} class="mt-3 text-sm leading-6 text-slate-400">
            {run.status_text}
          </p>

          <dl class="mt-4 grid grid-cols-2 gap-3 border-t border-white/10 pt-4 text-xs">
            <div>
              <dt class="text-slate-600">Working for</dt>
              <dd class="mt-1 font-medium text-slate-300">
                {elapsed(run.ended_at || @now, run.started_at)}
              </dd>
            </div>
            <div>
              <dt class="text-slate-600">Last seen</dt>
              <dd class="mt-1 font-medium text-slate-300">
                {elapsed(@now, run.last_heartbeat_at)} ago
              </dd>
            </div>
          </dl>

          <p :if={run.herdr_workspace} class="mt-3 truncate font-mono text-[11px] text-slate-600">
            {run.herdr_workspace}:{run.herdr_pane}
          </p>
        </article>

        <div
          :if={@active_agent_runs == []}
          class="rounded-2xl border border-dashed border-white/10 p-8 text-center text-sm text-slate-500"
        >
          No agents are working right now.
        </div>

        <section id="agent-history" aria-labelledby="agent-history-title" class="pt-4">
          <div class="mb-3 flex items-center justify-between">
            <h3
              id="agent-history-title"
              class="text-xs font-semibold uppercase tracking-wide text-slate-500"
            >
              Recent history
            </h3>
            <span class="text-xs text-slate-600">Latest {length(@recent_agent_runs)}</span>
          </div>

          <div class="space-y-2">
            <article
              :for={run <- @recent_agent_runs}
              id={"agent-history-run-#{run.id}"}
              class="rounded-xl border border-white/10 bg-slate-900/50 px-4 py-3"
            >
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <p class="truncate text-sm text-slate-300">
                    <%= cond do %>
                      <% run.job -> %>
                        #{run.job.issue.number} · {run.job.issue.title}
                      <% run.agent_action -> %>
                        {run.agent_action.target_label} · {String.replace(
                          run.agent_action.action_key,
                          "_",
                          " "
                        )}
                      <% true -> %>
                        Repository maintenance
                    <% end %>
                  </p>
                  <p class="mt-1 text-xs text-slate-600">
                    <span class="capitalize">{agent_name(run)}</span>
                    · {run.worker.name} · {elapsed(
                      run.ended_at,
                      run.started_at
                    )} · ended {short_time(run.ended_at)}
                  </p>
                </div>
                <span class={[
                  "shrink-0 rounded-full px-2 py-0.5 text-[11px] ring-1",
                  state_classes(run.state)
                ]}>
                  {run.state}
                </span>
              </div>
            </article>

            <p
              :if={@recent_agent_runs == []}
              class="rounded-xl border border-dashed border-white/10 px-4 py-5 text-center text-xs text-slate-600"
            >
              No completed agent runs yet.
            </p>
          </div>
        </section>
      </div>
    </aside>
  </div>
</Layouts.app>
