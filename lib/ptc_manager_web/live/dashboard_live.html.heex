<Layouts.app
  flash={@flash}
  current_path="/"
  repositories={@repositories}
  selected_repository={@selected_repository}
>
  <section class="mb-8">
    <p class="text-xs font-semibold uppercase tracking-[0.24em] text-teal-300">
      One place to decide
    </p>
    <div class="mt-3 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">
          Work that needs your attention
        </h1>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-400">
          Private summaries stay here. Approved agents prepare pull requests; merging still requires your approval.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-3 text-sm">
        <div class="rounded-xl border border-white/10 bg-white/5 px-4 py-3">
          <span class="block text-2xl font-semibold">{length(@issues)}</span>
          <span class="text-slate-500">issues</span>
        </div>
        <div class="rounded-xl border border-white/10 bg-white/5 px-4 py-3">
          <span id="active-agent-count" class="block text-2xl font-semibold">
            {length(@active_agent_runs)}
          </span>
          <span class="text-slate-500">active agents</span>
        </div>
        <button
          id="sync-github"
          phx-click="sync-github"
          disabled={@github_syncing || @repositories == []}
          class="rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-xs font-semibold text-white hover:bg-white/10 disabled:cursor-not-allowed disabled:text-slate-500"
        >
          <%= if @github_syncing do %>
            <span class="inline-flex items-center gap-1.5">
              <.icon name="hero-arrow-path-mini" class="size-3.5 motion-safe:animate-spin" />
              Syncing…
            </span>
          <% else %>
            Sync GitHub now
          <% end %>
        </button>
      </div>
    </div>
  </section>

  <section
    :if={@stalls != []}
    id="needs-attention"
    aria-labelledby="needs-attention-title"
    class="mb-8 rounded-2xl border border-amber-400/30 bg-amber-400/5 p-5"
  >
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h2 id="needs-attention-title" class="text-lg font-semibold">Needs attention</h2>
      <span class="text-xs text-slate-500">
        Computed from the console's own records; each row names what answers it
      </span>
    </div>
    <ul id="stalls" class="mt-4 space-y-3">
      <li
        :for={stall <- @stalls}
        id={"stall-#{stall.kind}-#{stall.target_type}-#{stall.target_id}"}
        class="flex flex-col gap-3 rounded-xl border border-white/10 bg-white/5 px-4 py-3 sm:flex-row sm:items-start sm:justify-between"
      >
        <div class="min-w-0">
          <p class="flex flex-wrap items-center gap-2 text-sm font-semibold">
            <span class={[
              "rounded-full px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide",
              stall.severity == :alarm && "bg-rose-500/20 text-rose-200",
              stall.severity == :attention && "bg-amber-400/20 text-amber-100"
            ]}>
              {stall.severity}
            </span>
            {Stalls.label(stall.kind)}
          </p>
          <p class="mt-1 text-sm leading-6 text-slate-300">{stall.detail}</p>
          <p :if={stall.since} class="mt-1 text-xs text-slate-500">
            Since {AgentHealth.humanize(max(DateTime.diff(@now, stall.since, :millisecond), 0))} ago
          </p>
        </div>
        <.link
          navigate={stall_path(stall, @repositories)}
          class="shrink-0 rounded-lg border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold text-white hover:bg-white/10"
        >
          Open
        </.link>
      </li>
    </ul>
  </section>

  <div class="grid gap-8 xl:grid-cols-[minmax(0,1.5fr)_minmax(320px,0.8fr)]">
    <section aria-labelledby="issue-inbox-title" class="min-w-0">
      <div class="mb-4 flex items-center justify-between">
        <h2 id="issue-inbox-title" class="text-lg font-semibold">Issue inbox</h2>
        <span class="text-xs text-slate-500">Grouped by what you can do next</span>
      </div>

      <div id="issue-inbox" class="space-y-5">
        <section
          :for={{group, items} <- @grouped_issues}
          id={"planning-group-#{group}"}
          class="rounded-2xl border border-white/10 bg-slate-900/40 p-3 sm:p-4"
        >
          <.group_heading
            group={group}
            count={length(items)}
            collapsed={collapsed_group?(@collapsed_groups, group)}
          />

          <div
            :if={!collapsed_group?(@collapsed_groups, group) && group == :follow_ups}
            class="mt-3 space-y-3"
          >
            <article
              :for={item <- items}
              id={"follow-up-#{item.publication.id}"}
              class="rounded-2xl border border-white/10 bg-slate-900/70 p-4 shadow-xl shadow-black/10 sm:p-5"
            >
              <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                <div class="min-w-0">
                  <p class="text-xs font-medium text-slate-500">
                    {item.repository.github_owner}/{item.repository.github_name} · PR #{item.publication.pr_number} · {item.publication.pr_state}
                  </p>
                  <h3 class="mt-1 text-base font-semibold leading-6">
                    {item.publication.title || (item.issue && item.issue.title)}
                  </h3>
                  <p class="mt-1.5 text-xs text-slate-500">
                    <span title={TimeFormat.utc(item.publication.pr_checked_at)}>
                      last checked {TimeFormat.relative(@now, item.publication.pr_checked_at)}
                    </span>
                  </p>
                </div>
                <div class="flex shrink-0 flex-wrap items-center gap-2">
                  <.work_status
                    :if={item.pr_agent_action}
                    state={item.pr_agent_action.state}
                    label={agent_action_label(item.pr_agent_action)}
                    class="rounded-full px-2.5 py-1"
                  />
                </div>
              </div>

              <div class="mt-4 flex flex-wrap items-center gap-3">
                <button
                  id={"run-retrospective-#{item.publication.id}"}
                  phx-click="run-agent-action"
                  phx-value-action-key="pr_retrospective"
                  phx-value-target-id={item.publication.id}
                  disabled={active_agent_action?(item.pr_agent_action)}
                  title="Read this pull request back and propose the follow-up work it left behind. It changes nothing on GitHub."
                  class="rounded-xl bg-violet-400 px-4 py-2.5 text-sm font-semibold text-slate-950 hover:bg-violet-300 disabled:cursor-not-allowed disabled:bg-slate-700 disabled:text-slate-400"
                >
                  Run retrospective
                </button>
                <button
                  id={"dismiss-follow-up-#{item.publication.id}"}
                  phx-click="dismiss-follow-up"
                  phx-value-publication-id={item.publication.id}
                  class="rounded-xl border border-white/10 px-4 py-2.5 text-sm font-semibold text-slate-300 hover:bg-white/5"
                >
                  Dismiss
                </button>
                <a
                  href={item.publication.pr_url}
                  target="_blank"
                  rel="noreferrer"
                  class="text-sm text-slate-400 hover:text-white"
                >
                  Open PR ↗
                </a>
                <a
                  :if={item.issue}
                  href={item.issue.html_url}
                  target="_blank"
                  rel="noreferrer"
                  class="text-sm text-slate-400 hover:text-white"
                >
                  Issue #{item.issue.number} ↗
                </a>
              </div>

              <.retrospective
                id={"follow-up-retro-#{item.publication.id}"}
                action={item.pr_retrospective_action}
                creation_actions={item.pr_retrospective_issue_actions}
                repository={item.repository}
              />
            </article>
          </div>

          <div
            :if={!collapsed_group?(@collapsed_groups, group) && group != :follow_ups}
            class="mt-3 space-y-3"
          >
            <article
              :for={item <- items}
              id={"issue-#{item.issue.id}"}
              class="rounded-2xl border border-white/10 bg-slate-900/70 p-4 shadow-xl shadow-black/10 sm:p-5"
            >
              <.card_header
                item={item}
                now={@now}
                expanded={expanded_issue?(@expanded_issue_ids, item)}
              />

              <div class="mt-4 flex flex-wrap items-end gap-3">
                <%= case group do %>
                  <% :in_delivery -> %>
                    <.link
                      id={"in-delivery-#{item.issue.id}"}
                      navigate={~p"/board"}
                      class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-sm font-semibold text-slate-200 hover:bg-white/10"
                    >
                      {DeliveryLane.label(delivery_lane(item))} · Delivery board →
                    </.link>
                  <% :collections -> %>
                    <button
                      :if={action = primary_issue_action(item, group)}
                      id={"agent-action-#{action.key}-issue-#{item.issue.id}"}
                      phx-click="run-agent-action"
                      phx-value-action-key={action.key}
                      phx-value-target-id={item.issue.id}
                      disabled={active_agent_action?(item.issue_agent_action)}
                      title={action.description}
                      class="rounded-xl border border-violet-400/30 px-4 py-2.5 text-sm font-semibold text-violet-200 transition hover:bg-violet-400/10 disabled:cursor-not-allowed disabled:border-white/10 disabled:text-slate-500"
                    >
                      {action.label}
                    </button>
                    <%= if run = collection_run(item) do %>
                      <div
                        id={"collection-run-#{run.id}"}
                        class="flex flex-wrap items-center gap-2"
                      >
                        <span class={[
                          "rounded-full px-2.5 py-1 text-xs ring-1",
                          run.state == "paused" &&
                            "bg-amber-400/15 text-amber-300 ring-amber-400/20",
                          run.state != "paused" &&
                            "bg-teal-400/15 text-teal-300 ring-teal-400/20"
                        ]}>
                          {collection_run_label(run)}
                        </span>
                        <span
                          :if={run.pause_reason}
                          id={"collection-run-reason-#{run.id}"}
                          class="text-xs text-slate-400"
                        >
                          {run.pause_reason}
                        </span>
                        <button
                          :for={decision <- collection_run_buttons(run)}
                          id={"collection-run-#{decision}-#{run.id}"}
                          type="button"
                          phx-click="collection-run"
                          phx-value-run-id={run.id}
                          phx-value-decision={decision}
                          data-confirm={
                            if decision == :cancel,
                              do:
                                "Cancel this collection run? Running agents finish, queued ones are cancelled, and nothing on GitHub changes."
                          }
                          class="rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-sm font-semibold text-slate-200 hover:bg-white/10"
                        >
                          {collection_run_button_label(decision)}
                        </button>
                      </div>
                    <% else %>
                      <form
                        id={"collection-run-form-#{item.issue.id}"}
                        phx-submit="start-collection-run"
                        class="flex flex-wrap items-end gap-3"
                      >
                        <input type="hidden" name="issue-id" value={item.issue.id} />
                        <label class="flex items-center gap-2 text-xs font-medium text-slate-400">
                          <input
                            type="checkbox"
                            name="auto-merge"
                            value="true"
                            checked
                            class="rounded border-white/20 bg-slate-950"
                          /> Merge reviewed members
                        </label>
                        <label class="flex items-center gap-2 text-xs font-medium text-slate-400">
                          <input
                            type="checkbox"
                            name="auto-recover"
                            value="true"
                            checked
                            class="rounded border-white/20 bg-slate-950"
                          /> Recover a stuck member once
                        </label>
                        <button
                          id={"start-collection-run-#{item.issue.id}"}
                          type="submit"
                          title="Admit, merge, and hand off every member without a click each; escalate to you on the umbrella issue when something needs a decision."
                          class="rounded-xl bg-teal-400 px-4 py-2.5 text-sm font-semibold text-slate-950 transition hover:bg-teal-300"
                        >
                          Run collection
                        </button>
                      </form>
                    <% end %>
                  <% _other -> %>
                    <button
                      :if={action = primary_issue_action(item, group)}
                      id={"agent-action-#{action.key}-issue-#{item.issue.id}"}
                      phx-click="run-agent-action"
                      phx-value-action-key={action.key}
                      phx-value-target-id={item.issue.id}
                      disabled={active_agent_action?(item.issue_agent_action)}
                      title={action.description}
                      class="rounded-xl bg-violet-400 px-4 py-2.5 text-sm font-semibold text-slate-950 transition hover:bg-violet-300 disabled:cursor-not-allowed disabled:bg-slate-700 disabled:text-slate-400"
                    >
                      {action.label}
                    </button>
                    <form
                      :if={approval_group?(group) && !item.active_job}
                      id={"approve-form-issue-#{item.issue.id}"}
                      phx-submit="approve"
                      class="flex flex-wrap items-end gap-2"
                    >
                      <input type="hidden" name="issue-id" value={item.issue.id} />
                      <label class="text-xs font-medium text-slate-400">
                        Execution profile
                        <select
                          name="execution-profile"
                          class="mt-1 block rounded-xl bg-slate-950 px-3 py-2.5 text-white"
                          disabled={!startable?(item)}
                        >
                          <option
                            :for={profile <- @execution_profiles}
                            value={profile.name}
                            selected={
                              profile.name ==
                                PtcManager.ExecutionProfiles.suggested(item.proposal)
                            }
                          >
                            {String.capitalize(profile.name)} · {profile.model} · max {profile.max_reviews}{if profile.name ==
                                                                                                                 PtcManager.ExecutionProfiles.suggested(
                                                                                                                   item.proposal
                                                                                                                 ),
                                                                                                               do:
                                                                                                                 " · suggested",
                                                                                                               else:
                                                                                                                 ""}
                          </option>
                        </select>
                      </label>
                      <label class="text-xs font-medium text-slate-400">
                        Maximum reviews
                        <select
                          id={"review-count-issue-#{item.issue.id}"}
                          name="review-count"
                          disabled={!startable?(item)}
                          class="mt-1 block rounded-xl border border-white/10 bg-slate-950 px-3 py-2.5 text-sm font-semibold text-white outline-none focus:border-teal-400/60"
                        >
                          <option value="" selected>Profile default</option>
                          <option
                            :for={count <- 0..5}
                            value={count}
                          >
                            {count}{if(count == 0, do: " · none", else: "")}
                          </option>
                        </select>
                      </label>
                      <button
                        id={"approve-issue-#{item.issue.id}"}
                        type="submit"
                        disabled={!approvable?(item)}
                        class="rounded-xl bg-teal-400 px-4 py-2.5 text-sm font-semibold text-slate-950 transition hover:bg-teal-300 disabled:cursor-not-allowed disabled:bg-slate-700 disabled:text-slate-400"
                      >
                        Approve and start
                      </button>
                      <button
                        id={"fix-directly-issue-#{item.issue.id}"}
                        type="submit"
                        name="direct"
                        value="true"
                        disabled={!startable?(item)}
                        title="Start implementation without a preparation round. Every other deterministic check still applies."
                        class="rounded-xl border border-teal-400/30 px-4 py-2.5 text-sm font-semibold text-teal-200 transition hover:bg-teal-400/10 disabled:cursor-not-allowed disabled:border-white/10 disabled:text-slate-500"
                      >
                        Fix directly
                      </button>
                    </form>
                <% end %>
                <span
                  :if={maintainer_label_chips(item.issue) != []}
                  id={"issue-labels-#{item.issue.id}"}
                  class="flex flex-wrap items-center gap-1.5 self-center"
                >
                  <button
                    :for={{name, present} <- maintainer_label_chips(item.issue)}
                    id={"toggle-label-#{item.issue.id}-#{name}"}
                    type="button"
                    phx-click="toggle-issue-label"
                    phx-value-issue-id={item.issue.id}
                    phx-value-name={name}
                    disabled={
                      writing_label?(@label_writes_in_flight, item.issue, name) ||
                        item.issue.state != "open"
                    }
                    aria-pressed={to_string(present)}
                    title={"Add or remove the GitHub label #{name}"}
                    class={[
                      "rounded-full px-2.5 py-1 text-xs font-medium ring-1 disabled:cursor-not-allowed disabled:opacity-50",
                      present && "bg-sky-400/20 text-sky-200 ring-sky-400/30",
                      !present && "text-slate-400 ring-white/15 hover:bg-white/5"
                    ]}
                  >
                    {name}
                  </button>
                </span>
                <.work_status
                  :if={item.issue_agent_action}
                  state={item.issue_agent_action.state}
                  label={agent_action_label(item.issue_agent_action)}
                  class="self-center rounded-xl px-3 py-2"
                />
                <a
                  href={item.issue.html_url}
                  target="_blank"
                  class="self-center text-sm text-slate-400 hover:text-white"
                >
                  Open on GitHub ↗
                </a>
              </div>

              <div
                :if={expanded_issue?(@expanded_issue_ids, item)}
                id={"issue-detail-#{item.issue.id}"}
                class="mt-5 border-t border-white/10 pt-5"
              >
                <p
                  :if={
                    (other_labels =
                       MaintainerLabels.unconfigured_on(item.issue.repository, item.issue)) != []
                  }
                  class="mb-4 text-xs text-slate-500"
                >
                  GitHub labels: {Enum.join(other_labels, ", ")}
                </p>
                <div
                  :if={
                    item.dependencies != [] or item.issue.dependency_overflow or
                      item.issue.dependency_unknown_count > 0 or
                      not item.issue.dependencies_projected
                  }
                  id={"issue-dependencies-#{item.issue.id}"}
                  class="mt-4 rounded-xl border border-amber-400/15 bg-amber-400/[0.05] p-4"
                >
                  <p class="text-xs font-semibold uppercase tracking-wide text-amber-300">
                    Dependencies
                  </p>
                  <div class="mt-2 flex flex-wrap gap-2">
                    <a
                      :for={dependency <- item.dependencies}
                      id={dependency_dom_id(item.issue.id, dependency)}
                      href={dependency_url(item.issue.repository, dependency)}
                      target="_blank"
                      rel="noreferrer"
                      class="rounded-lg bg-white/5 px-3 py-2 text-xs text-slate-300 ring-1 ring-white/10 hover:bg-white/10"
                    >
                      Blocked by {dependency.repository_full_name}#{dependency.number} · {dependency_status(
                        dependency
                      )} ↗
                    </a>
                  </div>
                  <p
                    :if={item.dependency_cycle}
                    id={"issue-dependency-cycle-#{item.issue.id}"}
                    class="mt-3 text-xs font-medium text-rose-300"
                  >
                    Dependency cycle: {dependency_cycle_label(item.dependency_cycle)}. Maintainer attention is required.
                  </p>
                  <p
                    :if={dependencies_unknown?(item.dependencies)}
                    class="mt-3 text-xs text-amber-300"
                  >
                    GitHub did not provide enough information about every blocker. This issue stays out of the work queue until the dependency can be synchronized.
                  </p>
                  <p
                    :if={dependencies_need_decision?(item.dependencies)}
                    class="mt-3 text-xs text-amber-300"
                  >
                    A prerequisite was closed without being completed. Decide whether to remove or replace that dependency before implementation starts.
                  </p>
                  <p
                    :if={item.issue.dependency_unknown_count > 0}
                    class="mt-3 text-xs text-amber-300"
                  >
                    GitHub reports {item.issue.dependency_unknown_count} blocker(s) that this account cannot inspect. This issue stays out of the work queue.
                  </p>
                  <p
                    :if={not item.issue.dependencies_projected}
                    class="mt-3 text-xs text-amber-300"
                  >
                    Dependency state has not been synchronized yet. Run GitHub sync before approval.
                  </p>
                  <p
                    :if={item.issue.dependency_overflow}
                    class="mt-3 text-xs text-amber-300"
                  >
                    More than 100 blockers were declared. Simplify the dependency list before approval.
                  </p>
                  <p
                    :if={
                      item.issue.dependencies_projected and not item.issue.dependency_overflow and
                        item.issue.dependency_unknown_count == 0 and
                        is_nil(item.dependency_cycle) and
                        dependencies_resolved?(item.dependencies)
                    }
                    class="mt-3 text-xs text-teal-300"
                  >
                    All recorded blockers are complete. This issue can start when the other approval checks pass.
                  </p>
                </div>

                <div :if={item.proposal} class="mt-5 grid gap-4 sm:grid-cols-2">
                  <div class="rounded-xl bg-white/[0.035] p-4 sm:col-span-2">
                    <p class="text-xs font-semibold uppercase tracking-wide text-teal-300">
                      In plain language
                    </p>
                    <p class="mt-2 leading-7 text-slate-200">{item.proposal.plain_summary}</p>
                  </div>
                  <div>
                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">
                      Why it matters
                    </p>
                    <p class="mt-1 text-sm leading-6 text-slate-300">
                      {item.proposal.why_it_matters}
                    </p>
                  </div>
                  <div class="flex gap-3 sm:justify-end">
                    <span class="rounded-lg bg-white/5 px-3 py-2 text-xs text-slate-300">
                      Scope: {item.proposal.scope}
                    </span>
                    <span class="rounded-lg bg-white/5 px-3 py-2 text-xs text-slate-300">
                      Risk: {item.proposal.risk}
                    </span>
                  </div>
                </div>

                <p
                  :if={!item.proposal and !PlanningGroup.collection?(item)}
                  class="mt-4 text-sm text-amber-300"
                >
                  This issue still needs a manager investigation.
                </p>
                <p
                  :if={PlanningGroup.collection?(item)}
                  id={"collection-note-#{item.issue.id}"}
                  class="mt-4 text-sm text-slate-400"
                >
                  A collection is never investigated or implemented itself; its members are. Start a run to deliver them.
                </p>

                <details
                  :if={item.proposal}
                  id={"technical-evidence-#{item.issue.id}"}
                  phx-mounted={JS.ignore_attributes("open")}
                  class="group mt-5 rounded-xl border border-white/10 px-4 py-3"
                >
                  <summary class="cursor-pointer text-sm font-medium text-slate-300">
                    Technical evidence
                  </summary>
                  <p class="mt-3 whitespace-pre-line text-sm leading-6 text-slate-400">
                    {item.proposal.technical_evidence}
                  </p>
                </details>

                <div class="mt-5 flex flex-wrap items-center gap-3">
                  <button
                    :for={action <- secondary_issue_actions(item, group)}
                    id={"agent-action-#{action.key}-issue-#{item.issue.id}"}
                    phx-click="run-agent-action"
                    phx-value-action-key={action.key}
                    phx-value-target-id={item.issue.id}
                    disabled={active_agent_action?(item.issue_agent_action)}
                    title={action.description}
                    class="rounded-xl bg-violet-400 px-4 py-2.5 text-sm font-semibold text-slate-950 transition hover:bg-violet-300 disabled:cursor-not-allowed disabled:bg-slate-700 disabled:text-slate-400"
                  >
                    {action.label}
                  </button>
                  <span
                    :if={source_note = agent_action_source_note(item.issue_agent_action)}
                    id={"agent-action-source-#{item.issue_agent_action.id}"}
                    class="rounded-xl border border-white/10 bg-slate-950/60 px-3 py-2 text-xs font-medium text-slate-400"
                  >
                    {source_note}
                  </span>
                  <.work_status
                    :if={item.active_job}
                    state={item.active_job.state}
                    label={"Job #{job_label(item.active_job.state)}"}
                    class="rounded-xl px-4 py-2.5 text-sm"
                  />
                  <span
                    :if={item.active_job}
                    id={"job-review-count-#{item.active_job.id}"}
                    class="rounded-xl border border-white/10 bg-white/[0.04] px-3 py-2.5 text-xs font-medium text-slate-400"
                  >
                    {job_review_label(item.active_job, item.issue.repository)}
                  </span>
                  <button
                    :if={
                      item.active_job &&
                        item.active_job.state in ["awaiting_reconciliation", "verifying_result"]
                    }
                    id={"reconcile-job-#{item.active_job.id}"}
                    phx-click="reconcile-result"
                    phx-value-job-id={item.active_job.id}
                    disabled={reconciling_result?(@reconciling_results, item.active_job.id)}
                    class="rounded-xl bg-white/10 px-4 py-2.5 text-sm font-semibold text-white hover:bg-white/15 disabled:cursor-not-allowed disabled:text-slate-500"
                  >
                    <%= if reconciling_result?(@reconciling_results, item.active_job.id) do %>
                      <span class="inline-flex items-center gap-1.5">
                        <.icon
                          name="hero-arrow-path-mini"
                          class="size-4 motion-safe:animate-spin"
                        /> Checking branch…
                      </span>
                    <% else %>
                      {if item.active_job.state == "verifying_result",
                        do: "Check verification status",
                        else: "Check committed branch"}
                    <% end %>
                  </button>
                  <.work_status
                    :if={!item.active_job && item.latest_job}
                    state={item.latest_job.state}
                    label={"Last job #{item.latest_job.state}"}
                    class="rounded-xl px-4 py-2.5 text-sm"
                  />
                  <span :if={item.proposal && !fresh?(item)} class="text-xs text-amber-300">
                    Summary is stale
                  </span>
                </div>
                <%= if decision = issue_decision(item.issue, item.issue_agent_action) do %>
                  <div
                    id={"issue-decision-#{item.issue.id}"}
                    class="mt-4 rounded-xl border border-amber-300/25 bg-amber-300/[0.07] p-4 sm:p-5"
                  >
                    <p class="text-xs font-semibold uppercase tracking-wide text-amber-200">
                      Your decision is needed
                    </p>
                    <h3 class="mt-2 text-base font-semibold leading-6 text-white">
                      {decision.question}
                    </h3>
                    <div class="mt-3 grid gap-3 text-sm leading-6 sm:grid-cols-2">
                      <div class="rounded-lg bg-black/15 p-3">
                        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">
                          In simple language
                        </p>
                        <p class="mt-1 text-slate-200">
                          {agent_action_private_summary(item.issue_agent_action) ||
                            "Choose the behavior you want the implementation to follow."}
                        </p>
                      </div>
                      <div class="rounded-lg bg-black/15 p-3">
                        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">
                          Why the choice matters
                        </p>
                        <p class="mt-1 text-slate-300">
                          {item.proposal && item.proposal.why_it_matters}
                        </p>
                      </div>
                    </div>

                    <.form
                      for={%{}}
                      as={:decision}
                      id={"resolve-decision-form-#{item.issue.id}"}
                      phx-submit="resolve-issue-decision"
                      class="mt-4 space-y-3"
                    >
                      <input type="hidden" name="issue-id" value={item.issue.id} />
                      <input
                        type="hidden"
                        name="source-action-id"
                        value={item.issue_agent_action.id}
                      />
                      <label
                        :for={option <- decision.options}
                        class="flex cursor-pointer items-start gap-3 rounded-xl border border-white/10 bg-slate-950/45 p-3 transition hover:border-amber-200/40"
                      >
                        <input
                          type="radio"
                          name="decision[choice]"
                          value={option.index}
                          disabled={active_agent_action?(item.issue_agent_action)}
                          class="mt-1 size-4 border-white/20 bg-slate-900 text-amber-300 focus:ring-amber-300"
                        />
                        <span class="min-w-0">
                          <span class="block font-semibold text-white">
                            {option.letter} — {option.label}
                          </span>
                          <span class="mt-1 block text-sm leading-6 text-slate-300">
                            {option.description}
                          </span>
                          <span class="mt-2 block text-xs leading-5 text-slate-500">
                            Example: {option.example}
                          </span>
                        </span>
                      </label>

                      <label class="block rounded-xl border border-dashed border-white/15 p-3">
                        <span class="text-sm font-semibold text-slate-200">
                          Or write another answer
                        </span>
                        <span class="mt-1 block text-xs leading-5 text-slate-500">
                          Explain the result you want. The agent will turn it into acceptance criteria on the GitHub issue.
                        </span>
                        <textarea
                          id={"custom-decision-answer-#{item.issue.id}"}
                          name="decision[custom_answer]"
                          rows="3"
                          maxlength="2000"
                          disabled={active_agent_action?(item.issue_agent_action)}
                          placeholder="Example: Use exact exports for doc, but keep apropos namespace-only for now."
                          class="mt-2 block w-full rounded-lg border border-white/10 bg-slate-950 px-3 py-2 text-sm leading-6 text-white outline-none focus:border-amber-300/60"
                        ></textarea>
                      </label>

                      <div class="flex flex-wrap items-center gap-3">
                        <button
                          type="submit"
                          disabled={active_agent_action?(item.issue_agent_action)}
                          class="rounded-lg bg-amber-300 px-4 py-2.5 text-sm font-semibold text-slate-950 hover:bg-amber-200 disabled:cursor-not-allowed disabled:bg-slate-700 disabled:text-slate-400"
                        >
                          Apply decision
                        </button>
                        <span class="text-xs leading-5 text-slate-500">
                          This queues an agent to update GitHub; it does not start implementation.
                        </span>
                      </div>
                    </.form>
                  </div>
                <% else %>
                  <%= if refresh_reason = decision_refresh_reason(item.issue, item.issue_agent_action) do %>
                    <div
                      id={"issue-decision-refresh-#{item.issue.id}"}
                      class="mt-4 rounded-xl border border-amber-300/25 bg-amber-300/[0.07] p-4"
                    >
                      <p class="text-xs font-semibold uppercase tracking-wide text-amber-200">
                        <%= if refresh_reason == :issue_changed do %>
                          Issue changed since this decision was prepared
                        <% else %>
                          Decision choices need a refresh
                        <% end %>
                      </p>
                      <p class="mt-2 text-sm leading-6 text-slate-200">
                        <%= if refresh_reason == :issue_changed do %>
                          GitHub has newer issue content, so these choices may no longer be correct. Run Prepare issue again to analyze the current version before deciding.
                        <% else %>
                          This completed result has no valid structured choices, possibly because it was created before they were required. Run Prepare issue again to get a clear question, 2–4 alternatives, and an example for each one.
                        <% end %>
                      </p>
                      <button
                        type="button"
                        phx-click="run-agent-action"
                        phx-value-action-key="prepare_issue"
                        phx-value-target-id={item.issue.id}
                        disabled={active_agent_action?(item.issue_agent_action)}
                        class="mt-3 rounded-lg bg-amber-300 px-4 py-2.5 text-sm font-semibold text-slate-950 hover:bg-amber-200 disabled:cursor-not-allowed disabled:bg-slate-700 disabled:text-slate-400"
                      >
                        Refresh decision choices
                      </button>
                    </div>
                  <% end %>
                  <div
                    :if={
                      agent_action_private_summary(item.issue_agent_action) &&
                        is_nil(decision_refresh_reason(item.issue, item.issue_agent_action))
                    }
                    class="mt-4 rounded-xl border border-violet-400/20 bg-violet-400/[0.06] p-4"
                  >
                    <p class="text-xs font-semibold uppercase tracking-wide text-violet-300">
                      Private agent result · {agent_action_outcome(item.issue_agent_action)}
                    </p>
                    <p class="mt-2 text-sm leading-6 text-slate-200">
                      {agent_action_private_summary(item.issue_agent_action)}
                    </p>
                  </div>
                <% end %>

                <details
                  :if={
                    agent_action_result_items(item.issue_agent_action, "github_changes") != [] or
                      agent_action_result_items(item.issue_agent_action, "evidence") != []
                  }
                  id={"agent-action-details-#{item.issue_agent_action.id}"}
                  phx-mounted={JS.ignore_attributes("open")}
                  class="mt-3 text-xs text-slate-400"
                >
                  <summary class="cursor-pointer font-medium text-slate-300">
                    Action details
                  </summary>
                  <ul class="mt-2 list-disc space-y-1 pl-5">
                    <li :for={
                      change <-
                        agent_action_result_items(item.issue_agent_action, "github_changes")
                    }>
                      {change}
                    </li>
                    <li :for={
                      evidence <- agent_action_result_items(item.issue_agent_action, "evidence")
                    }>
                      {evidence}
                    </li>
                  </ul>
                </details>
                <p
                  :if={agent_action_failure(item.issue_agent_action)}
                  class="mt-3 text-xs leading-5 text-amber-300"
                >
                  {agent_action_failure(item.issue_agent_action)}
                </p>
                <div
                  :if={
                    item.active_job &&
                      item.active_job.state in [
                        "ready_for_pr",
                        "publishing_pr",
                        "pr_open",
                        "publish_blocked"
                      ]
                  }
                  class="mt-4 rounded-xl border border-teal-400/20 bg-teal-400/[0.06] p-4 text-sm"
                >
                  <p class="font-semibold text-teal-300">
                    <%= cond do %>
                      <% item.publication && item.publication.state == "published" -> %>
                        PR published
                      <% item.publication && item.publication.state == "publishing" -> %>
                        Publishing exact verified commit…
                      <% item.publication && item.publication.state == "blocked" -> %>
                        PR verification needs attention
                      <% true -> %>
                        Waiting for publication
                    <% end %>
                  </p>
                  <p class="mt-1 text-slate-400">
                    {item.active_job.result_commit_count} committed change(s) verified against <span class="font-mono">{String.slice(item.active_job.result_base_sha, 0, 8)}</span>.
                    Head <span class="font-mono">{String.slice(item.active_job.result_head_sha, 0, 8)}</span>.
                  </p>
                  <%= cond do %>
                    <% item.publication && item.publication.state == "published" -> %>
                      <a
                        id={"publication-pr-#{item.publication.id}"}
                        href={item.publication.pr_url}
                        target="_blank"
                        class="mt-2 inline-block text-xs font-semibold text-teal-300 hover:text-teal-200"
                      >
                        Open PR #{item.publication.pr_number} ↗
                      </a>
                      <div class="mt-3 flex flex-wrap items-center gap-3">
                        <button
                          :for={action <- ActionCatalog.pull_request_actions(item.publication)}
                          id={"agent-action-#{action.key}-pr-#{item.publication.id}"}
                          phx-click="run-agent-action"
                          phx-value-action-key={action.key}
                          phx-value-target-id={item.publication.id}
                          disabled={active_agent_action?(item.pr_agent_action)}
                          title={action.description}
                          class="rounded-lg bg-violet-400 px-3 py-2 text-xs font-semibold text-slate-950 hover:bg-violet-300 disabled:cursor-not-allowed disabled:bg-slate-700 disabled:text-slate-400"
                        >
                          {action.label}
                        </button>
                        <.work_status
                          :if={item.pr_agent_action}
                          state={item.pr_agent_action.state}
                          label={agent_action_label(item.pr_agent_action)}
                          class="rounded-lg px-3 py-2"
                        />
                      </div>
                    <% item.publication && item.publication.state == "blocked" -> %>
                      <p class="mt-2 text-xs text-amber-300">
                        {publication_error(item.publication.last_error)} No merge can occur; retry after correcting the cause.
                      </p>
                      <button
                        id={"retry-publication-#{item.publication.id}"}
                        phx-click="retry-publication"
                        phx-value-publication-id={item.publication.id}
                        class="mt-3 rounded-lg bg-white/10 px-3 py-2 text-xs font-semibold text-white hover:bg-white/15"
                      >
                        Retry publishing
                      </button>
                    <% item.publication && item.publication.state == "publishing" -> %>
                      <p class="mt-2 text-xs text-slate-500">
                        PtcManager is publishing the exact verified commit through its isolated broker.
                      </p>
                    <% agent_publication?(item) -> %>
                      <p class="mt-2 text-xs text-slate-500">
                        Waiting for GitHub to report the agent-created PR for this exact branch and commit.
                      </p>
                    <% @publication_enabled -> %>
                      <p class="mt-2 text-xs text-slate-500">
                        PtcManager will publish this exact commit after its local branch result is verified.
                      </p>
                      <p
                        :if={item.publication && item.publication.last_error}
                        class="mt-1 text-xs text-amber-300"
                      >
                        The last PR verification did not match yet. PtcManager will check again.
                      </p>
                    <% true -> %>
                      <p class="mt-2 text-xs text-amber-300">
                        Waiting safely until automatic publication is enabled.
                      </p>
                  <% end %>
                </div>
                <div
                  :if={
                    !item.active_job && item.publication &&
                      item.publication.pr_state in ["merged", "closed"]
                  }
                  class="mt-4 rounded-xl border border-white/10 bg-white/[0.035] p-4 text-sm"
                >
                  <p class="font-semibold text-slate-200">
                    Pull request {item.publication.pr_state}
                  </p>
                  <p class="mt-1 text-xs text-slate-500">
                    GitHub is authoritative; this implementation no longer occupies the active queue.
                  </p>
                  <a
                    href={item.publication.pr_url}
                    target="_blank"
                    class="mt-2 inline-block text-xs font-semibold text-teal-300 hover:text-teal-200"
                  >
                    Open PR #{item.publication.pr_number} ↗
                  </a>
                  <div class="mt-3 flex flex-wrap items-center gap-3">
                    <button
                      :for={action <- ActionCatalog.pull_request_actions(item.publication)}
                      id={"agent-action-#{action.key}-pr-#{item.publication.id}"}
                      phx-click="run-agent-action"
                      phx-value-action-key={action.key}
                      phx-value-target-id={item.publication.id}
                      disabled={active_agent_action?(item.pr_agent_action)}
                      title={action.description}
                      class="rounded-lg bg-violet-400 px-3 py-2 text-xs font-semibold text-slate-950 hover:bg-violet-300 disabled:cursor-not-allowed disabled:bg-slate-700 disabled:text-slate-400"
                    >
                      {action.label}
                    </button>
                    <.work_status
                      :if={item.pr_agent_action}
                      state={item.pr_agent_action.state}
                      label={agent_action_label(item.pr_agent_action)}
                      class="rounded-lg px-3 py-2"
                    />
                  </div>
                  <div
                    :if={agent_action_private_summary(item.pr_agent_action)}
                    class="mt-3 rounded-lg bg-violet-400/[0.06] p-3"
                  >
                    <p class="text-xs font-semibold text-violet-300">
                      Private retrospective · {agent_action_outcome(item.pr_agent_action)}
                    </p>
                    <p class="mt-1 text-xs leading-5 text-slate-300">
                      {agent_action_private_summary(item.pr_agent_action)}
                    </p>
                  </div>
                </div>
                <p
                  :if={
                    item.active_job && item.active_job.state == "awaiting_reconciliation" &&
                      item.active_job.last_error
                  }
                  class="mt-3 text-xs text-amber-300"
                >
                  Branch verification is pending. You can retry the read-only check safely.
                  PtcManager reported
                  <span class="break-words font-mono text-amber-200">
                    {item.active_job.last_error}
                  </span>
                  on its last attempt; if it cannot pass, abandon the job on the Delivery board.
                </p>
                <p
                  :if={!item.active_job && item.latest_job && item.latest_job.last_error}
                  class="mt-3 text-xs text-rose-300"
                >
                  The last attempt stopped safely. Review the service audit log before trying again.
                  <span class="mt-1 block break-words font-mono text-rose-200">
                    {item.latest_job.last_error}
                  </span>
                </p>
                <button
                  :if={!item.active_job && item.latest_job && resumable_job?(item.latest_job)}
                  id={"resume-worktree-#{item.latest_job.id}"}
                  phx-click="resume-from-worktree"
                  phx-value-job-id={item.latest_job.id}
                  title="Approve afresh and continue in the worktree the last attempt left behind"
                  class="mt-3 inline-flex items-center gap-1.5 rounded-lg bg-teal-400 px-3 py-1.5 text-xs font-semibold text-slate-950 hover:bg-teal-300"
                >
                  <.icon name="hero-play-mini" class="size-3.5" /> Resume in its worktree
                </button>
              </div>
            </article>
          </div>
        </section>

        <div
          :if={@grouped_issues == []}
          class="rounded-2xl border border-dashed border-white/10 p-10 text-center text-slate-500"
        >
          No open issues need planning.
        </div>
      </div>
    </section>

    <aside aria-labelledby="agent-activity-title" class="min-w-0">
      <div class="mb-4 flex items-center justify-between">
        <div>
          <h2 id="agent-activity-title" class="text-lg font-semibold">Agent activity</h2>
          <p :if={@selected_repository} class="mt-1 text-xs text-slate-500">
            Filtered to {@selected_repository}
          </p>
        </div>
        <span class="size-2 rounded-full bg-teal-400 shadow-[0_0_12px_rgba(45,212,191,0.8)]">
        </span>
      </div>

      <div id="agent-activity" class="space-y-3 xl:sticky xl:top-24">
        <article
          :for={worker <- @workers}
          id={"worker-capacity-#{worker.id}"}
          class="rounded-2xl border border-white/10 bg-slate-900/70 p-5"
        >
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-sm font-semibold">{worker.name}</p>
              <p class="mt-0.5 text-xs text-slate-500">
                Implementation worktrees · machine-wide
              </p>
            </div>
            <div class="text-right">
              <span class="rounded-full bg-white/5 px-2.5 py-1 text-xs text-slate-300 ring-1 ring-white/10">
                {active_worktrees(worker)} / {worker_capacity(worker)} active
              </span>
              <p :if={retained_worktrees(worker) > 0} class="mt-2 text-[11px] text-violet-300">
                {retained_worktrees(worker)} retained
              </p>
            </div>
          </div>
          <div :if={worker.worktree_allocations != []} class="mt-3 space-y-2">
            <div
              :for={allocation <- worker.worktree_allocations}
              :if={allocation.state != "removed"}
              id={"worktree-allocation-#{allocation.id}"}
              class="rounded-lg bg-white/[0.035] px-3 py-2 text-xs"
            >
              <div class="flex items-center justify-between gap-2">
                <span class="text-slate-300">
                  <%= if allocation.job do %>
                    #{allocation.job.issue.number} · {allocation.job.repository.github_name}
                  <% else %>
                    Unattached worktree
                  <% end %>
                </span>
                <span class="text-slate-500">{worktree_state_label(allocation.state)}</span>
              </div>
              <p :if={allocation.last_error} class="mt-1 text-amber-300">
                Cleanup requires attention
              </p>
              <p :if={allocation.retained_observed_at} class="mt-1 text-slate-400">
                <%= if allocation.retained_dirty do %>
                  Uncommitted changes
                <% else %>
                  Clean checkout
                <% end %>
                · {allocation.retained_local_commits || 0} local {if allocation.retained_local_commits ==
                                                                       1,
                                                                     do: "commit",
                                                                     else: "commits"} beyond the default branch
                <span :if={is_integer(allocation.retained_unpushed_commits)}>
                  · {allocation.retained_unpushed_commits} unpushed
                </span>
              </p>
              <div :if={discardable_worktree?(allocation)} class="mt-2 flex flex-wrap gap-2">
                <button
                  type="button"
                  phx-click="preserve-worktree"
                  phx-value-allocation-id={allocation.id}
                  data-confirm="Create a recoverable Git bundle and binary patch, then close this worktree?"
                  class="rounded-md border border-violet-400/20 px-2 py-1 text-[11px] font-semibold text-violet-300 hover:bg-violet-400/10"
                >
                  Preserve and close
                </button>
                <button
                  type="button"
                  phx-click="discard-worktree"
                  phx-value-allocation-id={allocation.id}
                  data-confirm="Discard this worktree? Uncommitted work in it is lost."
                  class="rounded-md border border-rose-400/20 px-2 py-1 text-[11px] font-semibold text-rose-300 hover:bg-rose-400/10"
                >
                  Discard worktree
                </button>
              </div>
            </div>
          </div>
          <p :if={worker.worktree_allocations == []} class="mt-3 text-xs text-slate-600">
            No worktrees allocated
          </p>
        </article>

        <div class="flex items-center justify-between pt-2">
          <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-500">Active now</h3>
          <span class="text-xs text-slate-600">{length(@active_agent_runs)}</span>
        </div>

        <article
          :for={run <- @active_agent_runs}
          id={"agent-run-#{run.id}"}
          class="rounded-2xl border border-white/10 bg-slate-900/70 p-5"
        >
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-sm font-semibold capitalize">{agent_name(run)}</p>
              <p class="mt-0.5 text-xs text-slate-500">
                {run.worker.name} · <span class="capitalize">{run.role} agent</span>
              </p>
            </div>
            <.work_status state={run.state} label={run.state} />
          </div>

          <div :if={run.job} class="mt-4">
            <p class="text-xs text-slate-500">
              {run.job.repository.github_name} · #{run.job.issue.number}
            </p>
            <p class="mt-1 text-sm leading-6 text-slate-200">{run.job.issue.title}</p>
          </div>

          <div :if={run.agent_action} class="mt-4">
            <p class="text-xs text-slate-500">{run.agent_action.target_label}</p>
            <p class="mt-1 text-sm capitalize leading-6 text-slate-200">
              {String.replace(run.agent_action.action_key, "_", " ")}
            </p>
          </div>

          <p :if={!run.job && !run.agent_action} class="mt-4 text-sm text-slate-300">
            Repository maintenance
          </p>
          <p :if={run.status_text} class="mt-3 text-sm leading-6 text-slate-400">
            {run.status_text}
          </p>

          <dl class="mt-4 grid grid-cols-2 gap-3 border-t border-white/10 pt-4 text-xs">
            <div>
              <dt class="text-slate-600">Working for</dt>
              <dd class="mt-1 font-medium text-slate-300">
                {elapsed(run.ended_at || @now, run.started_at)}
              </dd>
            </div>
            <div>
              <dt class="text-slate-600">Last seen</dt>
              <dd class="mt-1 font-medium text-slate-300">
                {elapsed(@now, run.last_heartbeat_at)} ago
              </dd>
            </div>
          </dl>

          <p :if={run.herdr_workspace} class="mt-3 truncate font-mono text-[11px] text-slate-600">
            {run.herdr_workspace}:{run.herdr_pane}
          </p>
        </article>

        <div
          :if={@active_agent_runs == []}
          class="rounded-2xl border border-dashed border-white/10 p-8 text-center text-sm text-slate-500"
        >
          No agents are working right now.
        </div>

        <section id="waiting-agents" aria-labelledby="waiting-agents-title" class="pt-4">
          <div class="mb-3 flex items-center justify-between">
            <h3
              id="waiting-agents-title"
              class="text-xs font-semibold uppercase tracking-wide text-slate-500"
            >
              Retained / waiting
            </h3>
            <span class="text-xs text-slate-600">{length(@waiting_agent_runs)}</span>
          </div>

          <div class="space-y-2">
            <article
              :for={run <- @waiting_agent_runs}
              id={"waiting-agent-run-#{run.id}"}
              class="rounded-xl border border-violet-400/15 bg-violet-400/[0.05] px-4 py-3"
            >
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <p class="truncate text-sm font-medium text-violet-200">{agent_name(run)}</p>
                  <p :if={run.job} class="mt-1 line-clamp-2 text-xs leading-5 text-slate-400">
                    #{run.job.issue.number} · {run.job.issue.title}
                  </p>
                  <p class="mt-1 text-[11px] text-slate-600">
                    Session and worktree retained until the PR is merged or closed
                  </p>
                </div>
                <.work_status
                  state={run.state}
                  label="waiting"
                  class="shrink-0 px-2 py-0.5 text-[11px]"
                />
              </div>
            </article>

            <p
              :if={@waiting_agent_runs == []}
              class="rounded-xl border border-dashed border-white/10 px-4 py-5 text-center text-xs text-slate-600"
            >
              No retained sessions are waiting.
            </p>
          </div>
        </section>

        <section id="agent-history" aria-labelledby="agent-history-title" class="pt-4">
          <div class="mb-3 flex items-center justify-between">
            <h3
              id="agent-history-title"
              class="text-xs font-semibold uppercase tracking-wide text-slate-500"
            >
              Recent history
            </h3>
            <span class="text-xs text-slate-600">Latest {length(@recent_agent_runs)}</span>
          </div>

          <div class="space-y-2">
            <article
              :for={run <- @recent_agent_runs}
              id={"agent-history-run-#{run.id}"}
              class="rounded-xl border border-white/10 bg-slate-900/50 px-4 py-3"
            >
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <p class="truncate text-sm text-slate-300">
                    <%= cond do %>
                      <% run.job -> %>
                        #{run.job.issue.number} · {run.job.issue.title}
                      <% run.agent_action -> %>
                        {run.agent_action.target_label} · {String.replace(
                          run.agent_action.action_key,
                          "_",
                          " "
                        )}
                      <% true -> %>
                        Repository maintenance
                    <% end %>
                  </p>
                  <p class="mt-1 text-xs text-slate-600">
                    <span class="capitalize">{agent_name(run)}</span>
                    · {run.worker.name} · {elapsed(
                      run.ended_at,
                      run.started_at
                    )} · ended {short_time(run.ended_at)}
                  </p>
                </div>
                <.work_status
                  state={run.state}
                  label={run.state}
                  class="shrink-0 px-2 py-0.5 text-[11px]"
                />
              </div>
            </article>

            <p
              :if={@recent_agent_runs == []}
              class="rounded-xl border border-dashed border-white/10 px-4 py-5 text-center text-xs text-slate-600"
            >
              No completed agent runs yet.
            </p>
          </div>
        </section>
      </div>
    </aside>
  </div>
</Layouts.app>
