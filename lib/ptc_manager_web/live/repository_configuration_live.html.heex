<Layouts.app flash={@flash} current_path="/configuration">
  <div class="space-y-8">
    <section class="flex flex-col justify-between gap-5 lg:flex-row lg:items-end">
      <div>
        <.link
          navigate={~p"/configuration"}
          class="text-sm font-semibold uppercase tracking-[0.2em] text-teal-300 hover:text-teal-200"
        >
          ← Configuration
        </.link>
        <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">
          {full_name(@repository)}
        </h1>
        <p class="mt-3 text-sm text-slate-400">
          Default branch: {@repository.default_branch}
        </p>
        <p class="mt-1 break-all font-mono text-xs text-slate-500">
          Checkout: {@repository.local_path}
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <span class={[
          "rounded-full px-2.5 py-1 text-xs font-semibold",
          if(@repository.enabled,
            do: "bg-teal-400/15 text-teal-200",
            else: "bg-white/5 text-slate-400"
          )
        ]}>
          {if(@repository.enabled, do: "Enabled", else: "Disabled")}
        </span>
        <button
          id="toggle-repository"
          phx-click="set-repository-enabled"
          phx-value-enabled={to_string(!@repository.enabled)}
          data-confirm={
            if @repository.enabled,
              do: nil,
              else:
                "Enable #{full_name(@repository)}? Synchronization will cover it and its automations become available."
          }
          class={[
            "rounded-lg px-3 py-2 text-xs font-semibold",
            if(@repository.enabled,
              do: "bg-white/10 text-slate-200 hover:bg-white/15",
              else: "bg-teal-400 text-slate-950 hover:bg-teal-300"
            )
          ]}
        >
          {if @repository.enabled, do: "Disable", else: "Enable"}
        </button>
        <.link
          navigate={"/automations?repo=" <> URI.encode_www_form(full_name(@repository))}
          class="inline-flex rounded-lg border border-teal-400/25 px-3 py-2 text-xs font-semibold text-teal-200 hover:border-teal-400/40"
        >
          Edit prompts and automations
        </.link>
      </div>
    </section>

    <section id="repository-health" class="rounded-2xl border border-white/10 bg-slate-900/70 p-5">
      <h2 class="text-lg font-semibold text-white">Health</h2>
      <p class="mt-1 text-sm leading-6 text-slate-400">
        A repository needs its own verified checkout, readable GitHub data, the <code>ptc:</code>
        labels its agents are told to write, and a checked-in setup contract. Independent publication verification is optional and only needed when PtcManager publishes through its GitHub App broker.
      </p>
      <dl class="mt-5 grid gap-3 lg:grid-cols-2">
        <div
          :for={
            check <- [
              @health.checkout,
              @health.github,
              @health.labels,
              @health.gate,
              @health.service_access
            ]
          }
          class="rounded-xl bg-white/[0.035] p-3"
        >
          <div class="flex flex-wrap items-center justify-between gap-2">
            <dt class="text-sm font-medium text-slate-200">{check.label}</dt>
            <span class={[
              "rounded-full px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide",
              health_classes(check.status)
            ]}>
              {check.status}
            </span>
          </div>
          <dd class="mt-1 break-words font-mono text-xs leading-5 text-slate-500">
            {health_detail(check)}
          </dd>
        </div>
      </dl>
    </section>

    <section id="default-branch" class="rounded-2xl border border-white/10 bg-slate-900/70 p-5">
      <h2 class="text-lg font-semibold text-white">Default branch</h2>
      <p class="mt-1 text-xs leading-5 text-slate-500">
        The branch new worktrees start from, pull requests target, and deployments, health, and source updates read. Changing it waits until no job, maintainer action, automation run, collection run, or deployment is active, no job worktree is retained, and no managed pull request is open.
      </p>
      <p
        :if={
          @repository.github_default_branch &&
            @repository.github_default_branch != @repository.default_branch
        }
        id="default-branch-mismatch"
        class="mt-3 rounded-xl border border-amber-400/25 bg-amber-400/[0.07] px-3 py-2 text-xs leading-5 text-amber-200"
      >
        GitHub's default branch is <code>{@repository.github_default_branch}</code>, but
        PtcManager uses <code>{@repository.default_branch}</code>. PtcManager never changes it on its own.
      </p>
      <.form
        for={%{}}
        as={:branch}
        id="default-branch-form"
        phx-submit="update-default-branch"
        class="mt-3 flex flex-wrap items-end gap-2"
      >
        <label class="text-xs text-slate-400">
          Branch<input
            required
            name="branch[name]"
            value={@repository.default_branch}
            maxlength="240"
            class="mt-1 block w-64 rounded-lg border border-white/10 bg-slate-950 p-2 font-mono text-sm"
          />
        </label>
        <button class="rounded-lg bg-white/10 px-3 py-2 text-xs font-semibold text-slate-200 hover:bg-white/15">
          Save branch
        </button>
      </.form>
    </section>

    <div class="grid gap-5 xl:grid-cols-2">
      <section id="auto-fix" class="rounded-2xl border border-white/10 bg-slate-900/70 p-5">
        <h2 class="text-lg font-semibold text-white">Automatically implement ready issues</h2>
        <p class="mt-1 text-xs leading-5 text-slate-500">
          Authorize implementation of open, unassigned ptc:ready issues, including labels
          applied by preparation agents. Uses existing execution profiles and capacity limits.
          Up to the daily limit below per UTC day; previously attempted issues need a manual retry.
          Merging and deployment still require approval. Disabling prevents queued automatic
          jobs from starting; running jobs continue.
        </p>
        <button
          id="auto-fix-toggle"
          phx-click="set-auto-fix"
          phx-value-enabled={to_string(!@repository.auto_fix_issues)}
          data-confirm={
            if !@repository.auto_fix_issues,
              do:
                "Authorize automatic implementation of ready issues in this repository, including the existing backlog?",
              else: nil
          }
          class="mt-3 rounded-lg bg-white/10 px-3 py-2 text-xs font-semibold text-slate-200 hover:bg-white/15"
        >
          {if @repository.auto_fix_issues,
            do: "Disable automatic implementation",
            else: "Enable automatic implementation"}
        </button>
        <.form
          for={%{}}
          as={:auto_fix}
          id="auto-fix-daily-limit"
          phx-submit="set-auto-fix-daily-limit"
          class="mt-3 flex flex-wrap items-end gap-2"
        >
          <label class="text-xs text-slate-400">
            Issues per UTC day<input
              type="number"
              min="1"
              max="50"
              required
              name="auto_fix[daily_limit]"
              value={@repository.auto_fix_daily_limit}
              class="mt-1 block w-24 rounded-lg border border-white/10 bg-slate-950 p-2 text-sm"
            />
          </label>
          <button class="rounded-lg bg-white/10 px-3 py-2 text-xs font-semibold text-slate-200 hover:bg-white/15">
            Save limit
          </button>
        </.form>
      </section>

      <section
        id="maintainer-labels"
        class="rounded-2xl border border-white/10 bg-slate-900/70 p-5"
      >
        <h2 class="text-lg font-semibold text-white">Your triage labels</h2>
        <p class="mt-1 text-xs leading-5 text-slate-500">
          GitHub labels you use to sort the Planning backlog. A <strong>badge</strong>
          label is shown on the card; a <strong>park</strong>
          label moves the issue into Planning's Waiting group and changes nothing else. The
          label must already exist in the GitHub repository; PtcManager never creates one.
        </p>

        <ul :if={@maintainer_labels != []} class="mt-3 flex flex-wrap gap-2">
          <li
            :for={label <- @maintainer_labels}
            class="inline-flex items-center gap-2 rounded-full bg-white/5 px-3 py-1 text-xs text-slate-300 ring-1 ring-white/10"
          >
            <span class="font-medium">{label["name"]}</span>
            <span class="text-slate-500">{label["role"]}</span>
            <button
              type="button"
              phx-click="remove-maintainer-label"
              phx-value-name={label["name"]}
              aria-label={"Remove #{label["name"]}"}
              class="text-rose-300 hover:text-rose-200"
            >
              ×
            </button>
          </li>
        </ul>

        <.form
          for={%{}}
          as={:label}
          id="add-maintainer-label"
          phx-submit="add-maintainer-label"
          class="mt-3 flex flex-wrap items-end gap-2"
        >
          <label class="text-xs text-slate-400">
            Label name<input
              required
              name="label[name]"
              maxlength="50"
              placeholder="wait"
              class="mt-1 w-40 rounded-lg border border-white/10 bg-slate-950 p-2 text-sm"
            />
          </label>
          <label class="text-xs text-slate-400">
            Role<select
              name="label[role]"
              class="mt-1 block rounded-lg border border-white/10 bg-slate-950 p-2 text-sm"
            >
              <option value="badge">badge</option>
              <option value="park">park</option>
            </select>
          </label>
          <button class="rounded-lg bg-teal-400 px-3 py-2 text-xs font-semibold text-slate-950 hover:bg-teal-300">
            Add label
          </button>
        </.form>
      </section>
    </div>

    <section
      id="agent-environment"
      class="rounded-2xl border border-white/10 bg-slate-900/70 p-5"
      aria-label="Implementation agent environment"
    >
      <h2 class="text-lg font-semibold text-white">Implementation agent environment</h2>
      <p class="mt-1 text-xs leading-5 text-slate-500">
        Write-only repository variables. Values are encrypted and supplied only to implementation agents and their managed commands—not setup or maintainer-action agents.
      </p>

      <.form
        for={%{}}
        as={:variable}
        phx-submit="save-agent-environment-variable"
        class="mt-3 grid max-w-3xl gap-2 sm:grid-cols-[1fr_1fr_auto]"
      >
        <label class="text-xs text-slate-400">
          Name<input
            required
            name="variable[name]"
            pattern="[A-Z_][A-Z0-9_]*"
            autocomplete="off"
            placeholder="OPENROUTER_API_KEY"
            class="mt-1 w-full rounded-lg border border-white/10 bg-slate-950 p-2 font-mono text-sm"
          />
        </label>
        <label class="text-xs text-slate-400">
          Value<input
            required
            type="password"
            name="variable[secret]"
            autocomplete="new-password"
            class="mt-1 w-full rounded-lg border border-white/10 bg-slate-950 p-2 font-mono text-sm"
          />
        </label>
        <button class="mt-5 h-fit rounded-lg bg-teal-400 px-3 py-2 text-xs font-semibold text-slate-950">
          Add or replace
        </button>
      </.form>

      <ul class="mt-3 max-w-3xl space-y-2">
        <li
          :for={variable <- @agent_environment_variables}
          id={"agent-environment-variable-#{variable.id}"}
          class="flex items-center justify-between gap-3 rounded-lg bg-white/[0.035] px-3 py-2"
        >
          <div>
            <span class="font-mono text-xs font-semibold text-slate-200">
              {variable.name}
            </span>
            <span class="ml-2 text-[11px] text-slate-500">
              Set {variable_set_at(variable.updated_at)}
            </span>
          </div>
          <button
            type="button"
            phx-click="delete-agent-environment-variable"
            phx-value-id={variable.id}
            data-confirm={"Delete #{variable.name}?"}
            class="text-xs font-semibold text-rose-300 hover:text-rose-200"
          >
            Delete
          </button>
        </li>
      </ul>
    </section>

    <section id="remove-repository" class="rounded-2xl border border-red-400/20 p-5">
      <h2 class="text-lg font-semibold text-white">Remove repository</h2>
      <p class="mt-1 text-xs leading-5 text-slate-500">
        Removes PtcManager's configuration and synchronized records. GitHub and the checkout stay as they are.
      </p>
      <button
        type="button"
        phx-click="confirm-remove-repository"
        class="mt-3 inline-flex rounded-lg border border-red-400/30 px-3 py-2 text-xs font-semibold text-red-200 hover:border-red-400/50"
      >
        Remove repository
      </button>
    </section>

    <div
      :if={@remove_repository?}
      id="remove-repository-dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="remove-repository-title"
      class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/80 p-4"
    >
      <div class="max-w-lg rounded-2xl border border-red-400/25 bg-slate-900 p-6 shadow-2xl">
        <h2 id="remove-repository-title" class="text-xl font-semibold">Remove repository?</h2>
        <p class="mt-3 text-sm leading-6 text-slate-300">
          Remove <strong>{full_name(@repository)}</strong>
          and its PtcManager-owned configuration and synchronized records? This does not delete the GitHub repository, checkout at <code>{@repository.local_path}</code>, branches, pull requests, issues, or worktrees.
        </p>
        <div class="mt-5 flex justify-end gap-3">
          <button
            type="button"
            phx-click="cancel-remove-repository"
            class="rounded-lg border border-white/15 px-4 py-2 text-sm font-semibold"
          >
            Cancel
          </button>
          <button
            type="button"
            phx-click="remove-repository"
            class="rounded-lg bg-red-500 px-4 py-2 text-sm font-semibold text-white"
          >
            Remove repository
          </button>
        </div>
      </div>
    </div>
  </div>
</Layouts.app>
