<Layouts.app
  flash={@flash}
  current_path="/board"
  repositories={@repositories}
  selected_repository={@selected_repository}
>
  <section class="mb-8">
    <p class="text-xs font-semibold uppercase tracking-[0.24em] text-teal-300">
      Delivery control
    </p>
    <div class="mt-3 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">From approval to merge</h1>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-400">
          Planning decides what should be built. This board follows approved work through implementation, attention, and merge.
        </p>
      </div>
      <div class="flex items-center gap-3">
        <div class="rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm">
          <span class="text-2xl font-semibold">{@item_count}</span><span class="ml-2 text-slate-500">active deliveries</span>
        </div>
      </div>
    </div>
  </section>

  <section class="mb-5 rounded-2xl border border-violet-400/15 bg-violet-400/[0.05] px-5 py-4 text-sm text-slate-300">
    <div class="flex gap-3">
      <.icon name="hero-sparkles-mini" class="mt-0.5 size-5 shrink-0 text-violet-300" />
      <p>
        <span class="font-semibold text-violet-200">Automation-ready view.</span>
        Today the board explains the durable state; later a manager agent can use these same lanes to pick safe next actions.
      </p>
    </div>
  </section>

  <div
    id="delivery-board"
    class="grid snap-x snap-mandatory auto-cols-[minmax(280px,86vw)] grid-flow-col gap-4 overflow-x-auto pb-5 xl:auto-cols-auto xl:grid-flow-row xl:grid-cols-4 xl:overflow-visible"
  >
    <section
      :for={lane <- @lane_definitions}
      id={"lane-#{lane.key}"}
      aria-labelledby={"lane-title-#{lane.key}"}
      class="min-w-0 snap-start"
    >
      <div class="mb-3 flex items-start justify-between gap-3 px-1">
        <div>
          <div class="flex items-center gap-2">
            <span class={["size-2 rounded-full", lane.color]}></span>
            <h2 id={"lane-title-#{lane.key}"} class="text-sm font-semibold">
              {lane_title(lane.key)}
            </h2>
          </div>
          <p class="mt-1 text-[11px] leading-4 text-slate-500">{lane.subtitle}</p>
        </div>
        <span class="rounded-full bg-white/5 px-2 py-0.5 text-xs text-slate-400 ring-1 ring-white/10">
          {length(lane_items(@lanes, lane.key))}
        </span>
      </div>

      <div class="space-y-3 rounded-2xl border border-white/[0.07] bg-black/10 p-2.5 xl:min-h-[28rem]">
        <article
          :for={item <- lane_items(@lanes, lane.key)}
          id={card_id(item)}
          class="rounded-xl border border-white/10 bg-slate-900 p-4 shadow-lg shadow-black/10"
        >
          <div class="flex items-start justify-between gap-2">
            <p class="text-[11px] font-medium text-slate-500">
              {repository_label(item)} · {pull_request_label(item)}
            </p>
            <span class="shrink-0 text-[11px] text-slate-600">{card_age(@now, item)}</span>
          </div>
          <h3 class="mt-1.5 text-sm font-semibold leading-5 text-slate-100">
            {item.title}
          </h3>

          <div
            :if={linked_issues(item) != []}
            class="mt-2 rounded-lg bg-sky-400/[0.06] px-3 py-2 ring-1 ring-sky-400/15"
          >
            <p class="text-[10px] font-semibold uppercase tracking-wide text-sky-400/70">
              GitHub {if length(linked_issues(item)) == 1, do: "issue", else: "issues"}
            </p>
            <a
              :for={issue <- linked_issues(item)}
              href={issue.html_url}
              target="_blank"
              rel="noreferrer"
              class="mt-1 block text-xs font-medium leading-4 text-sky-300 hover:text-sky-200"
            >
              #{issue.number}{if issue.title, do: " · #{issue.title}"}
              <span aria-hidden="true">↗</span>
            </a>
          </div>

          <div class="mt-3 flex flex-wrap gap-1.5">
            <.work_status
              state={delivery_state(item)}
              label={delivery_label(item)}
              class="text-[10px]"
            />
            <.work_status
              :if={work_state(item)}
              state={work_state(item)}
              label={work_label(item)}
              class="text-[10px]"
            />
            <span
              :if={!item.managed?}
              class="rounded-full bg-sky-400/10 px-2 py-1 text-[10px] text-sky-300 ring-1 ring-sky-400/20"
            >
              Imported from GitHub
            </span>
            <span
              :if={agent_label(item)}
              class="rounded-full bg-white/5 px-2 py-1 text-[10px] text-slate-400 ring-1 ring-white/10"
            >
              {agent_label(item)}
            </span>
            <span
              :if={health = agent_attention(item, @now)}
              class="inline-flex items-center gap-1 rounded-full bg-amber-400/15 px-2 py-1 text-[10px] font-semibold text-amber-200 ring-1 ring-amber-400/25"
            >
              <.icon name="hero-exclamation-triangle-mini" class="size-3" />
              {health.label}
            </span>
            <span
              :if={follow_up_suggested?(item)}
              id={"follow-ups-suggested-#{card_id(item)}"}
              class="rounded-full bg-violet-400/15 px-2 py-1 text-[10px] font-semibold text-violet-200 ring-1 ring-violet-400/25"
            >
              Follow-ups suggested
            </span>
            <span
              :for={{label, tone} <- health_badges(item)}
              class={["rounded-full px-2 py-1 text-[10px] ring-1", badge_classes(tone)]}
            >
              {label}
            </span>
          </div>

          <aside
            :if={feedback = queue_feedback(item)}
            id={"queue-feedback-#{item.pr_agent_action.id}"}
            aria-live="polite"
            class="mt-3 rounded-xl border border-sky-400/20 bg-sky-400/[0.07] p-3"
          >
            <div class="flex items-start gap-3">
              <span class="mt-0.5 inline-flex size-7 shrink-0 items-center justify-center rounded-full bg-sky-400/15 text-sky-300 ring-1 ring-sky-400/25">
                <.icon name="hero-clock-mini" class="size-4 motion-safe:animate-pulse" />
              </span>
              <div class="min-w-0">
                <p class="text-xs font-semibold text-sky-200">Queued and waiting</p>
                <p class="mt-1 text-[11px] leading-4 text-slate-300">{feedback}</p>
              </div>
            </div>
          </aside>

          <aside
            :if={health = agent_attention(item, @now)}
            id={"agent-attention-#{card_id(item)}"}
            class="mt-3 rounded-xl border border-amber-400/25 bg-amber-400/[0.07] p-3"
          >
            <div class="flex items-start gap-3">
              <span class="mt-0.5 inline-flex size-7 shrink-0 items-center justify-center rounded-full bg-amber-400/15 text-amber-300 ring-1 ring-amber-400/25">
                <.icon name="hero-exclamation-triangle-mini" class="size-4" />
              </span>
              <div class="min-w-0">
                <p class="text-xs font-semibold text-amber-200">
                  {agent_label(item)} · {health.label}
                </p>
                <p class="mt-1 text-[11px] leading-4 text-slate-300">{health.detail}</p>
                <p class="mt-1 text-[11px] leading-4 text-slate-400">
                  Actions queued for this pull request fail until it can run again.
                </p>
              </div>
            </div>
          </aside>

          <aside
            :if={report = stop_report(item)}
            id={"agent-stopped-#{card_id(item)}"}
            class="mt-3 rounded-xl border border-rose-400/25 bg-rose-400/[0.07] p-3"
          >
            <div class="flex items-start gap-3">
              <span class="mt-0.5 inline-flex size-7 shrink-0 items-center justify-center rounded-full bg-rose-400/15 text-rose-300 ring-1 ring-rose-400/25">
                <.icon name="hero-hand-raised-mini" class="size-4" />
              </span>
              <div class="min-w-0">
                <p class="text-xs font-semibold text-rose-200">
                  Work stopped · {stop_reason_label(report["reason_code"])}
                </p>
                <p class="mt-1 text-[11px] leading-4 text-slate-200">{report["summary"]}</p>
                <p class="mt-1 text-[11px] leading-4 text-slate-400">{report["detail"]}</p>
                <p :if={report["prerequisite"]} class="mt-1 text-[11px] leading-4 text-slate-400">
                  Missing: <span class="font-mono">{report["prerequisite"]}</span>
                </p>
                <p class="mt-1 text-[11px] leading-4 text-slate-500">
                  {if report["progress"] == "partial",
                    do: "It had committed something; its worktree is kept on Operations.",
                    else: "It committed nothing, so a fresh attempt loses no work."}
                </p>
              </div>
            </div>
          </aside>

          <p
            :if={!stop_report(item)}
            class="mt-3 border-t border-white/10 pt-3 text-xs leading-5 text-slate-400"
          >
            {next_step(item, lane.key)}
          </p>

          <p
            :if={error = phase_error(item)}
            id={"phase-error-#{card_id(item)}"}
            class="mt-2 text-[11px] leading-4 text-amber-300"
          >
            PtcManager reported <span class="break-words font-mono text-amber-200">{error}</span>
            on its last attempt.
          </p>

          <div class="mt-3 flex flex-wrap gap-3 text-xs">
            <.link
              :if={
                report_job_id =
                  (item.active_job && item.active_job.id) ||
                    (item.publication && item.publication.job_id)
              }
              id={"delivery-report-#{report_job_id}"}
              navigate={"/jobs/#{report_job_id}/report"}
              class="rounded-lg bg-white/10 px-3 py-2 text-teal-200"
            >
              Delivery report
            </.link>
            <.link
              :if={item.active_job && item.active_job.execution_settings}
              id={"job-reviews-#{item.active_job.id}"}
              navigate={"/jobs/#{item.active_job.id}/reviews"}
              class={[
                "inline-flex items-center gap-1.5 rounded-lg px-3 py-2 font-semibold",
                if(item.active_job.review_state in ~w(paused manual),
                  do: "bg-amber-300 text-slate-950 hover:bg-amber-200",
                  else: "bg-white/10 text-teal-200 hover:bg-white/15"
                )
              ]}
            >
              <.icon name="hero-clipboard-document-check-mini" class="size-3.5" />
              {review_action_label(item)}
            </.link>
            <button
              :if={lane.key == :stuck && repair_action(item)}
              id={"repair-pr-#{item.publication.id}"}
              phx-click="run-agent-action"
              phx-value-action-key="repair_pr"
              phx-value-target-id={item.publication.id}
              disabled={active_agent_action?(item.pr_agent_action)}
              title={repair_action(item).description}
              class="inline-flex items-center gap-1.5 rounded-lg bg-violet-400 px-3 py-2 font-semibold text-slate-950 hover:bg-violet-300 disabled:cursor-not-allowed disabled:bg-slate-700 disabled:text-slate-400"
            >
              <.icon name="hero-wrench-screwdriver-mini" class="size-3.5" />
              {repair_action(item).label}
            </button>
            <button
              :if={lane.key == :stuck && repair_and_merge_action(item)}
              id={"repair-and-merge-pr-#{item.publication.id}"}
              phx-click="run-agent-action"
              phx-value-action-key="repair_and_merge_pr"
              phx-value-target-id={item.publication.id}
              disabled={active_agent_action?(item.pr_agent_action)}
              title={repair_and_merge_action(item).description}
              class="inline-flex items-center gap-1.5 rounded-lg bg-teal-400 px-3 py-2 font-semibold text-slate-950 hover:bg-teal-300 disabled:cursor-not-allowed disabled:bg-slate-700 disabled:text-slate-400"
            >
              <.icon name="hero-forward-mini" class="size-3.5" />
              {repair_and_merge_action(item).label}
            </button>
            <button
              :if={
                (lane.key == :ready || follow_up_suggested?(item)) && retrospective_action(item)
              }
              id={"retro-pr-#{item.publication.id}"}
              phx-click="run-agent-action"
              phx-value-action-key="pr_retrospective"
              phx-value-target-id={item.publication.id}
              disabled={active_agent_action?(item.pr_agent_action)}
              title={retrospective_action(item).description}
              class="inline-flex items-center gap-1.5 rounded-lg bg-violet-400 px-3 py-2 font-semibold text-slate-950 hover:bg-violet-300 disabled:cursor-not-allowed disabled:bg-slate-700 disabled:text-slate-400"
            >
              <.icon name="hero-sparkles-mini" class="size-3.5" />
              {retrospective_action(item).label}
            </button>
            <button
              :if={lane.key == :ready && repair_and_merge_action(item)}
              id={"approve-merge-board-#{item.publication.id}"}
              phx-click="run-agent-action"
              phx-value-action-key="repair_and_merge_pr"
              phx-value-target-id={item.publication.id}
              disabled={active_agent_action?(item.pr_agent_action)}
              title="Queue the priority agent that verifies and merges this pull request"
              class="inline-flex items-center gap-1.5 rounded-lg bg-teal-400 px-3 py-2 font-semibold text-slate-950 hover:bg-teal-300 disabled:cursor-not-allowed disabled:bg-slate-700 disabled:text-slate-400"
            >
              <.icon name="hero-check-mini" class="size-3.5" /> Approve and merge
            </button>
            <%= if report = stop_report(item) do %>
              <button
                :if={recovery_offered?(report, :retry)}
                id={"retry-stopped-#{item.active_job.id}"}
                phx-click="retry-stopped-job"
                phx-value-job-id={item.active_job.id}
                title="Queue a fresh attempt with the same approval and review count"
                class={[
                  "inline-flex items-center gap-1.5 rounded-lg px-3 py-2 font-semibold",
                  primary_recovery?(report, :retry) &&
                    "bg-teal-400 text-slate-950 hover:bg-teal-300",
                  !primary_recovery?(report, :retry) &&
                    "border border-white/15 text-slate-300 hover:bg-white/5"
                ]}
              >
                <.icon name="hero-arrow-path-mini" class="size-3.5" /> Try again
              </button>
              <button
                :if={recovery_offered?(report, :ask_on_issue)}
                id={"ask-on-issue-#{item.active_job.id}"}
                phx-click="ask-on-issue"
                phx-value-job-id={item.active_job.id}
                title="Queue an agent to put this blocker on the GitHub issue for a decision"
                class={[
                  "inline-flex items-center gap-1.5 rounded-lg px-3 py-2 font-semibold",
                  primary_recovery?(report, :ask_on_issue) &&
                    "bg-amber-300 text-slate-950 hover:bg-amber-200",
                  !primary_recovery?(report, :ask_on_issue) &&
                    "border border-white/15 text-slate-300 hover:bg-white/5"
                ]}
              >
                <.icon name="hero-chat-bubble-left-right-mini" class="size-3.5" />
                Ask on the issue
              </button>
              <button
                id={"acknowledge-stop-#{item.active_job.id}"}
                phx-click="acknowledge-stop"
                phx-value-job-id={item.active_job.id}
                title="Set this aside; its worktree stays on Operations"
                class="rounded-lg border border-white/15 px-3 py-2 font-semibold text-slate-400 hover:bg-white/5"
              >
                Stop
              </button>
              <span
                :if={recoveries(report) == []}
                class="self-center text-[11px] leading-4 text-rose-200"
              >
                Read the evidence before restarting this by hand.
              </span>
            <% end %>
            <%= if abandonable?(item) do %>
              <%= if confirming_cancel?(@abandon_job_id, item) do %>
                <button
                  id={"confirm-abandon-#{item.active_job.id}"}
                  phx-click="abandon-job"
                  phx-value-job-id={item.active_job.id}
                  class="inline-flex items-center gap-1.5 rounded-lg bg-rose-400 px-3 py-2 font-semibold text-slate-950 hover:bg-rose-300"
                >
                  <.icon name="hero-exclamation-triangle-mini" class="size-3.5" /> Confirm abandon
                </button>
                <button
                  id={"dismiss-abandon-#{item.active_job.id}"}
                  phx-click="dismiss-abandon"
                  class="rounded-lg border border-white/15 px-3 py-2 font-semibold text-slate-300 hover:bg-white/5"
                >
                  Keep it
                </button>
              <% else %>
                <button
                  id={"abandon-job-#{item.active_job.id}"}
                  phx-click="confirm-abandon"
                  phx-value-job-id={item.active_job.id}
                  title="End this job and keep its worktree. Use it when the check can never pass."
                  class="inline-flex items-center gap-1.5 rounded-lg border border-rose-400/25 px-3 py-2 font-semibold text-rose-300 hover:bg-rose-400/10"
                >
                  <.icon name="hero-x-circle-mini" class="size-3.5" /> Abandon
                </button>
              <% end %>
            <% end %>
            <%= if lane.key in [:working, :stuck] && cancellable_agent?(item) do %>
              <%= if confirming_cancel?(@cancel_agent_job_id, item) do %>
                <button
                  id={"confirm-cancel-agent-#{item.active_job.id}"}
                  phx-click="cancel-agent"
                  phx-value-job-id={item.active_job.id}
                  class="inline-flex items-center gap-1.5 rounded-lg bg-rose-400 px-3 py-2 font-semibold text-slate-950 hover:bg-rose-300"
                >
                  <.icon name="hero-exclamation-triangle-mini" class="size-3.5" /> Confirm cancel
                </button>
                <button
                  id={"dismiss-cancel-agent-#{item.active_job.id}"}
                  phx-click="dismiss-cancel-agent"
                  class="rounded-lg border border-white/15 px-3 py-2 font-semibold text-slate-300 hover:bg-white/5"
                >
                  Keep running
                </button>
              <% else %>
                <button
                  id={"cancel-agent-#{item.active_job.id}"}
                  phx-click="confirm-cancel-agent"
                  phx-value-job-id={item.active_job.id}
                  title="End this agent and keep its partial worktree for inspection"
                  class="inline-flex items-center gap-1.5 rounded-lg border border-rose-400/25 px-3 py-2 font-semibold text-rose-300 hover:bg-rose-400/10"
                >
                  <.icon name="hero-x-circle-mini" class="size-3.5" /> Cancel agent
                </button>
              <% end %>
            <% end %>
            <a
              :if={item.publication && item.publication.pr_url}
              href={item.publication.pr_url}
              target="_blank"
              rel="noreferrer"
              class="font-semibold text-teal-300 hover:text-teal-200"
            >
              Open PR #{item.publication.pr_number} ↗
            </a>
            <a
              :if={item.issue}
              href={item.issue.html_url}
              target="_blank"
              rel="noreferrer"
              class="text-slate-500 hover:text-white"
            >
              Issue ↗
            </a>
          </div>

          <.retrospective
            :if={item.publication}
            id={"retro-results-#{item.publication.id}"}
            action={item.pr_retrospective_action}
            creation_actions={item.pr_retrospective_issue_actions}
            repository={item.repository}
          />
        </article>

        <div
          :if={lane_items(@lanes, lane.key) == []}
          class="grid min-h-28 place-items-center rounded-xl border border-dashed border-white/[0.07] p-4 text-center text-xs leading-5 text-slate-600"
        >
          No work here
        </div>
      </div>
    </section>
  </div>
</Layouts.app>
