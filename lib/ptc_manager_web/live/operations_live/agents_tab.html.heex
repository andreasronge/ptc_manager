<section class="grid gap-8 xl:grid-cols-[minmax(0,1.5fr)_minmax(280px,0.65fr)]">
  <div>
    <div
      id="timeline-filters"
      class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"
    >
      <nav aria-label="Run state" class="flex flex-wrap gap-1 text-xs">
        <.link
          :for={{key, label} <- timeline_filters()}
          patch={filter_path(key, @include_maintenance?)}
          data-filter={key}
          aria-current={if key == @timeline_filter, do: "true"}
          class={[
            "rounded-full px-3 py-1.5 font-medium ring-1 transition",
            key == @timeline_filter && "bg-white/10 text-white ring-white/20",
            key != @timeline_filter && "text-slate-400 ring-white/10 hover:text-white"
          ]}
        >
          {label}
        </.link>
      </nav>
      <.link
        id="toggle-maintenance-runs"
        patch={filter_path(@timeline_filter, !@include_maintenance?)}
        class="inline-flex items-center gap-2 text-xs text-slate-400 hover:text-white"
      >
        <span class={[
          "flex h-4 w-7 items-center rounded-full p-0.5 transition",
          @include_maintenance? && "bg-teal-400/70",
          !@include_maintenance? && "bg-white/15"
        ]}>
          <span class={[
            "size-3 rounded-full bg-white transition",
            @include_maintenance? && "translate-x-3"
          ]}>
          </span>
        </span>
        Include maintenance runs
      </.link>
    </div>

    <div class="mb-4 flex items-end justify-between gap-4">
      <p class="text-xs text-slate-500">Newest start first · latest {length(@timeline)} runs</p>
      <span class="text-xs text-slate-600">
        Updated {Calendar.strftime(@metrics.captured_at, "%H:%M:%S")}
      </span>
    </div>

    <div id="agent-timeline" class="space-y-2">
      <section :for={{day, runs} <- @timeline_groups} aria-label={day}>
        <h3 class="sticky top-16 z-10 -mx-1 mb-2 bg-slate-950/90 px-1 py-2 text-xs font-semibold uppercase tracking-wide text-slate-500 backdrop-blur">
          {day}
        </h3>
        <div class="relative before:absolute before:bottom-6 before:left-[1.15rem] before:top-6 before:w-px before:bg-white/10">
          <article
            :for={run <- runs}
            id={"timeline-run-#{run.id}"}
            class="relative grid grid-cols-[2.3rem_minmax(0,1fr)] gap-3 pb-4"
          >
            <div class={[
              "relative z-10 mt-5 size-3.5 place-self-center rounded-full ring-4 ring-slate-950",
              marker_classes(run.state)
            ]}>
            </div>
            <.run_card run={run} now={@now} path={agent_path(assigns, run)} />
          </article>
        </div>
      </section>
      <div
        :if={@timeline == []}
        class="rounded-2xl border border-dashed border-white/10 p-10 text-center text-sm text-slate-500"
      >
        No agent runs match this filter.
      </div>
    </div>
  </div>

  <aside>
    <div class="space-y-3 xl:sticky xl:top-24">
      <section :if={@attention_runs != []} id="agents-needing-attention">
        <div class="mb-3 flex items-center justify-between">
          <h2 class="text-xs font-semibold uppercase tracking-wide text-amber-300">
            Needs a person
          </h2>
          <span class="text-xs text-amber-300/70">{length(@attention_runs)}</span>
        </div>
        <div class="space-y-2">
          <.link
            :for={run <- @attention_runs}
            patch={agent_path(assigns, run)}
            id={"attention-run-#{run.id}"}
            class="block rounded-xl border border-amber-400/25 bg-amber-400/[0.07] px-4 py-3 hover:border-amber-400/40"
          >
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <p class="truncate text-sm font-medium text-amber-100">{run_name(run)}</p>
                <p class="mt-1 text-xs font-semibold text-amber-200">
                  {agent_health(run, @now).label}
                </p>
                <p class="mt-1 text-xs leading-5 text-slate-300">
                  {agent_health(run, @now).detail}
                </p>
                <p class="mt-1 truncate text-xs text-slate-500">{run_task(run)}</p>
              </div>
              <span class="shrink-0 text-xs text-amber-300">View →</span>
            </div>
          </.link>
        </div>
      </section>

      <section id="retained-agents">
        <div class="mb-3 flex items-center justify-between">
          <h2 class="text-xs font-semibold uppercase tracking-wide text-slate-500">
            Retained / waiting
          </h2>
          <span class="text-xs text-slate-600">{length(@waiting_runs)}</span>
        </div>
        <p
          :if={@waiting_runs == []}
          class="rounded-xl border border-dashed border-white/10 px-4 py-5 text-xs text-slate-500"
        >
          No retained sessions. A finished repair turn stays here while its PR is open.
        </p>
        <div class="space-y-2">
          <.link
            :for={run <- @waiting_runs}
            patch={agent_path(assigns, run)}
            id={"waiting-run-#{run.id}"}
            class="block rounded-xl border border-violet-400/15 bg-violet-400/[0.05] px-4 py-3 hover:border-violet-400/30"
          >
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <p class="truncate text-sm font-medium text-violet-200">{run_name(run)}</p>
                <p class="mt-1 line-clamp-2 text-xs leading-5 text-slate-400">
                  {run_task(run)}
                </p>
              </div>
              <span class="shrink-0 text-xs text-violet-300">View →</span>
            </div>
          </.link>
        </div>
      </section>

      <section class="rounded-2xl border border-white/10 bg-slate-900/60 p-4 text-xs text-slate-400">
        <p class="font-semibold text-slate-200">Reading the timeline</p>
        <p class="mt-2 leading-5">
          Each card is one Herdr agent session. Implementation runs carry the issue they work on; automation runs carry the maintainer action that started them.
        </p>
        <p class="mt-2 leading-5">
          Maintenance runs such as deployment canaries are hidden unless you switch them on.
        </p>
      </section>
    </div>
  </aside>
</section>
