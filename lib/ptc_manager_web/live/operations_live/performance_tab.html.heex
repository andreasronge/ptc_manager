<section id="resource-operations" class="rounded-2xl border border-white/10 bg-slate-900/60 p-5">
  <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h2 class="text-lg font-semibold">Expensive operations</h2>
      <p class="mt-1 text-xs text-slate-500">
        Managed build, test, lint, and verification commands. Direct commands on a Mac or in CI are unaffected.
      </p>
    </div>
    <span class="text-xs text-slate-500">
      {@resource_statistics.count} completed in 7 days · {percent(
        @resource_statistics.utilization * 100
      )} utilized
    </span>
  </div>

  <div class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
    <article id="operation-stat-count" class="rounded-xl bg-black/20 p-4">
      <p class="text-xs uppercase tracking-wide text-slate-500">Runs</p>
      <p class="mt-1 text-xl font-semibold">{@resource_statistics.count}</p>
      <p class="mt-1 text-xs text-slate-500">
        {operation_rate(@resource_statistics.success_rate)} successful
      </p>
    </article>
    <article id="operation-stat-average" class="rounded-xl bg-black/20 p-4">
      <p class="text-xs uppercase tracking-wide text-slate-500">Average</p>
      <p class="mt-1 text-xl font-semibold">
        {operation_duration(@resource_statistics.average_duration_ms)}
      </p>
      <p class="mt-1 text-xs text-slate-500">
        Total {operation_duration(@resource_statistics.total_duration_ms)}
      </p>
    </article>
    <article id="operation-stat-p80" class="rounded-xl bg-black/20 p-4">
      <p class="text-xs uppercase tracking-wide text-slate-500">Typical spread</p>
      <p class="mt-1 text-xl font-semibold">
        {operation_duration(@resource_statistics.p20_duration_ms)}–{operation_duration(
          @resource_statistics.p80_duration_ms
        )}
      </p>
      <p class="mt-1 text-xs text-slate-500">
        p20–p80 · queue p80 {operation_duration(@resource_statistics.p80_wait_ms)}
      </p>
    </article>
    <article id="operation-stat-memory" class="rounded-xl bg-black/20 p-4">
      <p class="text-xs uppercase tracking-wide text-slate-500">Peak memory</p>
      <p class="mt-1 text-xl font-semibold">
        {operation_bytes(@resource_statistics.max_peak_memory_bytes)}
      </p>
      <p class="mt-1 text-xs text-slate-500">
        p80 {operation_bytes(@resource_statistics.p80_peak_memory_bytes)}
      </p>
    </article>
  </div>

  <div
    id="recent-resource-operations"
    class="mt-4 rounded-xl border border-white/10 bg-black/20 p-4"
  >
    <p class="text-sm font-semibold text-slate-200">
      Recent operations ({length(@recent_resource_operations)})
    </p>
    <p
      :if={@recent_resource_operations == []}
      class="mt-3 text-xs text-slate-500"
    >
      No managed expensive operation has finished yet.
    </p>
    <div :if={@recent_resource_operations != []} class="mt-3 divide-y divide-white/10">
      <div
        :for={operation <- @recent_resource_operations}
        id={"recent-resource-operation-#{operation.id}"}
        class="grid gap-1 py-3 text-xs sm:grid-cols-[minmax(0,1fr)_auto_auto_auto] sm:items-center sm:gap-4"
      >
        <p class="truncate text-slate-300">
          <span class="font-semibold text-slate-100">{operation.label}</span>
          · {operation.repository.github_owner}/{operation.repository.github_name}
        </p>
        <p class="text-slate-500">
          {operation.state} · {operation_duration(operation.run_duration_ms)}
        </p>
        <p class="text-slate-500">peak {operation_bytes(operation.peak_memory_bytes)}</p>
        <p :if={operation.finished_at} class="text-slate-600">
          {timestamp(operation.finished_at)}
        </p>
      </div>
    </div>
  </div>
</section>

<section
  id="workspace-setup-history"
  class="mt-8 rounded-2xl border border-white/10 bg-slate-900/60 p-5"
>
  <div class="flex items-end justify-between gap-4">
    <div>
      <h2 class="text-lg font-semibold">Workspace preparation</h2>
      <p class="mt-1 text-xs text-slate-500">
        Herdr creates each worktree; the repository then prepares it before an agent starts.
      </p>
    </div>
    <span class="text-xs text-slate-600">Latest {length(@workspace_setups)}</span>
  </div>
  <p
    :if={@workspace_setups == []}
    class="mt-4 rounded-xl bg-black/20 px-4 py-5 text-sm text-slate-500"
  >
    No workspace has been prepared yet.
  </p>
  <div :if={@workspace_setups != []} class="mt-4 grid gap-3 lg:grid-cols-2">
    <article
      :for={allocation <- @workspace_setups}
      id={"workspace-setup-#{allocation.id}"}
      class="rounded-xl border border-white/10 bg-black/20 p-4"
    >
      <div class="flex items-start justify-between gap-3">
        <div>
          <p class="text-sm font-semibold text-slate-100">
            {allocation.job.repository.github_name} ##{allocation.job.issue.number}
          </p>
          <p class="mt-1 break-all font-mono text-[11px] text-slate-500">
            {allocation.workspace_setup_script || "Setup script unavailable"}
          </p>
        </div>
        <span class={[
          "rounded-full px-2.5 py-1 text-[10px] font-semibold ring-1",
          allocation.workspace_setup_state == "passed" &&
            "bg-teal-400/15 text-teal-300 ring-teal-400/20",
          allocation.workspace_setup_state == "failed" &&
            "bg-rose-400/15 text-rose-300 ring-rose-400/20"
        ]}>
          {allocation.workspace_setup_state}
        </span>
      </div>
      <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-slate-400">
        <span>Worktree {worktree_creation_duration(allocation)}</span>
        <span>Setup {workspace_setup_duration(allocation)}</span>
        <span :if={allocation.workspace_setup_exit_status != nil}>
          Exit {allocation.workspace_setup_exit_status}
        </span>
        <span
          :if={workspace_cache_label(allocation)}
          class={[
            "rounded-full px-2 py-0.5 font-medium",
            allocation.workspace_setup_cache_state == "hit" &&
              "bg-teal-400/10 text-teal-300",
            allocation.workspace_setup_cache_state == "miss" &&
              "bg-amber-400/10 text-amber-300",
            allocation.workspace_setup_cache_state == "disabled" &&
              "bg-slate-400/10 text-slate-400"
          ]}
        >
          {workspace_cache_label(allocation)}
        </span>
      </div>
      <div
        :if={workspace_setup_phases(allocation) != []}
        class="mt-3 flex flex-wrap gap-2 text-[11px] text-slate-400"
      >
        <span
          :for={{label, timing} <- workspace_setup_phases(allocation)}
          class="rounded-md border border-white/10 bg-white/[0.03] px-2 py-1"
        >
          {label} {timing}
        </span>
      </div>
      <p
        :if={allocation.last_error}
        class="mt-3 rounded-lg bg-rose-400/[0.07] px-3 py-2 text-xs text-rose-200"
      >
        {allocation.last_error}
      </p>
      <details
        :if={allocation.workspace_setup_output not in [nil, ""]}
        id={"workspace-setup-output-#{allocation.id}"}
        phx-update="ignore"
        class="mt-3"
      >
        <summary class="cursor-pointer text-xs font-medium text-sky-300">Setup output</summary>
        <pre class="mt-2 max-h-48 overflow-auto whitespace-pre-wrap break-words rounded-lg bg-black/30 p-3 font-mono text-[11px] leading-5 text-slate-400">{allocation.workspace_setup_output}</pre>
      </details>
    </article>
  </div>
</section>
