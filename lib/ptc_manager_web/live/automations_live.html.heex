<Layouts.app
  flash={@flash}
  current_path="/automations"
  repositories={@repositories}
  selected_repository={@selected_repository}
>
  <section class="mb-8">
    <p class="text-xs font-semibold uppercase tracking-[0.24em] text-teal-300">Control room</p>
    <%= case @live_action do %>
      <% :index -> %>
        <div class="mt-3 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Automations</h1>
            <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-400">
              Which automations exist, when each one runs, and whether the last run worked. Open one to change its schedule, agent, or prompt.
            </p>
          </div>
          <.link
            id="new-automation-link"
            navigate={page_path(:new, repo: @repo_param)}
            class="inline-flex w-fit items-center gap-2 rounded-xl bg-teal-400 px-4 py-2 text-sm font-semibold text-slate-950 hover:bg-teal-300"
          >
            <.icon name="hero-plus-mini" class="size-4" /> New automation
          </.link>
        </div>
      <% :new -> %>
        <.link
          navigate={page_path(:index, repo: @repo_param)}
          class="mt-3 inline-flex items-center gap-1 text-sm text-slate-400 hover:text-white"
        >
          <.icon name="hero-arrow-left-mini" class="size-4" /> All automations
        </.link>
        <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">New automation</h1>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-400">
          A repository automation runs a generic agent in a read-only snapshot and returns a private report. It is created paused with a paused "Run now" trigger.
        </p>
      <% :show -> %>
        <.link
          navigate={page_path(:index, repo: @repo_param)}
          class="mt-3 inline-flex items-center gap-1 text-sm text-slate-400 hover:text-white"
        >
          <.icon name="hero-arrow-left-mini" class="size-4" /> All automations
        </.link>
    <% end %>
  </section>

  <%= case @live_action do %>
    <% :new -> %>
      {create(assigns)}
    <% :show -> %>
      {detail(assigns)}
    <% _index -> %>
      {index(assigns)}
  <% end %>
</Layouts.app>
