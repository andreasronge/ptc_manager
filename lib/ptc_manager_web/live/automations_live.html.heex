<Layouts.app
  flash={@flash}
  current_path="/automations"
  repositories={@repositories}
  selected_repository={@selected_repository}
>
  <div class="space-y-8">
    <section>
      <p class="text-xs font-semibold uppercase tracking-[0.24em] text-teal-300">Control room</p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">Automations</h1>
      <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-400">
        Each action is repository-specific, versioned, and routed through the same durable queue. Editing a definition never changes work already queued or running.
      </p>
    </section>

    <section id="agent-profiles" class="rounded-2xl border border-white/10 bg-slate-900/60 p-5">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <h2 class="text-lg font-semibold">Agent profile health</h2>
          <p class="mt-1 text-xs text-slate-500">
            Herdr kinds are selectors, not hard-coded executors.
          </p>
        </div>
        <span class="rounded-full bg-teal-400/15 px-3 py-1 text-xs text-teal-200">
          Any capable agent may run
        </span>
      </div>
      <div class="mt-4 grid gap-3 md:grid-cols-2">
        <article
          :for={worker <- @workers}
          class="rounded-xl border border-white/10 bg-black/20 p-4"
        >
          <div class="flex items-center justify-between gap-3">
            <p class="font-medium">{worker.name}</p>
            <span class={
              if(worker.status == "online", do: "text-teal-300", else: "text-amber-300")
            }>
              {worker.status}
            </span>
          </div>
          <p class="mt-2 break-words font-mono text-xs text-slate-500">
            {inspect(worker.capabilities)}
          </p>
        </article>
        <p :if={@workers == []} class="text-sm text-slate-500">
          No worker has reported health yet.
        </p>
      </div>
    </section>

    <section id="automation-definitions" class="space-y-4">
      <div class="flex items-end justify-between gap-4">
        <div>
          <h2 class="text-xl font-semibold">Configured actions</h2>
          <p class="mt-1 text-xs text-slate-500">
            {length(@definitions)} visible for this repository filter
          </p>
        </div>
      </div>

      <article
        :for={definition <- @definitions}
        id={"automation-#{definition.id}"}
        class="rounded-2xl border border-white/10 bg-slate-900/70 p-5"
      >
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="text-lg font-semibold">{definition.name}</h3>
              <span class={[
                "rounded-full px-2 py-0.5 text-[11px] font-semibold",
                if(definition.enabled,
                  do: "bg-teal-400/15 text-teal-200",
                  else: "bg-white/5 text-slate-500"
                )
              ]}>
                {if(definition.enabled, do: "Enabled", else: "Paused")}
              </span>
              <span class="rounded-full bg-white/5 px-2 py-0.5 font-mono text-[10px] text-slate-400">
                v{definition.current_version.version}
              </span>
            </div>
            <p class="mt-1 text-xs text-teal-300">{repository_key(definition.repository)}</p>
            <p class="mt-2 text-sm leading-6 text-slate-400">{definition.description}</p>
          </div>
          <button
            phx-click="toggle-definition"
            phx-value-id={definition.id}
            phx-value-enabled={to_string(!definition.enabled)}
            class="shrink-0 rounded-xl border border-white/10 px-3 py-2 text-xs font-semibold text-slate-300 hover:border-white/20"
          >
            {if(definition.enabled, do: "Pause", else: "Enable")}
          </button>
        </div>

        <div class="mt-4 grid gap-2 text-xs sm:grid-cols-2 lg:grid-cols-5">
          <span class="rounded-lg bg-black/20 px-3 py-2">
            {definition.current_version.execution_profile}
          </span>
          <span class="rounded-lg bg-black/20 px-3 py-2">
            {definition.current_version.queue_lane} / {definition.current_version.resource_class}
          </span>
          <span class="rounded-lg bg-black/20 px-3 py-2">
            GitHub: {definition.current_version.github_access}
          </span>
          <span class="rounded-lg bg-black/20 px-3 py-2">
            {definition.current_version.timeout_seconds}s timeout
          </span>
          <span class="rounded-lg bg-black/20 px-3 py-2">
            Agent: {definition.current_version.agent_selector["preferred_kind"] || "any"}
          </span>
        </div>

        <div class="mt-4 flex flex-wrap gap-3">
          <div
            :for={trigger <- definition.triggers}
            class="flex items-center gap-2 rounded-xl border border-white/10 bg-black/20 p-2"
          >
            <button
              :if={trigger.trigger_type == "manual"}
              phx-click="run"
              phx-value-trigger-id={trigger.id}
              disabled={!definition.enabled || !trigger.enabled}
              class="rounded-lg bg-teal-400 px-3 py-1.5 text-xs font-semibold text-slate-950 disabled:cursor-not-allowed disabled:opacity-30"
            >
              {trigger.label}
            </button>
            <details :if={trigger.trigger_type == "schedule"} class="px-1 text-xs text-slate-300">
              <summary class="cursor-pointer">
                {trigger.label} · next {timestamp(trigger.next_run_at)}
              </summary>
              <.form
                for={%{}}
                as={:schedule}
                phx-submit="save-schedule"
                class="mt-3 grid gap-2 sm:grid-cols-2"
              >
                <input type="hidden" name="schedule_id" value={trigger.id} />
                <input type="hidden" name="schedule[enabled]" value={to_string(trigger.enabled)} />
                <input
                  name="schedule[label]"
                  value={trigger.label}
                  aria-label="Schedule label"
                  class="rounded-lg border border-white/10 bg-slate-950 p-2"
                />
                <input
                  name="schedule[cron_expression]"
                  value={trigger.cron_expression}
                  aria-label="Cron expression"
                  class="rounded-lg border border-white/10 bg-slate-950 p-2 font-mono"
                />
                <input
                  name="schedule[time_zone]"
                  value={trigger.time_zone}
                  aria-label="Time zone"
                  class="rounded-lg border border-white/10 bg-slate-950 p-2"
                />
                <button class="w-fit rounded-lg bg-white/10 px-3 py-2 font-semibold text-white">
                  Save schedule
                </button>
              </.form>
            </details>
            <details
              :if={trigger.trigger_type == "contextual"}
              class="px-1 text-xs text-slate-300"
            >
              <summary class="cursor-pointer">Button: {trigger.label}</summary>
              <.form for={%{}} as={:trigger} phx-submit="save-trigger" class="mt-3 grid gap-2">
                <input type="hidden" name="trigger_id" value={trigger.id} />
                <input type="hidden" name="trigger[enabled]" value={to_string(trigger.enabled)} />
                <input
                  name="trigger[label]"
                  value={trigger.label}
                  aria-label="Button label"
                  class="rounded-lg border border-white/10 bg-slate-950 p-2"
                />
                <select
                  name="trigger[surface]"
                  aria-label="Button surface"
                  class="rounded-lg border border-white/10 bg-slate-950 p-2"
                >
                  <option value="planning_issue" selected={trigger.surface == "planning_issue"}>
                    Planning issue
                  </option>
                  <option value="delivery_pr" selected={trigger.surface == "delivery_pr"}>
                    Delivery PR
                  </option>
                </select>
                <button class="w-fit rounded-lg bg-white/10 px-3 py-2 font-semibold text-white">
                  Save button
                </button>
              </.form>
            </details>
            <button
              phx-click="toggle-trigger"
              phx-value-id={trigger.id}
              phx-value-enabled={to_string(!trigger.enabled)}
              class="px-2 text-[11px] text-slate-500 hover:text-white"
            >
              {if(trigger.enabled, do: "Pause", else: "Enable")}
            </button>
          </div>
        </div>
        <button
          :if={
            definition.current_version.target_type == "repository" &&
              !Enum.any?(definition.triggers, &(&1.trigger_type == "schedule"))
          }
          phx-click="add-schedule"
          phx-value-definition-id={definition.id}
          class="mt-3 rounded-lg border border-white/10 px-3 py-1.5 text-xs text-slate-400 hover:text-white"
        >
          Add paused schedule
        </button>

        <details
          id={"automation-editor-#{definition.id}"}
          open={MapSet.member?(@expanded_definition_ids, definition.id)}
          class="mt-5 rounded-xl border border-white/10 bg-black/20 p-4"
        >
          <summary
            phx-click="toggle-definition-editor"
            phx-value-id={definition.id}
            class="cursor-pointer text-sm font-semibold text-slate-200"
          >
            Edit complete prompt and execution settings
          </summary>
          <.form
            for={%{}}
            as={:automation}
            phx-submit="save-definition"
            class="mt-5 grid gap-4 lg:grid-cols-2"
          >
            <input type="hidden" name="definition_id" value={definition.id} />
            <label class="text-xs text-slate-400">
              Name<input
                name="automation[name]"
                value={definition.name}
                class="mt-1 w-full rounded-lg border border-white/10 bg-slate-950 p-2 text-sm text-white"
              />
            </label>
            <label class="text-xs text-slate-400">
              Description<input
                name="automation[description]"
                value={definition.description}
                class="mt-1 w-full rounded-lg border border-white/10 bg-slate-950 p-2 text-sm text-white"
              />
            </label>
            <input type="hidden" name="automation[enabled]" value={to_string(definition.enabled)} />
            <label class="text-xs text-slate-400">
              Execution profile<select
                name="automation[execution_profile]"
                class="mt-1 w-full rounded-lg border border-white/10 bg-slate-950 p-2 text-sm"
              ><option
                  :for={
                    value <-
                      ~w(generic_ephemeral retained_pr_repair implementation_job private_daily_update)
                  }
                  value={value}
                  selected={definition.current_version.execution_profile == value}
                >{value}</option></select>
            </label>
            <label class="text-xs text-slate-400">
              Agent selection<select
                name="automation[agent_mode]"
                class="mt-1 w-full rounded-lg border border-white/10 bg-slate-950 p-2 text-sm"
              ><option
                  value="any"
                  selected={definition.current_version.agent_selector["mode"] == "any"}
                >Any capable</option><option
                  value="prefer"
                  selected={definition.current_version.agent_selector["mode"] == "prefer"}
                >Prefer kind, allow fallback</option><option
                  value="require"
                  selected={definition.current_version.agent_selector["mode"] == "require"}
                >Require exact kind</option></select>
            </label>
            <label class="text-xs text-slate-400">
              Preferred Herdr kind<input
                name="automation[agent_kind]"
                value={definition.current_version.agent_selector["preferred_kind"]}
                placeholder="codex, claude, cursor…"
                class="mt-1 w-full rounded-lg border border-white/10 bg-slate-950 p-2 text-sm"
              />
            </label>
            <label class="text-xs text-slate-400">
              GitHub access<select
                name="automation[github_access]"
                class="mt-1 w-full rounded-lg border border-white/10 bg-slate-950 p-2 text-sm"
              ><option
                  :for={value <- ~w(none read trusted_direct brokered_publish)}
                  value={value}
                  selected={definition.current_version.github_access == value}
                >{value}</option></select>
            </label>
            <label class="text-xs text-slate-400">
              Queue lane<select
                name="automation[queue_lane]"
                class="mt-1 w-full rounded-lg border border-white/10 bg-slate-950 p-2 text-sm"
              ><option
                  :for={value <- ~w(planning writing)}
                  value={value}
                  selected={definition.current_version.queue_lane == value}
                >{value}</option></select>
            </label>
            <label class="text-xs text-slate-400">
              Resource class<select
                name="automation[resource_class]"
                class="mt-1 w-full rounded-lg border border-white/10 bg-slate-950 p-2 text-sm"
              ><option
                  :for={value <- ~w(light heavy)}
                  value={value}
                  selected={definition.current_version.resource_class == value}
                >{value}</option></select>
            </label>
            <label class="text-xs text-slate-400">
              Timeout seconds<input
                type="number"
                min="1"
                max="86400"
                name="automation[timeout_seconds]"
                value={definition.current_version.timeout_seconds}
                class="mt-1 w-full rounded-lg border border-white/10 bg-slate-950 p-2 text-sm"
              />
            </label>
            <label class="text-xs text-slate-400 lg:col-span-2">
              Prompt<textarea
                name="automation[prompt]"
                rows="6"
                class="mt-1 w-full rounded-lg border border-white/10 bg-slate-950 p-3 font-mono text-xs leading-5"
              >{definition.current_version.prompt}</textarea>
              <span class="mt-1 block leading-5 text-slate-500">
                This is the complete user-owned instruction, including any safety rules you want. PtcManager only adds target facts and its machine result protocol.
              </span>
            </label>
            <div class="flex flex-wrap gap-3 lg:col-span-2">
              <button class="w-fit rounded-xl bg-teal-400 px-4 py-2 text-sm font-semibold text-slate-950">
                Save new version
              </button>
              <button
                type="button"
                phx-click="show-prompt-preview"
                phx-value-id={definition.id}
                class="w-fit rounded-xl border border-teal-400/25 bg-teal-400/[0.06] px-4 py-2 text-sm font-semibold text-teal-200 hover:border-teal-400/40"
              >
                Preview composed prompt
              </button>
              <button
                type="button"
                phx-click="restore-suggested-prompt"
                phx-value-id={definition.id}
                class="w-fit rounded-xl border border-white/10 px-4 py-2 text-sm font-semibold text-slate-300 hover:border-white/20 hover:text-white"
              >
                Restore PtcManager suggestion
              </button>
            </div>
          </.form>
          <div class="mt-5 border-t border-white/10 pt-4 text-xs text-slate-500">
            Version history: {definition.versions
            |> Enum.sort_by(& &1.version, :desc)
            |> Enum.map_join(" · ", &"v#{&1.version} by #{&1.created_by}")}
          </div>
        </details>

        <details :if={length(@repositories) > 1} class="mt-3 text-xs text-slate-500">
          <summary class="cursor-pointer">Copy to another repository</summary>
          <div class="mt-2 flex flex-wrap gap-2">
            <button
              :for={repository <- @repositories}
              :if={repository.id != definition.repository_id}
              phx-click="duplicate"
              phx-value-id={definition.id}
              phx-value-repository-id={repository.id}
              class="rounded-lg border border-white/10 px-3 py-1.5 hover:text-white"
            >
              {repository_key(repository)}
            </button>
          </div>
        </details>
      </article>
    </section>

    <details
      id="new-automation"
      class="rounded-2xl border border-dashed border-teal-400/30 bg-teal-400/[0.04] p-5"
    >
      <summary class="cursor-pointer text-lg font-semibold text-teal-200">
        Create repository automation
      </summary>
      <p class="mt-2 text-sm text-slate-400">
        Creates a disabled, manually triggered generic Herdr action. Review and enable it afterward.
      </p>
      <.form for={%{}} as={:automation} phx-submit="create" class="mt-5 grid gap-4 lg:grid-cols-2">
        <label class="text-xs text-slate-400">
          Repository<select
            name="automation[repository_id]"
            class="mt-1 w-full rounded-lg border border-white/10 bg-slate-950 p-2 text-sm"
          ><option :for={repository <- @repositories} value={repository.id}>{repository_key(repository)}</option></select>
        </label>
        <label class="text-xs text-slate-400">
          Key<input
            required
            pattern="[a-z][a-z0-9_]*"
            name="automation[key]"
            placeholder="check_nightly_ci"
            class="mt-1 w-full rounded-lg border border-white/10 bg-slate-950 p-2 text-sm"
          />
        </label>
        <label class="text-xs text-slate-400">
          Name<input
            required
            name="automation[name]"
            class="mt-1 w-full rounded-lg border border-white/10 bg-slate-950 p-2 text-sm"
          />
        </label>
        <label class="text-xs text-slate-400">
          Description<input
            required
            name="automation[description]"
            class="mt-1 w-full rounded-lg border border-white/10 bg-slate-950 p-2 text-sm"
          />
        </label>
        <input type="hidden" name="automation[queue_lane]" value="planning" /><input
          type="hidden"
          name="automation[resource_class]"
          value="light"
        /><input type="hidden" name="automation[timeout_seconds]" value="1800" />
        <label class="text-xs text-slate-400">
          GitHub access<select
            name="automation[github_access]"
            class="mt-1 w-full rounded-lg border border-white/10 bg-slate-950 p-2 text-sm"
          ><option value="read">Read</option><option value="trusted_direct">Full gh CLI</option><option value="none">None</option></select>
        </label>
        <label class="text-xs text-slate-400">
          Preferred Herdr kind<input
            name="automation[agent_kind]"
            placeholder="blank means any"
            class="mt-1 w-full rounded-lg border border-white/10 bg-slate-950 p-2 text-sm"
          />
        </label>
        <label class="text-xs text-slate-400 lg:col-span-2">
          Prompt<textarea
            required
            name="automation[prompt]"
            rows="7"
            class="mt-1 w-full rounded-lg border border-white/10 bg-slate-950 p-3 font-mono text-xs"
          ></textarea>
        </label>
        <button class="w-fit rounded-xl bg-teal-400 px-4 py-2 text-sm font-semibold text-slate-950">
          Create disabled automation
        </button>
      </.form>
    </details>

    <section id="automation-history">
      <h2 class="text-xl font-semibold">Run history</h2>
      <div class="mt-4 space-y-3">
        <article
          :for={invocation <- @invocations}
          id={"invocation-#{invocation.id}"}
          class="rounded-xl border border-white/10 bg-slate-900/60 p-4"
        >
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <p class="font-medium">
                {invocation.automation_definition_version.automation_definition.name}
              </p>
              <p class="mt-1 text-xs text-slate-500">
                {repository_key(invocation.repository)} · v{invocation.automation_definition_version.version} · {invocation.trigger_type}
              </p>
            </div>
            <span class={["rounded-full px-2.5 py-1 text-xs", state_classes(invocation.state)]}>
              {invocation.state}
            </span>
          </div>
          <p :if={invocation.source_sha} class="mt-2 font-mono text-xs text-slate-500">
            Source {String.slice(invocation.source_sha, 0, 12)}
          </p>
          <p :if={invocation.result_markdown} class="mt-3 text-sm leading-6 text-slate-300">
            {invocation.result_markdown}
          </p>
          <p :if={invocation.last_error} class="mt-3 text-xs text-rose-300">
            {invocation.last_error}
          </p>
        </article>
        <p :if={@invocations == []} class="text-sm text-slate-500">No automation runs yet.</p>
      </div>
    </section>

    <div
      :if={@preview_definition_id}
      id="automation-prompt-preview-overlay"
      class="fixed inset-0 z-50 flex items-end justify-center bg-slate-950/80 p-0 backdrop-blur-sm sm:items-center sm:p-6"
      phx-window-keydown="close-prompt-preview"
      phx-key="escape"
    >
      <%= if definition = selected_definition(@definitions, @preview_definition_id) do %>
        <section
          id="automation-prompt-preview"
          role="dialog"
          aria-modal="true"
          aria-labelledby="automation-prompt-preview-title"
          phx-click-away="close-prompt-preview"
          class="flex max-h-[92vh] w-full max-w-5xl flex-col overflow-hidden rounded-t-3xl border border-white/10 bg-slate-900 shadow-2xl shadow-black/50 sm:rounded-3xl"
        >
          <header class="flex items-start justify-between gap-4 border-b border-white/10 px-5 py-4 sm:px-6">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-teal-300">
                Repository prompt · version {definition.current_version.version}
              </p>
              <h2
                id="automation-prompt-preview-title"
                class="mt-1 text-xl font-semibold text-white"
              >
                {definition.name}
              </h2>
              <p class="mt-1 text-xs text-slate-500">{repository_key(definition.repository)}</p>
            </div>
            <button
              type="button"
              phx-click="close-prompt-preview"
              class="rounded-xl border border-white/10 px-3 py-2 text-sm font-semibold text-slate-300 hover:border-white/20 hover:text-white"
            >
              Close
            </button>
          </header>

          <div class="overflow-y-auto p-5 sm:p-6">
            <div class="mb-4 grid gap-3 text-sm leading-6 sm:grid-cols-2">
              <div class="rounded-xl border border-teal-400/20 bg-teal-400/[0.06] p-4 text-teal-100/80">
                <p class="font-semibold text-teal-100">Your complete prompt</p>
                <p class="mt-1">
                  The automation has one editable instruction. PtcManager does not add hidden safety prose.
                </p>
              </div>
              <div class="rounded-xl border border-sky-400/20 bg-sky-400/[0.06] p-4 text-sky-100/80">
                <p class="font-semibold text-sky-100">Generated runtime context</p>
                <p class="mt-1">
                  Repository, issue or PR, branch, SHA, and available GitHub access are inserted from the real queued run. Actions that return private information also receive a schema and result destination.
                </p>
              </div>
            </div>
            <p class="mb-3 text-xs leading-5 text-slate-500">
              This preview uses safe example target values. Saving configuration changes creates a new version and does not alter already queued or running work.
            </p>
            <pre
              id={"automation-full-prompt-preview-#{definition.id}"}
              class="overflow-x-auto whitespace-pre-wrap break-words rounded-2xl border border-white/10 bg-slate-950/80 p-4 font-mono text-xs leading-6 text-slate-200 sm:p-5"
            >{prompt_preview(definition)}</pre>
          </div>
        </section>
      <% end %>
    </div>
  </div>
</Layouts.app>
