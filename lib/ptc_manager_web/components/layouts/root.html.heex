<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="PtcManager" suffix=" · Maintainer console">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.removeAttribute("data-theme");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
        
        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));

        const repositoryKey = "ptc-manager:repository";
        window.ptcSelectRepository = (repository) => {
          localStorage.setItem(repositoryKey, repository);

          const url = new URL(window.location.href);
          url.searchParams.set("repo", repository);
          window.location.assign(url.toString());
        };

        const restoreRepository = () => {
          const selector = document.querySelector("[data-repository-selector]");
          if (!selector) return;

          const url = new URL(window.location.href);
          const requested = url.searchParams.get("repo");
          if (requested) {
            localStorage.setItem(repositoryKey, requested);
            return;
          }

          const stored = localStorage.getItem(repositoryKey);
          if (stored && Array.from(selector.options).some((option) => option.value === stored)) {
            url.searchParams.set("repo", stored);
            window.location.replace(url.toString());
          }
        };

        window.addEventListener("DOMContentLoaded", restoreRepository);
        window.addEventListener("phx:page-loading-stop", restoreRepository);
      })();
    </script>
  </head>
  <body class="bg-slate-950 antialiased">
    {@inner_content}
  </body>
</html>
