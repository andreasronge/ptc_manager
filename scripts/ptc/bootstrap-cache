#!/bin/sh
set -eu

# This cache is an optimization only. Every restored directory is copied into
# the worktree before Mix can mutate it, so concurrent agents never share a
# writable deps or _build directory.

command=${1:-}
case "$command" in
  restore|publish) ;;
  *)
    echo "usage: scripts/ptc/bootstrap-cache <restore|publish>" >&2
    exit 2
    ;;
esac

cache_root=${PTC_WORKSPACE_CACHE_ROOT:-${XDG_CACHE_HOME:-$HOME/.cache}/ptc-manager/workspaces}
mix_environment=${MIX_ENV:-dev}

hash_file() {
  if [ -f "$1" ]; then
    git hash-object -- "$1"
  else
    printf '%s' missing
  fi
}

cache_key=$(
  {
    printf 'schema=1\n'
    printf 'system=%s\n' "$(uname -s)-$(uname -m)"
    printf 'mix_env=%s\n' "$mix_environment"
    printf 'elixir=%s\n' "$(elixir --version 2>/dev/null | tr '\n' ' ')"
    printf 'mix_lock=%s\n' "$(hash_file mix.lock)"
    printf 'mix_exs=%s\n' "$(hash_file mix.exs)"
    printf 'config=%s\n' "$(hash_file config/config.exs)"
    printf 'bootstrap=%s\n' "$(hash_file scripts/ptc/bootstrap)"
    printf 'cache_helper=%s\n' "$(hash_file scripts/ptc/bootstrap-cache)"
  } | git hash-object --stdin
)

cache_directory=$cache_root/ptc_manager/$cache_key
ready_marker=$cache_directory/READY
workspace_marker=_build/.ptc-workspace-cache-key

mark_workspace_prepared() {
  mkdir -p _build
  marker_temporary=${workspace_marker}.tmp.$$
  printf '%s\n' "$cache_key" > "$marker_temporary"
  mv "$marker_temporary" "$workspace_marker"
}

copy_tree() {
  source_directory=$1
  destination_directory=$2

  if [ -d "$source_directory" ]; then
    mkdir -p "$destination_directory"

    case "$(uname -s)" in
      Darwin)
        source_device=$(stat -f '%d' "$source_directory")
        destination_device=$(stat -f '%d' "$destination_directory")

        if [ "$source_device" = "$destination_device" ]; then
          # APFS clone copies create independent copy-on-write files in a few
          # seconds without sharing writable inodes between agent worktrees.
          cp -cR "$source_directory"/. "$destination_directory"/
        else
          cp -R "$source_directory"/. "$destination_directory"/
        fi
        ;;

      Linux)
        if cp --help 2>&1 | grep -q -- '--reflink'; then
          # GNU cp falls back to a physical copy when the filesystem does not
          # support reflinks, preserving portability on ordinary ext4 hosts.
          cp -a --reflink=auto "$source_directory"/. "$destination_directory"/
        else
          cp -R "$source_directory"/. "$destination_directory"/
        fi
        ;;

      *)
        cp -R "$source_directory"/. "$destination_directory"/
        ;;
    esac
  fi
}

restore_cache() {
  started=$(date +%s)

  if [ -f "$ready_marker" ] && [ -d deps ] && [ -d _build ] &&
    [ -f "$workspace_marker" ] && [ "$(cat "$workspace_marker")" = "$cache_key" ]; then
    # Persistent checkouts are already private and prepared. Avoid deleting
    # and cloning the same dependency trees again on every deployment.
    state=hit
  elif [ -f "$ready_marker" ]; then
    # Never merge a cache into an existing dependency tree. Git dependencies
    # can contain read-only pack files, and cp cannot overwrite those files on
    # a later restore. Build the complete replacement beside the destination,
    # make the private copies owner-writable, then install both trees only
    # after staging succeeded.
    restore_staging=$(mktemp -d .ptc-cache-restore.XXXXXX)

    cleanup_restore() {
      case "$restore_staging" in
        .ptc-cache-restore.*) rm -rf -- "$restore_staging" ;;
      esac
    }

    trap cleanup_restore 0 HUP INT TERM
    mkdir -p "$restore_staging/deps" "$restore_staging/build"
    copy_tree "$cache_directory/deps" "$restore_staging/deps"
    copy_tree "$cache_directory/build" "$restore_staging/build"
    chmod -R u+w "$restore_staging"

    rm -rf -- deps _build
    mv "$restore_staging/deps" deps
    mv "$restore_staging/build" _build
    mark_workspace_prepared

    cleanup_restore
    trap - 0 HUP INT TERM
    state=hit
  else
    state=miss
  fi

  ended=$(date +%s)
  printf 'PTC_SETUP_METRIC cache_state=%s\n' "$state"
  printf 'PTC_SETUP_METRIC cache_restore_ms=%s\n' "$(((ended - started) * 1000))"
}

copy_build_cache() {
  destination=$1
  build_lib=_build/$mix_environment/lib

  mkdir -p "$destination/$mix_environment/lib"

  if [ -d "$build_lib" ]; then
    for dependency in "$build_lib"/*; do
      [ -d "$dependency" ] || continue
      [ "$(basename "$dependency")" = ptc_manager ] && continue
      copy_tree "$dependency" "$destination/$mix_environment/lib/$(basename "$dependency")"
    done
  fi

  for executable in _build/esbuild-* _build/tailwind-*; do
    [ -f "$executable" ] || continue
    cp "$executable" "$destination/$(basename "$executable")"
    chmod 755 "$destination/$(basename "$executable")"
  done
}

publish_cache() {
  started=$(date +%s)

  if [ -f "$ready_marker" ]; then
    mark_workspace_prepared
    ended=$(date +%s)
    printf 'PTC_SETUP_METRIC cache_publish_ms=%s\n' "$(((ended - started) * 1000))"
    return
  fi

  parent=$cache_root/ptc_manager
  temporary=$parent/.${cache_key}.tmp.$$
  lock=$parent/.${cache_key}.lock

  if ! mkdir -p "$parent" 2>/dev/null; then
    printf '%s\n' 'Workspace cache unavailable; continuing without publishing it.' >&2
    printf 'PTC_SETUP_METRIC cache_state=disabled\n'
    return
  fi

  if ! mkdir "$lock" 2>/dev/null; then
    # Another cold worktree is publishing the identical cache. Its atomic READY
    # marker will make the next setup warm; this worktree is already prepared.
    mark_workspace_prepared
    ended=$(date +%s)
    printf 'PTC_SETUP_METRIC cache_publish_ms=%s\n' "$(((ended - started) * 1000))"
    return
  fi

  trap 'rm -rf -- "$temporary"; rmdir "$lock" 2>/dev/null || true' 0 HUP INT TERM
  rm -rf -- "$temporary"
  mkdir -p "$temporary"
  copy_tree deps "$temporary/deps"
  copy_build_cache "$temporary/build"
  printf '%s\n' "$cache_key" > "$temporary/READY"

  if [ ! -f "$ready_marker" ]; then
    rm -rf -- "$cache_directory"
    mv "$temporary" "$cache_directory"
  fi

  rm -rf -- "$temporary"
  rmdir "$lock" 2>/dev/null || true
  trap - 0 HUP INT TERM
  mark_workspace_prepared

  ended=$(date +%s)
  printf 'PTC_SETUP_METRIC cache_publish_ms=%s\n' "$(((ended - started) * 1000))"
}

case "$command" in
  restore) restore_cache ;;
  publish) publish_cache ;;
esac
