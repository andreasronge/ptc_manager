#!/usr/bin/env python3
"""Run directly, or coordinate one expensive command when context is present."""

import argparse
import errno
import fcntl
import json
import os
import platform
import resource
import signal
import select
import socket
import subprocess
import sys
import threading
import time
import uuid
import hashlib


def parse_args():
    parser = argparse.ArgumentParser(prog="ptc-operation")
    commands = parser.add_subparsers(dest="subcommand", required=True)
    review = commands.add_parser("review")
    review.add_argument("--handoff-file", help="Optional plain-text note for the reviewer (up to 20 KB)")
    run = commands.add_parser("run")
    run.add_argument("--label", required=True)
    run.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    if args.subcommand == "review":
        return args
    if args.command and args.command[0] == "--":
        args.command = args.command[1:]
    if not args.command:
        parser.error("run requires a command after --")
    return args


def execute_direct(command):
    os.execvp(command[0], command)


class LeaseRefused(Exception):
    """The coordinator no longer leases this attempt to the wrapper."""


LEASED_STATES = ("starting", "running", "cancelling", "recovery_pending")
LEASE_REFUSALS = ("stale_operation_lease", "operation_not_found")


def broker_request(context, fields):
    message = {
        "token": context["token"],
        "context_id": context["context_id"],
        **fields,
    }
    client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    client.settimeout(10)
    try:
        client.connect(context["socket_path"])
        client.sendall((json.dumps(message, separators=(",", ":")) + "\n").encode())
        response = b""
        while b"\n" not in response:
            chunk = client.recv(65536)
            if not chunk:
                break
            response += chunk
        decoded = json.loads(response.split(b"\n", 1)[0])
        if decoded.get("status") == "error":
            error = str(decoded.get("error", "coordinator error"))
            if any(refusal in error for refusal in LEASE_REFUSALS):
                raise LeaseRefused(error)
            raise RuntimeError(error)
        return decoded
    finally:
        client.close()


def broker_request_with_retry(context, fields, attempts=3):
    last_error = None
    for attempt in range(attempts):
        try:
            return broker_request(context, fields)
        except (OSError, RuntimeError, ValueError) as error:
            last_error = error
            if attempt + 1 < attempts:
                time.sleep(0.2 * (attempt + 1))
    raise last_error


def peak_memory_bytes():
    peak = resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss
    return peak if platform.system() == "Darwin" else peak * 1024


def acquire_slot_lock(context, slot_number):
    path = os.path.join(context["lock_directory"], f"operation-slot-{slot_number}.lock")
    lock = open(path, "a", encoding="ascii")
    try:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        return lock
    except OSError:
        lock.close()
        raise RuntimeError(
            f"operation slot {slot_number} is still held by another process"
        )


def read_text(path):
    with open(path, encoding="ascii") as value_file:
        return value_file.read().strip()


def write_text(path, value):
    with open(path, "w", encoding="ascii") as value_file:
        value_file.write(f"{value}\n")


def create_operation_cgroup(context, operation_id, attempt_token, label):
    if not context.get("cgroups"):
        return None
    if platform.system() != "Linux" or not os.path.exists(
        "/sys/fs/cgroup/cgroup.controllers"
    ):
        raise RuntimeError("managed operation cgroups require Linux cgroup v2")

    relative = None
    with open("/proc/self/cgroup", encoding="ascii") as membership:
        for line in membership:
            parts = line.rstrip().split(":", 2)
            if parts[0] == "0":
                relative = parts[2]
                break
    if not relative:
        raise RuntimeError("current cgroup v2 membership is unavailable")

    current = os.path.join("/sys/fs/cgroup", relative.lstrip("/"))
    if os.path.basename(current) != "processes" or not os.path.basename(
        os.path.dirname(current)
    ).startswith("ptc-agent-"):
        raise RuntimeError("managed agent cgroup is unavailable")

    agent_root = os.path.dirname(current)
    if label == "verify":
        # Retained panes keep their original parent cgroup after a deploy.
        # Lift its soft ceiling once; the existing hard ceiling is unchanged.
        agent_high_path = os.path.join(agent_root, "memory.high")
        agent_high = read_text(agent_high_path)
        verify_agent_high = context.get("verify_agent_memory_high_bytes", 2_952_790_016)
        if agent_high != "max" and int(agent_high) < verify_agent_high:
            write_text(agent_high_path, verify_agent_high)

    safe_token = attempt_token[:12]
    operation_path = os.path.join(agent_root, f"operation-{operation_id}-{safe_token}")
    os.mkdir(operation_path)
    write_text(
        os.path.join(operation_path, "memory.high"),
        (
            context.get("verify_operation_memory_high_bytes", 2_577_399_808)
            if label == "verify"
            else context["operation_memory_high_bytes"]
        ),
    )
    write_text(
        os.path.join(operation_path, "memory.max"),
        context["operation_memory_max_bytes"],
    )
    return operation_path


def cgroup_add_process(path, pid):
    if path:
        write_text(os.path.join(path, "cgroup.procs"), pid)


def cgroup_peak(path):
    if not path:
        return peak_memory_bytes()
    value = read_text(os.path.join(path, "memory.peak"))
    return int(value) if value and value != "max" else 0


def resource_metrics(path):
    """Optional cgroup counters. Telemetry failure must not fail the command."""
    if not path:
        return None
    metrics = {}
    def optional_read(file):
        try:
            return read_text(file)
        except OSError:
            return None
    try:
        def counters(name):
            text = optional_read(os.path.join(path, name)) or ""
            return {parts[0]: int(parts[1]) for line in text.splitlines()
                    if len(parts := line.split()) == 2 and parts[1].isdigit()}
        cpu = counters("cpu.stat")
        for source, dest in (("usage_usec", "cpu_usage_usec"), ("user_usec", "cpu_user_usec"),
                             ("system_usec", "cpu_system_usec"), ("throttled_usec", "cpu_throttled_usec")):
            if source in cpu:
                metrics[dest] = cpu[source]
        memory = counters("memory.events")
        for source, dest in (("high", "memory_high_events"), ("oom_kill", "oom_kills")):
            if source in memory:
                metrics[dest] = memory[source]
        io = optional_read(os.path.join(path, "io.stat"))
        if io is not None:
            metrics.update(io_read_bytes=0, io_write_bytes=0)
            for line in io.splitlines():
                for entry in line.split()[1:]:
                    key, _, value = entry.partition("=")
                    if key in ("rbytes", "wbytes") and value.isdigit():
                        metrics["io_read_bytes" if key == "rbytes" else "io_write_bytes"] += int(value)
        metrics["allowed_cpus"] = len(os.sched_getaffinity(0))
        # Ancestor limits constrain the operation too, but can be shared with peers.
        current = path
        while current.startswith("/sys/fs/cgroup"):
            limit = optional_read(os.path.join(current, "memory.max"))
            if limit and limit.strip().isdigit():
                amount = int(limit)
                metrics["memory_limit_bytes"] = min(metrics.get("memory_limit_bytes", amount), amount)
            quota = (optional_read(os.path.join(current, "cpu.max")) or "").split()
            if len(quota) == 2 and all(v.isdigit() for v in quota) and int(quota[1]) > 0:
                amount = int(quota[0]) * 1000 // int(quota[1])
                metrics["cpu_quota_millicores"] = min(metrics.get("cpu_quota_millicores", amount), amount)
            current = os.path.dirname(current)
    except (OSError, ValueError, AttributeError):
        pass
    return metrics or None


def cleanup_cgroup(path):
    if not path:
        return
    deadline = time.monotonic() + 5
    while time.monotonic() < deadline:
        events = read_text(os.path.join(path, "cgroup.events"))
        if "populated 0" in events:
            try:
                os.rmdir(path)
                return
            except OSError as error:
                if error.errno not in (errno.EBUSY, errno.ENOTEMPTY):
                    raise
        time.sleep(0.05)
    raise RuntimeError("operation process tree did not leave its cgroup")


def signal_group(pgid, signum, quiet=()):
    """Signal a process group. A failure is logged unless listed in `quiet`,
    and is never taken as proof that the group is gone: macOS answers EPERM
    for a group that holds only its unreaped leader, and also for one it may
    not signal."""
    try:
        os.killpg(pgid, signum)
    except ProcessLookupError:
        pass
    except quiet:
        pass
    except Exception as error:
        print(f"ptc-operation: signal {signum} to process group {pgid} failed: {error}",
              file=sys.stderr)


MARKER_VARIABLE = "PTC_OPERATION_ATTEMPT"
REMAINING_LIMIT = 20


def attempt_marker(operation_id, attempt_token):
    return f"{operation_id}-{attempt_token[:12]}"


def marked_processes(marker):
    """Live processes of this user whose visible environment carries the
    attempt marker, as (pid, stat, command) without zombies. macOS hides the
    environment of Apple platform binaries and Linux that of non-dumpable
    processes, so this is one of two detectors."""
    needle = f"{MARKER_VARIABLE}={marker}"
    if sys.platform == "darwin":
        listing = subprocess.run(["/bin/ps", "-E", "-ww", "-x", "-o", "pid=,stat=,command="],
                                 capture_output=True, text=True, timeout=10, check=True,
                                 errors="replace").stdout
        pids = []
        for line in listing.splitlines():
            fields = line.split(None, 2)
            if len(fields) == 3 and not fields[1].startswith("Z") and \
                    needle in fields[2].split():
                pids.append(fields[0])
        if not pids:
            return []
        # Describe matches from their arguments alone; the environment can hold secrets.
        # ps exits 1 when none of the pids exist any more, so its status alone
        # cannot tell a vanished match from a failure. A match it does not
        # describe stays listed; the next poll drops it once it is really gone.
        described = {}
        for line in subprocess.run(["/bin/ps", "-ww", "-o", "pid=,stat=,command=", "-p", ",".join(pids)],
                                   capture_output=True, text=True, timeout=10,
                                   errors="replace").stdout.splitlines():
            fields = line.split(None, 2)
            if len(fields) >= 2:
                described[fields[0]] = (fields[1], fields[2] if len(fields) == 3 else "")
        found = []
        for pid in pids:
            stat, command = described.get(pid, ("?", "(not described)"))
            if not stat.startswith("Z"):
                found.append((int(pid), stat, command))
        return found
    found = []
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        try:
            if os.stat(f"/proc/{entry}").st_uid != os.getuid():
                continue
            with open(f"/proc/{entry}/environ", "rb") as source:
                if needle.encode() not in source.read().split(b"\0"):
                    continue
            with open(f"/proc/{entry}/stat", encoding="utf-8", errors="replace") as source:
                state = source.read().rsplit(")", 1)[1].split()[0]
            with open(f"/proc/{entry}/cmdline", "rb") as source:
                command = source.read().replace(b"\0", b" ").decode(errors="replace").strip()
        except (FileNotFoundError, ProcessLookupError):
            continue
        except PermissionError:
            # A non-dumpable process (one that changed credentials) hides its
            # environment from its own account, as macOS does for platform
            # binaries; the output check is what can still see it.
            continue
        if not state.startswith("Z"):
            found.append((int(entry), state, command))
    return found


def remaining_after_kill(marker, timeout=2.0):
    """Give SIGKILL up to `timeout` seconds to take effect, then return the
    marked processes still alive, or the error that prevented listing them."""
    deadline = time.monotonic() + timeout
    while True:
        try:
            found = marked_processes(marker)
            error = None
        except Exception as listing_error:
            found, error = [], f"process listing failed: {listing_error}"
        if (not found and error is None) or time.monotonic() >= deadline:
            return found, error
        time.sleep(0.1)


def wait_unreaped(pid):
    """Block until child `pid` exits, leaving it unreaped."""
    if hasattr(os, "waitid"):
        os.waitid(os.P_PID, pid, os.WEXITED | os.WNOWAIT)
        return
    # macOS has no waitid; a kqueue exit event also leaves the zombie in place.
    queue = select.kqueue()
    try:
        event = select.kevent(pid, filter=select.KQ_FILTER_PROC,
                              flags=select.KQ_EV_ADD | select.KQ_EV_ONESHOT,
                              fflags=select.KQ_NOTE_EXIT)
        try:
            queue.control([event], 1, None)
        except ProcessLookupError:
            # Already exited: an unreaped child of ours is a zombie.
            pass
    finally:
        queue.close()


def managed_run(args, context):
    response = broker_request_with_retry(
        context,
        {
            "operation": "request",
            "invocation_id": str(uuid.uuid4()),
            "label": args.label,
        },
    )
    operation_id = response["operation_id"]
    announced_wait = False
    poll_seconds = float(os.environ.get("PTC_OPERATION_POLL_SECONDS", "0.5"))

    while response.get("status") == "queued":
        if not announced_wait:
            print(
                f"Waiting for PtcManager operation slot: {args.label}", file=sys.stderr
            )
            announced_wait = True
        time.sleep(poll_seconds)
        response = broker_request_with_retry(
            context, {"operation": "acquire", "operation_id": operation_id}
        )

    if response.get("status") != "starting":
        raise RuntimeError(
            f"operation entered unexpected state {response.get('status')}"
        )

    attempt_token = response["attempt_token"]
    try:
        slot_lock = acquire_slot_lock(context, response["slot_number"])
    except Exception as error:
        broker_request_with_retry(
            context,
            {
                "operation": "finish",
                "operation_id": operation_id,
                "attempt_token": attempt_token,
                "exit_status": 75,
                "peak_memory_bytes": 0,
                "last_error": f"slot lock acquisition failed: {error}",
            },
        )
        raise

    cgroup_path = None
    try:
        cgroup_path = create_operation_cgroup(context, operation_id, attempt_token, args.label)
    except Exception as error:
        broker_request_with_retry(
            context,
            {
                "operation": "finish",
                "operation_id": operation_id,
                "attempt_token": attempt_token,
                "exit_status": 75,
                "peak_memory_bytes": 0,
                "last_error": f"cgroup setup failed: {error}",
            },
        )
        slot_lock.close()
        raise

    group_lock = threading.RLock()
    child = None
    group_alive = True
    pending_signals = []
    lease_lost = threading.Event()

    def forward(signum, _frame):
        with group_lock:
            if child is None:
                pending_signals.append(signum)
            elif group_alive:
                signal_group(child.pid, signum)

    # Handlers go in before the coordinator records the launch, so a signal
    # can no longer kill the wrapper between `running` and the command start.
    for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(signum, forward)

    def give_up(reason, detail):
        cleanup_cgroup(cgroup_path)
        slot_lock.close()
        print(f"ptc-operation: {reason}: {detail}", file=sys.stderr)
        try:
            broker_request_with_retry(
                context,
                {
                    "operation": "finish",
                    "operation_id": operation_id,
                    "attempt_token": attempt_token,
                    "exit_status": 75,
                    "peak_memory_bytes": 0,
                    "last_error": f"{reason}: {detail}"[:500],
                },
            )
        except Exception:
            pass
        return 75

    try:
        acknowledgement = broker_request_with_retry(
            context,
            {
                "operation": "running",
                "operation_id": operation_id,
                "attempt_token": attempt_token,
                "wrapper_pid": os.getpid(),
                "cgroup_path": cgroup_path,
            },
        )
    except Exception as error:
        return give_up("the coordinator did not acknowledge the launch", error)
    if acknowledgement.get("status") != "running" or \
            acknowledgement.get("operation_id") != operation_id:
        return give_up("the coordinator did not acknowledge the launch",
                       json.dumps(acknowledgement, sort_keys=True))

    marker = attempt_marker(operation_id, attempt_token)
    check_remaining = bool(context.get("check_remaining_processes")) and not cgroup_path
    child_environment = os.environ.copy()
    child_environment["PTC_OPERATION_ACTIVE"] = str(operation_id)
    child_environment["PTC_OPERATION_LABEL"] = args.label
    child_environment[MARKER_VARIABLE] = marker
    artifact = None
    try:
        artifact = OperationArtifact(context, operation_id, attempt_token)
    except Exception as error:
        print(f"PtcManager artifact capture unavailable: {error}", file=sys.stderr)
        artifact = PassthroughArtifact()
    try:
        with group_lock:
            if cgroup_path:

                def child_setup():
                    os.setsid()
                    cgroup_add_process(cgroup_path, os.getpid())

                child = subprocess.Popen(args.command, env=child_environment, preexec_fn=child_setup,
                                         stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            else:
                child = subprocess.Popen(args.command, env=child_environment, start_new_session=True,
                                         stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            for signum in pending_signals:
                signal_group(child.pid, signum)
    except Exception as error:
        return give_up("command start failed", error)
    stop_heartbeat = threading.Event()

    def heartbeat():
        interval = float(os.environ.get("PTC_OPERATION_HEARTBEAT_SECONDS", "5"))
        while not stop_heartbeat.wait(interval):
            try:
                update = broker_request_with_retry(
                    context,
                    {
                        "operation": "heartbeat",
                        "operation_id": operation_id,
                        "attempt_token": attempt_token,
                    },
                )
                if update.get("status") not in LEASED_STATES:
                    raise LeaseRefused(f"operation is {update.get('status')}")
                if update.get("cancel_requested"):
                    forward(signal.SIGTERM, None)
            except LeaseRefused as error:
                # The slot may already belong to someone else: stop at once.
                print(f"ptc-operation: the coordinator released this operation ({error}); "
                      "stopping the command", file=sys.stderr)
                lease_lost.set()
                forward(signal.SIGKILL, None)
                return
            except Exception as error:
                print(
                    f"PtcManager operation heartbeat failed: {error}", file=sys.stderr
                )

    thread = threading.Thread(target=heartbeat, daemon=True)
    thread.start()
    pumps = artifact.start(child)
    # Keep the exited leader unreaped so its PID/PGID cannot be reused while
    # signalling descendants. Reap only after terminating the original group.
    wait_unreaped(child.pid)
    stop_heartbeat.set()
    # A completed command must not leave descendants holding its pipe writers.
    # macOS refuses this with EPERM after every command whose group holds only
    # the unreaped leader; that is not logged, and not trusted either: the
    # remaining-process check below decides.
    with group_lock:
        signal_group(child.pid, signal.SIGKILL,
                     quiet=(PermissionError,) if sys.platform == "darwin" else ())
        group_alive = False
    remaining, listing_error = [], None
    if check_remaining and not lease_lost.is_set():
        remaining, listing_error = remaining_after_kill(marker)
    status = child.wait()
    if cgroup_path:
        try:
            write_text(os.path.join(cgroup_path, "cgroup.kill"), "1")
        except OSError as error:
            print(f"PtcManager descendant cleanup failed: {error}", file=sys.stderr)
    artifact.stopped.set()
    for pump in pumps:
        pump.join()
    exit_status = status if status >= 0 else 128 + abs(status)
    try:
        artifact.seal(exit_status)
    except OSError as error:
        print(f"PtcManager artifact sealing failed: {error}", file=sys.stderr)
    thread.join(timeout=1)

    if lease_lost.is_set():
        cleanup_cgroup(cgroup_path)
        slot_lock.close()
        return 75

    observed_peak = cgroup_peak(cgroup_path)
    observed_metrics = resource_metrics(cgroup_path)
    cleanup_cgroup(cgroup_path)

    finish = {
        "operation": "finish",
        "operation_id": operation_id,
        "attempt_token": attempt_token,
        "exit_status": exit_status,
        "peak_memory_bytes": observed_peak,
        "resource_metrics": observed_metrics,
    }
    if check_remaining and (remaining or listing_error or artifact.output_held):
        detail = listing_error or (
            "a process outside the command's group still holds its output"
            if artifact.output_held and not remaining else None)
        finish.update(processes_remaining=True, remaining_detail=detail,
                      remaining_processes=[
                          {"pid": pid, "stat": stat[:16], "command": command[:300]}
                          for pid, stat, command in remaining[:REMAINING_LIMIT]])
        print("ptc-operation: processes started by this command are still running; "
              "PtcManager keeps its operation slot until a maintainer releases it",
              file=sys.stderr)
    try:
        broker_request_with_retry(context, finish)
    except LeaseRefused as error:
        print(f"ptc-operation: the coordinator refused the result ({error})", file=sys.stderr)
        slot_lock.close()
        return 75
    slot_lock.close()
    return exit_status


def stream_chunks(source, stopped=None):
    deadline = None
    while True:
        if stopped is not None and stopped.is_set() and deadline is None:
            deadline = time.monotonic() + 5
        if deadline is not None and time.monotonic() >= deadline:
            raise TimeoutError("post-exit stream drain exceeded five seconds")
        if not select.select([source], [], [], 0.1)[0]:
            continue
        data = os.read(source.fileno(), 65536)
        if not data:
            return
        yield data


class OperationArtifact:
    """Continuously tees separate child streams into an attempt-scoped durable directory."""
    output_held = False

    def __init__(self, context, operation_id, attempt_token):
        root = context.get("artifact_root")
        if not root:
            raise RuntimeError("execution artifact root unavailable")
        owner = f"{context['owner_type']}-{context['owner_id']}"
        self.directory = os.path.join(root, f"repository-{context['repository_id']}", owner,
                                      f"operation-{operation_id}-{attempt_token}")
        ensure_shared_directory(root, self.directory)
        self.limit = context.get("artifact_max_bytes", 256_000_000)
        self.records = {}

    def start(self, child):
        self.stopped = threading.Event()
        pairs = (("stdout", child.stdout, sys.stdout.buffer),
                 ("stderr", child.stderr, sys.stderr.buffer))
        threads = []
        for name, source, live in pairs:
            thread = threading.Thread(target=self._pump, args=(name, source, live), daemon=True)
            thread.start()
            threads.append(thread)
        return threads

    def _pump(self, name, source, live):
        path = os.path.join(self.directory, name + ".log")
        digest, size, state, detail = hashlib.sha256(), 0, "complete", None
        target = None
        try:
            target = open(path, "xb", buffering=0)
        except OSError as error:
            state, detail = "error", f"open failed: {error.strerror}"
        try:
            for data in stream_chunks(source, getattr(self, "stopped", None)):
                live.write(data)
                live.flush()
                if target is not None:
                    if size + len(data) <= self.limit:
                        try:
                            target.write(data)
                            digest.update(data)
                            size += len(data)
                        except OSError as error:
                            state, detail = "error", f"write failed: {error.strerror}"
                            target.close()
                            target = None
                    else:
                        state, detail = "partial", "stream exceeded configured file budget"
                        target.close()
                        target = None
        except TimeoutError as error:
            state, detail = "partial", str(error)
            self.output_held = True
        finally:
            source.close()
            if target is not None:
                try:
                    target.flush()
                    os.fsync(target.fileno())
                    target.close()
                except OSError as error:
                    state, detail = "error", f"finalization failed: {error.strerror}"
            self.records[name] = {"path": name + ".log", "bytes": size,
                                  "sha256": digest.hexdigest(), "coverage": state,
                                  "diagnostic": detail}

    def seal(self, exit_status):
        states = [self.records.get(name, {}).get("coverage", "error")
                  for name in ("stdout", "stderr")]
        coverage = ("error" if "error" in states else
                    "complete" if all(state == "complete" for state in states) else "partial")
        manifest = {"schema_version": 1, "kind": "operation", "exit_status": exit_status,
                    "coverage": coverage, "streams": self.records,
                    "ordering": "streams_are_independent"}
        temporary = os.path.join(self.directory, ".manifest.json.tmp")
        final = os.path.join(self.directory, "manifest.json")
        with open(temporary, "x", encoding="utf-8") as output:
            json.dump(manifest, output, separators=(",", ":"), sort_keys=True)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, final)
        os.chmod(final, 0o440)
        for record in self.records.values():
            try:
                os.chmod(os.path.join(self.directory, record["path"]), 0o440)
            except OSError:
                pass


class PassthroughArtifact:
    """Drain and forward streams even when durable capture cannot start."""
    output_held = False

    def start(self, child):
        self.stopped = threading.Event()
        threads = []
        for source, live in ((child.stdout, sys.stdout.buffer), (child.stderr, sys.stderr.buffer)):
            thread = threading.Thread(target=self._pump, args=(source, live), daemon=True)
            thread.start()
            threads.append(thread)
        return threads

    def _pump(self, source, live):
        try:
            for data in stream_chunks(source, getattr(self, "stopped", None)):
                live.write(data)
                live.flush()
        except TimeoutError as error:
            self.output_held = True
            print(f"PtcManager output forwarding incomplete: {error}", file=sys.stderr)
        finally:
            source.close()

    def seal(self, _exit_status):
        pass


def ensure_shared_directory(root, directory):
    current = os.path.abspath(root)
    target = os.path.abspath(directory)
    if os.path.islink(current) or not os.path.isdir(current):
        raise RuntimeError("unsafe artifact root")
    if not target.startswith(current + os.sep):
        raise RuntimeError("artifact path escaped configured root")
    for part in os.path.relpath(target, current).split(os.sep):
        current = os.path.join(current, part)
        try:
            os.mkdir(current, mode=0o2770)
            os.chmod(current, 0o2770)
        except FileExistsError:
            if os.path.islink(current) or not os.path.isdir(current):
                raise RuntimeError("unsafe artifact directory")
            if os.stat(current, follow_symlinks=False).st_mode & 0o020 == 0:
                raise RuntimeError("artifact directory is not group writable")


def main():
    args = parse_args()
    if args.subcommand == "review":
        try:
            with open(os.environ["PTC_MANAGED_OPERATION_CONTEXT"], encoding="utf-8") as source:
                context = json.load(source)
            handoff = ""
            if args.handoff_file:
                with open(args.handoff_file, "rb") as source:
                    data = source.read(20_001)
                if len(data) > 20_000:
                    raise ValueError("handoff exceeds 20 KB")
                handoff = data.decode("utf-8")
            response = broker_request_with_retry(context, {"operation": "review", "request_id": str(uuid.uuid4()), "handoff": handoff})
            while response.get("state") in ("queued", "running"):
                time.sleep(2)
                response = broker_request_with_retry(context, {"operation": "review_status", "round_id": response["round_id"]})
            print(json.dumps(response))
            return 0 if response.get("state") in ("passed", "skipped") else 2
        except Exception as error:
            detail = str(error).replace("\n", " ")[-500:]
            if "review_unavailable_in_action" in detail:
                print("ptc-operation: no managed review exists inside a repair or merge action; the pull request's CI is the gate. Validate with the repository's own checks, commit, and push the existing branch.", file=sys.stderr)
                return 76
            print(f"ptc-operation: review unavailable ({type(error).__name__}: {detail}); preserve your work and check the console.", file=sys.stderr)
            return 75
    if os.environ.get("PTC_OPERATION_ACTIVE"):
        execute_direct(args.command)

    context_path = os.environ.get("PTC_MANAGED_OPERATION_CONTEXT")
    if not context_path:
        execute_direct(args.command)

    with open(context_path, encoding="utf-8") as context_file:
        context = json.load(context_file)

    try:
        return managed_run(args, context)
    except Exception as error:
        print(f"ptc-operation: coordinator unavailable: {error}", file=sys.stderr)
        return 75


if __name__ == "__main__":
    sys.exit(main())
