[Unit]
Description=PtcManager maintainer console
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
Type=simple
User=ptc-manager
Group=ptc-manager
SupplementaryGroups=ptc-manager-output ptc-manager-repo ptc-manager-publish ptc-manager-external ptc-manager-deploy
UMask=0027
WorkingDirectory=/opt/ptc_manager
Environment=PHX_SERVER=true
EnvironmentFile=/etc/ptc_manager/ptc_manager.env
ExecStart=/opt/ptc_manager/bin/ptc_manager start
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# Linked worktrees keep fetched objects and per-worktree state in the source
# repository's Git directory, while their checked-out files live under the
# worktree root.
ReadWritePaths=/var/lib/ptc_manager /var/lib/ptc_manager-worker /var/lib/ptc_manager-external /var/lib/ptc_manager-output /var/lib/ptc_manager-publish /var/lib/ptc_manager-deploy /srv/ptc_runner/.git /srv/ptc_manager-worktrees /srv/ptc_manager-external

[Install]
WantedBy=multi-user.target
