[Unit]
Description=PtcManager maintainer console
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
Type=simple
User=ptc-manager
Group=ptc-manager
SupplementaryGroups=ptc-manager-output ptc-manager-repo ptc-manager-publish
UMask=0027
WorkingDirectory=/opt/ptc_manager
Environment=PHX_SERVER=true
EnvironmentFile=/etc/ptc_manager/ptc_manager.env
ExecStart=/opt/ptc_manager/bin/ptc_manager start
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ptc_manager /var/lib/ptc_manager-worker /var/lib/ptc_manager-codex /var/lib/ptc_manager-output /var/lib/ptc_manager-publish /srv/ptc_manager-worktrees

[Install]
WantedBy=multi-user.target
