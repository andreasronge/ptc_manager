  *[!0-9a-f]*|'')
    echo "invalid source commit sha" >&2
    exit 2
    ;;
esac

if [ "${#source_commit_sha}" -ne 40 ] && [ "${#source_commit_sha}" -ne 64 ]; then
  echo "invalid source commit sha length" >&2
  exit 2
fi

