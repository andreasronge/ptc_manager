    'PtcManager.OperationalMode.enter_maintenance("deploy")' >/dev/null
}

read_process_setting() {
  process_id=$1
  setting_name=$2
  default_value=$3
  setting_value=$(
    sudo cat "/proc/${process_id}/environ" |
      tr '\000' '\n' |
      awk -F= -v setting="$setting_name" '
        $1 == setting {
          sub(/^[^=]*=/, "")
          print
          found = 1
          exit
        }
        END { if (!found) print "" }
      '
  )

  if [ -n "$setting_value" ]; then
    printf '%s\n' "$setting_value"
  else
    printf '%s\n' "$default_value"
  fi
}

read_environment_setting() {
  setting_name=$1
  shift

  sudo awk -v setting="$setting_name" '
    /^[[:space:]]*($|#)/ { next }
    {
      equals = index($0, "=")
      if (equals == 0) next

      key = substr($0, 1, equals - 1)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)

      if (key == setting) {
        value = substr($0, equals + 1)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)

        if ((value ~ /^".*"$/) || (value ~ /^\047.*\047$/)) {
          value = substr(value, 2, length(value) - 2)
        }

        result = value
      }
    }
    END { print result }
  ' "$@"
}

active_managed_runs() {
  sudo sqlite3 -readonly "$database_path" <"$active_runs_query"
