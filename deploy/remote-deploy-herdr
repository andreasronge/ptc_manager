cleanup_remote() {
  rm -f -- "$source_archive" "$remote_script" "$failure_policy" "$agent_filter" "$active_runs_query" "$repositories_query" \
  "$manager_access_dropin" "$worker_access_dropin" "$access_dropin_check" \
  "$provision_runner_candidate" "$provision_service_candidate" \
  "$environment_file_parser" \
    "$worker_git_candidate" "$worker_review_candidate" "$worktree_cleanup_candidate" "$worktree_preserve_candidate" "$worktree_seal_candidate" "$worker_bootstrap_candidate" "$claude_trust_candidate" \
    "$codex_arm_candidate" "$agent_login_candidate" "$gh_label_candidate" \
    "$operation_wrapper_candidate" \
    "$operation_recovery_candidate" \
    "$needrestart_candidate" \
    "$resources_dropin_candidate" \
    "$agent_context_candidate" "$herdr_launch_candidate" "$herdr_ssh_bridge_candidate" \
    "$herdr_worker_bridge_candidate" "$herdr_bridge_canary_candidate" "$ssh_firewall_candidate" "$sudoers_candidate" \
    "$self_deploy_runner_candidate" "$self_deploy_service_candidate" \
    "$self_deploy_access_candidate" "$health_snapshot_candidate" \
    "$health_snapshot_service_candidate" "$health_snapshot_timer_candidate" \
    "$health_snapshot_env_candidate" \
    "$toolchain_manifest" "$toolchain_reader"
  sudo rm -f -- "$maintenance_override_backup"

  case "$build_dir" in
    /home/agent/src/ptc_manager-build-*) rm -rf -- "$build_dir" ;;
  esac

  case "$worker_node_staging" in
    /opt/ptc-manager-node-*) sudo rm -rf -- "$worker_node_staging" ;;
  esac

  case "$worker_pnpm_staging" in
    /opt/ptc-manager-pnpm-*) sudo rm -rf -- "$worker_pnpm_staging" ;;
  esac

  case "$worker_opt_staging" in
    /opt/ptc-manager-*) sudo rm -rf -- "$worker_opt_staging" ;;
  esac

  case "$worker_tool_staging" in
    /tmp/ptc-manager-*) rm -rf -- "$worker_tool_staging" ;;
  esac

  case "$herdr_link_backup" in
    /opt/ptc-manager-herdr-previous-*)
      # A restoration that failed leaves this as the only copy of the Herdr the
      # running release expects, and the link it came from may already be gone.
      if [ "$herdr_link_backup_retained" != true ]; then
        sudo rm -rf -- "$herdr_link_backup"
      fi
      ;;
  esac

  case "$health_snapshot_backup" in
    /tmp/ptc-manager-health-snapshot-backup-*)
      if [ "$health_snapshot_backup_retained" != true ]; then
        sudo rm -rf -- "$health_snapshot_backup"
      fi
      ;;
  esac

  case "$gate_tool_home" in
    /tmp/ptc-manager-gate-toolchain.*) sudo rm -rf -- "$gate_tool_home" ;;
  esac
}

health_check() {
  expected_mode=$1
  attempt=1

  while [ "$attempt" -le 30 ]; do
    if curl -fsS "$health_url" |
      jq -e --arg mode "$expected_mode" \
        '.status == "ok" and .operational_mode == $mode' >/dev/null; then
      return 0
    fi

    sleep 1
    attempt=$((attempt + 1))
  done

  return 1
}

verify_health_snapshot() {
  previous_file_id=$1
  sudo /usr/bin/python3 -I -c '
import datetime, json, pathlib, sys
path = pathlib.Path(sys.argv[1])
snapshot = json.loads(path.read_text())
captured = datetime.datetime.fromisoformat(snapshot["captured_at"].replace("Z", "+00:00"))
budget = snapshot["freshness_budget_seconds"]
now = datetime.datetime.now(datetime.timezone.utc)
age = (now - captured).total_seconds()
current_file_id = f"{path.stat().st_dev}:{path.stat().st_ino}"
if sys.argv[2] and current_file_id == sys.argv[2]:
    raise SystemExit("health snapshot collection did not replace the evidence file")
if not isinstance(budget, int) or isinstance(budget, bool) or budget <= 0 or budget > 21600:
    raise SystemExit("invalid health snapshot freshness budget")
if age < 0 or age > budget:
    raise SystemExit("health snapshot is not fresh")
' "$health_snapshot_path" "$previous_file_id"
}

legacy_health_check() {
  attempt=1

  while [ "$attempt" -le 30 ]; do
    if curl -fsS -o /dev/null "http://127.0.0.1:${health_port}/"; then
      return 0
    fi

    sleep 1
    attempt=$((attempt + 1))
  done

  return 1
}

install_maintenance_override() {
  capture_maintenance_override

  sudo install -d -o root -g root -m 0755 "$(dirname "$maintenance_override")"
  printf '%s\n' '[Service]' 'Environment=PTC_OPERATIONAL_MODE=maintenance' |
    sudo tee "$maintenance_override" >/dev/null
  sudo chmod 0644 "$maintenance_override"
  sudo systemctl daemon-reload
}

capture_maintenance_override() {
  sudo install -d -o root -g root -m 0755 "$(dirname "$maintenance_override")"

  if sudo test -L "$maintenance_override"; then
    echo "maintenance override must not be a symlink: $maintenance_override" >&2
    return 1
  fi

  if sudo test -f "$maintenance_override" && [ "$maintenance_override_preexisting" = false ]; then
    if sudo test -e "$maintenance_override_backup"; then
      echo "maintenance override backup already exists: $maintenance_override_backup" >&2
      return 1
    fi

    sudo install -o root -g root -m 0600 "$maintenance_override" "$maintenance_override_backup"
    maintenance_override_preexisting=true
  fi
}

remove_maintenance_override() {
  sudo rm -f -- "$maintenance_override"
  sudo systemctl daemon-reload
}

restore_preexisting_maintenance_override() {
  if [ "$maintenance_override_preexisting" = true ]; then
    sudo install -o root -g root -m 0644 "$maintenance_override_backup" "$maintenance_override"
  else
    sudo rm -f -- "$maintenance_override"
  fi

  sudo systemctl daemon-reload
}

pause_new_release() {
