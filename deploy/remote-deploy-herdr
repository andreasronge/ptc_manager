ensure_repository_checkouts
write_repository_access_dropin /.git "$manager_access_dropin"
write_repository_access_dropin "" "$worker_access_dropin"
"$access_dropin_check" "$manager_access_dropin"
"$access_dropin_check" "$worker_access_dropin"
chmod 0644 "$manager_access_dropin" "$worker_access_dropin"
sudo install -d -o root -g root -m 0755 /etc/systemd/system/ptc_manager-herdr.service.d
install_dropin_when_changed "$manager_access_dropin" \
  /etc/systemd/system/ptc_manager.service.d/zz-ptc-manager-repositories.conf
install_dropin_when_changed "$worker_access_dropin" \
  /etc/systemd/system/ptc_manager-herdr.service.d/zz-ptc-manager-repositories.conf
sudo systemctl daemon-reload
sudo rm -f -- /etc/sudoers.d/ptc_manager-codex
mkdir -p "$build_dir"
tar -xf "$source_archive" -C "$build_dir"
cd "$build_dir"

echo "Building production release..."
"$worker_mise" x "erlang@${erlang_version}" "elixir@${elixir_version}" "node@${node_version}" -- \
  env MIX_ENV=prod PTC_WORKSPACE_CACHE_ROOT="$production_workspace_cache" \
  ./scripts/ptc/bootstrap
"$worker_mise" x "erlang@${erlang_version}" "elixir@${elixir_version}" "node@${node_version}" -- \
  env MIX_ENV=prod mix compile
"$worker_mise" x "erlang@${erlang_version}" "elixir@${elixir_version}" "node@${node_version}" -- \
  env MIX_ENV=prod mix assets.deploy
