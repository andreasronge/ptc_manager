echo "Starting release; startup applies pending database migrations..."
install_maintenance_override
sudo systemctl start "$service_name"

health_check maintenance

# The timer is installed from this exact archive on every deployment. Run the
# collector synchronously as well: activation alone cannot prove that its
# database and journal reads work or that consumers have current evidence.
previous_health_snapshot_id=$(sudo stat -c '%d:%i' "$health_snapshot_path" 2>/dev/null || true)
sudo systemctl is-active --quiet ptc_manager.service
sudo systemctl start ptc_manager-health-snapshot.service
verify_health_snapshot "$previous_health_snapshot_id"
sudo systemctl enable --now ptc_manager-health-snapshot.timer

migration_version=$(sudo sqlite3 -readonly "$database_path" \
  "select coalesce(max(version), 0) from schema_migrations;")

echo "Maintenance health passed. Latest database migration: $migration_version"
echo "Running one allowlisted read-only deployment canary..."
deployment_phase=post_effect
sudo -u ptc-manager -H "$application_dir/bin/ptc_manager" rpc \
  "case PtcManager.DeploymentCanary.run(\"deploy-${release_id}\", actor: \"deploy\") do {:ok, result} -> result; {:error, reason} -> raise \"deployment canary failed: #{inspect(reason)}\" end"
health_check canary
remove_maintenance_override

sudo -u ptc-manager -H "$application_dir/bin/ptc_manager" rpc \
  "case PtcManager.DeploymentCanary.activate(\"deploy-${release_id}\", actor: \"deploy\") do :ok -> :ok; {:error, reason} -> raise \"deployment activation failed: #{inspect(reason)}\" end"
if [ "$activation_owner" = managed ]; then
  sudo -u ptc-manager -H "$application_dir/bin/ptc_manager" rpc \
    'PtcManager.OperationalMode.enter_draining("deploy")' >/dev/null
  echo "Service is healthy. Ordinary work remains drained until the host runner records completion."
else
  echo "Service is healthy and ordinary work is active after direct deployment."
fi
deployment_phase=complete
echo "Release backup: $release_backup"
echo "Database backup: $database_backup"
prune_successful_backups
