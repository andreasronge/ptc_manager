ensure_no_managed_runs() {
  active_runs=$(active_managed_runs)

  if [ "$active_runs" -ne 0 ]; then
    echo "refusing to deploy while $active_runs managed agent run(s) are active" >&2
    return 1
  fi
}

# Linked worktrees write the job branch, fetched objects, and per-worktree
# metadata into each repository checkout's Git directory. Both services mount
# the rest of the filesystem read-only, so a checkout missing from their
# ReadWritePaths fails every implementation dispatch with "cannot lock ref".
# Probe the running mount namespaces rather than the unit files so an edited
# but not yet restarted unit is reported here instead of by the next job.
# Every path under /srv belongs to the worker identity with a group the
# deployment user is not in, so a bare test would report an existing checkout as
# missing. Ask through sudo, as every other access to these paths does.
checkout_prepared() { sudo test -d "$1/.git"; }
checkout_occupied() { sudo test -e "$1"; }

# The generated content is the same on most deployments. Installing it anyway
# would move its modification time past every service start, which is the signal
# repository health reads to tell a pending grant from one already in force.
# Leave an unchanged file alone so that time keeps meaning "the grants changed".
install_dropin_when_changed() {
  candidate=$1
  target=$2

  if sudo cmp -s "$candidate" "$target"; then
    echo "Repository access unchanged: $target"
  else
    sudo install -o root -g root -m 0644 "$candidate" "$target"
    echo "Repository access updated: $target"
  fi
}

ensure_repository_checkouts_writable() {
  probe_pid=$1
  probe_service=$2
  probe_suffix=$3

  sudo sqlite3 -readonly "$database_path" \
    "select local_path from repositories where enabled = 1 and coalesce(local_path, '') != '';" |
    while IFS= read -r checkout; do
      case "$checkout" in
        /*) ;;
        *)
          echo "repository checkout path is not absolute: $checkout" >&2
          exit 1
          ;;
      esac

      probe_path="${checkout}${probe_suffix}"

      # A repository configured but not yet prepared is this deployment's work:
      # it creates the checkout and grants it before the services restart.
      if ! checkout_prepared "$checkout"; then
        echo "repository checkout will be prepared by this deployment: $checkout"
        continue
      fi

      if ! sudo nsenter -t "$probe_pid" -m -- /bin/sh -c '[ -d "$1" ] && [ -w "$1" ]' sh "$probe_path"; then
        case "$probe_service" in
          ptc_manager-herdr.service)
            echo "repository checkout is not writable inside $probe_service: $probe_path; the generated access drop-in grants it, but that service keeps retained agent sessions and is never restarted by a deployment, so restart it when no session is retained" >&2
            ;;
          *)
            echo "repository checkout is not writable inside $probe_service: $probe_path; deploy again so the generated access drop-in takes effect when the service restarts" >&2
            ;;
        esac
        exit 1
      fi
    done
}

# Onboarding derives a checkout path for a repository but cannot create it: the
# coordinator runs with ProtectSystem=strict, so /srv is read only inside its
# mount namespace even for root. The deployment runs outside that namespace, so
# it is the one place that can prepare a newly configured repository.
ensure_repository_checkouts() {
  sudo sqlite3 -readonly "$database_path" <"$repositories_query" |
    while IFS='|' read -r owner name checkout; do
      case "$owner$name" in
        *[!A-Za-z0-9_.-]*|'') echo "configured repository name is unsafe: $owner/$name" >&2; exit 1 ;;
      esac
      case "$checkout" in
        /srv/*) ;;
        *) echo "configured checkout path is not under /srv: $checkout" >&2; exit 1 ;;
      esac
      case "$checkout" in
        *..*) echo "configured checkout path is not normalized: $checkout" >&2; exit 1 ;;
      esac

      checkout_prepared "$checkout" && continue

      if checkout_occupied "$checkout"; then
        echo "configured checkout path exists but is not a Git repository: $checkout" >&2
        exit 1
      fi

      echo "Preparing checkout for $owner/$name at $checkout"
      sudo git clone --quiet "https://github.com/$owner/$name" "$checkout"
      sudo chown -R ptc-manager-worker:ptc-manager-repo "$checkout"
      sudo chmod -R g-w,g+rX,o-rwx "$checkout"
      sudo find "$checkout" -type d -exec chmod g+s {} +
    done
}

# ReadWritePaths is additive across drop-ins, so the generated file adds every
# configured repository to what the unit already grants. A leading "-" keeps a
# checkout that disappeared from refusing to start the service.
write_repository_access_dropin() {
  suffix=$1
  target=$2

  {
    printf '# Generated by the PtcManager deployment. Do not edit.\n'
    printf '[Service]\n'
    sudo sqlite3 -readonly "$database_path" <"$repositories_query" |
      while IFS='|' read -r _owner _name checkout; do
        printf 'ReadWritePaths=-%s%s\n' "$checkout" "$suffix"
      done
  } >"$target"
}

busy_agent_count() {
  jq -f "$agent_filter"
}

ensure_no_busy_herdr_agents() {
  manual_session_running=$(
    "$manual_herdr" session list --json |
      jq --arg session "$coordinator_session" \
        '[.sessions[]? | select(.name == $session and .running == true)] | length'
  )

  if [ "$manual_session_running" -gt 0 ]; then
    manual_busy=$(
      "$manual_herdr" --session "$coordinator_session" agent list | busy_agent_count
    )
  else
    manual_busy=0
  fi

  if [ -n "$worker_session" ]; then
    worker_busy=$(
      sudo -u ptc-manager-worker -H "$worker_herdr" --session "$worker_session" agent list |
        busy_agent_count
    )
  else
    worker_busy=0
  fi

  busy_total=$((manual_busy + worker_busy))

  if [ "$busy_total" -ne 0 ]; then
    echo "refusing to deploy while $busy_total Herdr agent(s) are not idle" >&2
    return 1
  fi
}

# A newly granted checkout stays unwritable for the worker until
# ptc_manager-herdr starts again, because ReadWritePaths enters a mount
# namespace only at start. That restart ends every retained agent session, which
# is why a deployment never takes it blindly. When PtcManager records no live
# run and Herdr reports no live agent there is nothing to end, so take it then
# and leave the maintainer only the case where something would actually be lost.
restart_worker_when_nothing_retained() {
  live_runs=$(
    sudo sqlite3 -readonly "$database_path" \
      "select count(*) from agent_runs where state not in ('done', 'failed', 'lost');"
  )

  if [ -n "$worker_session" ]; then
    live_agents=$(
      sudo -u ptc-manager-worker -H "$worker_herdr" --session "$worker_session" agent list |
        jq '[.result.agents[]? | select(.agent_status != "done")] | length'
    )
  else
    live_agents=0
  fi

  if [ "$live_runs" -eq 0 ] && [ "$live_agents" -eq 0 ]; then
    echo "No agent session is retained; linking Herdr $herdr_version and restarting ptc_manager-herdr so granted checkouts become writable"
    herdr_link_backup="/opt/ptc-manager-herdr-previous-${release_id}"
    sudo rm -rf -- "$herdr_link_backup"
    sudo cp -a "$worker_herdr" "$herdr_link_backup"
    sudo ln -sfn "$worker_herdr_dir/herdr" "$worker_herdr"
    sudo systemctl restart ptc_manager-herdr
  else
    echo "Leaving ptc_manager-herdr running: $live_runs live run(s) and $live_agents live agent(s) would be lost. Deploy again when none is retained: a deployment is what moves the link, so restarting the service by hand starts the same Herdr again rather than the pinned $herdr_version, and newly granted checkouts stay unwritable until then."
  fi
}

ensure_private_worktree_root() {
  root=$1

  case "$root" in
    /*) ;;
    *)
      echo "configured worktree root is not absolute: $root" >&2
      return 1
      ;;
  esac

  if sudo test -L "$root" || ! sudo test -d "$root"; then
    echo "configured worktree root must be an existing, non-symlink directory: $root" >&2
    return 1
  fi

  owner_group=$(sudo stat -c '%U:%G' "$root")

  if [ "$owner_group" != "ptc-manager-worker:ptc-manager-repo" ]; then
    echo "configured worktree root has unexpected ownership: $owner_group" >&2
    return 1
  fi

  # The worker owns this directory and creates every checkout through Herdr.
  # The coordinator needs group read/traverse access, but never group write.
  sudo chmod 2750 "$root"

  current=$root
  root_component=true

  while :; do
    if sudo test -L "$current"; then
      echo "worktree ancestor must not be a symlink: $current" >&2
      return 1
    fi

    symbolic_mode=$(sudo stat -c '%A' "$current")
    owner=$(sudo stat -c '%U' "$current")
    group_write=$(printf '%s' "$symbolic_mode" | cut -c 6)
    other_write=$(printf '%s' "$symbolic_mode" | cut -c 9)

    if [ "$group_write" = "w" ] || [ "$other_write" = "w" ]; then
      echo "worktree ancestor is writable by another identity: $current" >&2
      return 1
    fi

    if [ "$root_component" = true ]; then
      expected_owner=ptc-manager-worker
      root_component=false
    else
      expected_owner=root
    fi

    if [ "$owner" != "$expected_owner" ]; then
      echo "worktree ancestor has an untrusted owner: $current" >&2
      return 1
    fi

    [ "$current" = "/" ] && break
    current=$(dirname "$current")
  done
}

# The manifest in the deployed revision is the only place a version of anything
# third party is written, so a program running on this machine can always be
# traced to a commit, and the release compiles the same values in to report what
# the machine actually links.
read_pinned_versions() {
  node_version=$("$toolchain_reader" "$toolchain_manifest" node)
  worker_node_dir="/opt/ptc-manager-node-${node_version}"
  pnpm_version=$("$toolchain_reader" "$toolchain_manifest" pnpm)
  worker_pnpm_dir="/opt/ptc-manager-pnpm-${pnpm_version}"
  codex_version=$("$toolchain_reader" "$toolchain_manifest" codex)
  worker_codex_dir="/opt/ptc-manager-codex-${codex_version}"
  claude_code_version=$("$toolchain_reader" "$toolchain_manifest" claude_code)
  worker_claude_code_dir="/opt/ptc-manager-claude-code-${claude_code_version}"
  cursor_agent_version=$("$toolchain_reader" "$toolchain_manifest" cursor_agent)
  cursor_agent_sha256=$("$toolchain_reader" "$toolchain_manifest" cursor_agent_sha256)
  worker_cursor_agent_dir="/opt/ptc-manager-cursor-agent-${cursor_agent_version}"
  herdr_version=$("$toolchain_reader" "$toolchain_manifest" herdr)
  herdr_protocol=$("$toolchain_reader" "$toolchain_manifest" herdr_protocol)
  herdr_sha256=$("$toolchain_reader" "$toolchain_manifest" herdr_sha256)
  worker_herdr_dir="/opt/ptc-manager-herdr-${herdr_version}"
  case "$herdr_protocol" in
    ''|*[!0-9]*) echo "the Herdr bridge protocol pin is invalid" >&2; return 1 ;;
  esac
  mise_version=$("$toolchain_reader" "$toolchain_manifest" mise)
  mise_sha256=$("$toolchain_reader" "$toolchain_manifest" mise_sha256)
  worker_mise_dir="/opt/ptc-manager-mise-${mise_version}"
  hex_version=$("$toolchain_reader" "$toolchain_manifest" hex)
  rebar3_sha512=$("$toolchain_reader" "$toolchain_manifest" rebar3_sha512)
  erlang_version=$("$toolchain_reader" "$toolchain_manifest" erlang)
  elixir_version=$("$toolchain_reader" "$toolchain_manifest" elixir)
  gate_erlang_dir="$gate_mise_data/installs/erlang/${erlang_version}"
  gate_elixir_dir="$gate_mise_data/installs/elixir/${elixir_version}"
}

# Take ownership of a staged /opt tree and make it traversable before it is
# moved into place. `sudo mktemp -d` creates the staging root 0700 and `cp -a`
# preserves the modes of what it copies rather than the root it copies into, so
# without this the pinned tree is reachable by root alone: the worker cannot run
# the program linked inside it, and the deploying user's own version check globs
# nothing and reports the package as malformed.
root_own_pinned_tree() {
  sudo chown -R root:root "$1"
  sudo chmod 0755 "$1"
}

# Codex and Claude Code both ship as an npm package whose platform dependency
# carries the native binary. Install the pinned version with the pinned Node as
# the deploying user, then copy it into a root-owned directory, the same way the
# worker gets Node and pnpm, so an agent cannot rewrite the CLI it runs.
install_worker_npm_tool() {
  package=$1
  version=$2
  target=$3
  entry_point=$4

  if sudo test -d "$target"; then
    return 0
  fi

  worker_tool_staging=$(mktemp -d "/tmp/ptc-manager-npm-tool-${release_id}.XXXXXX")

  PATH="$worker_node_dir/bin:$PATH" "$worker_node_dir/bin/node" \
    "$worker_node_dir/lib/node_modules/npm/bin/npm-cli.js" install --global \
    --no-fund --no-audit --prefix "$worker_tool_staging" "${package}@${version}" >/dev/null

  if [ ! -x "$worker_tool_staging/$entry_point" ]; then
    echo "installed $package does not provide $entry_point" >&2
    return 1
  fi

  worker_opt_staging=$(sudo mktemp -d "${target}.XXXXXX")
  sudo cp -a "$worker_tool_staging/." "$worker_opt_staging/"
  root_own_pinned_tree "$worker_opt_staging"
  sudo mv "$worker_opt_staging" "$target"
  worker_opt_staging=
  rm -rf -- "$worker_tool_staging"
  worker_tool_staging=
}

install_worker_codex() {
  install_worker_npm_tool @openai/codex "$codex_version" "$worker_codex_dir" bin/codex

  # The package's own entry point is a Node shim around the platform
  # dependency's native binary. Link the binary itself, so a Codex agent does
  # not depend on Node resolving from whatever environment Herdr starts it in,
  # and link it where it stands so it still finds its sidecar alongside.
  set -- "$worker_codex_dir"/lib/node_modules/@openai/codex/node_modules/@openai/codex-linux-x64/vendor/*/bin/codex

  if [ "$#" -ne 1 ] || ! sudo test -x "$1"; then
    echo "pinned Codex package does not contain exactly one native binary" >&2
    return 1
  fi

  if [ "$(sudo -u ptc-manager-worker -H "$1" --version)" != "codex-cli $codex_version" ]; then
    echo "installed Codex has an unexpected version" >&2
    return 1
  fi

  sudo ln -sfn "$1" /usr/local/bin/codex
}

install_worker_claude_code() {
  install_worker_npm_tool @anthropic-ai/claude-code "$claude_code_version" \
    "$worker_claude_code_dir" bin/claude

  claude_binary="$worker_claude_code_dir/bin/claude"
  claude_reported=$(sudo -u ptc-manager-worker -H "$claude_binary" --version)

  if [ "$claude_reported" != "$claude_code_version (Claude Code)" ]; then
    echo "installed Claude Code has an unexpected version: $claude_reported" >&2
    return 1
  fi

  sudo ln -sfn "$claude_binary" /usr/local/bin/claude
}

# The Cursor CLI has no package manager: its installer downloads one versioned
# archive and its own copy is whatever was current that day. Fetch the pinned
# version directly, so the deployment no longer depends on a per-user
# installation someone populated by hand.
install_worker_cursor_agent() {
  cursor_marker="$worker_cursor_agent_dir/.ptc-manager-archive-sha256"

  # An unpacked tree cannot be hashed back into the archive it came from, so the
  # digest that proved it is kept beside it. A tree left by an earlier
  # deployment that did not check one is replaced rather than trusted.
  if [ "$(sudo cat "$cursor_marker" 2>/dev/null)" != "$cursor_agent_sha256" ]; then
    worker_tool_staging=$(mktemp -d "/tmp/ptc-manager-cursor-agent-${release_id}.XXXXXX")
    cursor_archive="$worker_tool_staging/agent-cli-package.tar.gz"

    curl -fsSL -o "$cursor_archive" \
      "https://downloads.cursor.com/lab/${cursor_agent_version}/linux/x64/agent-cli-package.tar.gz"

    # The version an unverified archive reports is the archive's own claim, so
    # the digest has to be proven before anything is unpacked from it.
    if [ "$(sha256sum "$cursor_archive" | cut -d ' ' -f 1)" != "$cursor_agent_sha256" ]; then
      echo "downloaded Cursor CLI archive does not match the sha256 this revision pins" >&2
      return 1
    fi

    tar --strip-components=1 -xzf "$cursor_archive" -C "$worker_tool_staging"
    rm -f -- "$cursor_archive"

    if [ ! -x "$worker_tool_staging/cursor-agent" ]; then
      echo "pinned Cursor CLI archive does not contain cursor-agent" >&2
      return 1
    fi

    printf '%s\n' "$cursor_agent_sha256" >"$worker_tool_staging/.ptc-manager-archive-sha256"

    worker_opt_staging=$(sudo mktemp -d "${worker_cursor_agent_dir}.XXXXXX")
    sudo cp -a "$worker_tool_staging/." "$worker_opt_staging/"
    root_own_pinned_tree "$worker_opt_staging"
    sudo rm -rf -- "$worker_cursor_agent_dir"
    sudo mv "$worker_opt_staging" "$worker_cursor_agent_dir"
    worker_opt_staging=
    rm -rf -- "$worker_tool_staging"
    worker_tool_staging=
  fi

  cursor_binary="$worker_cursor_agent_dir/cursor-agent"

  if [ "$(sudo -u ptc-manager-worker -H "$cursor_binary" --version)" != "$cursor_agent_version" ]; then
    echo "installed Cursor CLI has an unexpected version" >&2
    return 1
  fi

  sudo ln -sfn "$cursor_binary" /usr/local/bin/cursor-agent
}

# Herdr is the one program a deployment cannot swap while it runs: a client
# whose protocol does not match the server breaks the coordinator's view of
# every agent. Install the pinned build and leave the link where it is;
# restart_worker_when_nothing_retained moves it at the one moment the server
# restarts anyway, and until then the console reports the staged version.
install_worker_herdr() {
  if ! sudo test -x "$worker_herdr_dir/herdr"; then
    worker_tool_staging=$(mktemp -d "/tmp/ptc-manager-herdr-${release_id}.XXXXXX")

    curl -fsSL -o "$worker_tool_staging/herdr" \
      "https://github.com/herdrdev/herdr/releases/download/v${herdr_version}/herdr-linux-x86_64"

    if [ "$(sha256sum "$worker_tool_staging/herdr" | cut -d ' ' -f 1)" != "$herdr_sha256" ]; then
      echo "downloaded Herdr does not match the sha256 this revision pins" >&2
      return 1
    fi

    sudo install -d -o root -g root -m 0755 "$worker_herdr_dir"
    sudo install -o root -g root -m 0755 "$worker_tool_staging/herdr" "$worker_herdr_dir/herdr"
    rm -rf -- "$worker_tool_staging"
    worker_tool_staging=
  fi

  # Whatever stands at the pinned path is what a later restart links onto the
  # PATH, including a file an interrupted deployment left there, so prove it on
  # every run rather than only on the run that downloaded it.
  if [ "$(sudo sha256sum "$worker_herdr_dir/herdr" | cut -d ' ' -f 1)" != "$herdr_sha256" ]; then
    echo "installed Herdr does not match the sha256 this revision pins" >&2
    return 1
  fi

  if [ "$(sudo -u ptc-manager-worker -H "$worker_herdr_dir/herdr" --version)" != "herdr $herdr_version" ]; then
    echo "installed Herdr has an unexpected version" >&2
    return 1
  fi

  # The interactive client belongs to the person, not to this deployment, so
  # say when it has drifted rather than change it.
  manual_herdr_version=$("$manual_herdr" --version 2>/dev/null || true)

  if [ "$manual_herdr_version" != "herdr $herdr_version" ]; then
    echo "Note: the interactive Herdr client at $manual_herdr reports \"$manual_herdr_version\" while this revision pins $herdr_version. Run \`herdr update\` as the agent user when convenient."
  fi
}

install_worker_node() {
  "$worker_mise" install "node@${node_version}"
  node_source=$("$worker_mise" where "node@${node_version}")

  case "$node_source" in
    /home/agent/.local/share/mise/installs/node/*) ;;
    *)
      echo "mise returned an unexpected Node installation path: $node_source" >&2
      return 1
      ;;
  esac

  if [ ! -x "$node_source/bin/node" ]; then
    echo "mise-managed Node executable is missing: $node_source/bin/node" >&2
    return 1
  fi

  if ! sudo test -e "$worker_node_dir"; then
    worker_node_staging=$(sudo mktemp -d "/opt/ptc-manager-node-${node_version}.XXXXXX")
    sudo cp -a "$node_source/." "$worker_node_staging/"
    root_own_pinned_tree "$worker_node_staging"

    if [ "$(sudo "$worker_node_staging/bin/node" --version)" != "v${node_version}" ]; then
      echo "staged worker Node runtime has an unexpected version" >&2
      return 1
    fi

    sudo mv "$worker_node_staging" "$worker_node_dir"
    worker_node_staging=
  fi

  if [ "$(sudo "$worker_node_dir/bin/node" --version)" != "v${node_version}" ]; then
    echo "installed worker Node runtime has an unexpected version" >&2
    return 1
  fi

  npm_cli="$worker_node_dir/lib/node_modules/npm/bin/npm-cli.js"
  npx_cli="$worker_node_dir/lib/node_modules/npm/bin/npx-cli.js"
  corepack_cli="$worker_node_dir/lib/node_modules/corepack/dist/corepack.js"

  for executable in "$worker_node_dir/bin/node" "$npm_cli" "$npx_cli" "$corepack_cli"; do
    if ! sudo test -x "$executable"; then
      echo "worker Node command is missing or not executable: $executable" >&2
      return 1
    fi
  done

  sudo ln -sfn "$worker_node_dir/bin/node" /usr/local/bin/node
  sudo ln -sfn "$npm_cli" /usr/local/bin/npm
  sudo ln -sfn "$npx_cli" /usr/local/bin/npx
  sudo ln -sfn "$corepack_cli" /usr/local/bin/corepack

  sudo -u ptc-manager-worker -H /usr/local/bin/node --version >/dev/null
  sudo -u ptc-manager-worker -H /usr/local/bin/npm --version >/dev/null
  sudo -u ptc-manager-worker -H /usr/local/bin/npx --version >/dev/null
  sudo -u ptc-manager-worker -H /usr/local/bin/corepack --version >/dev/null
}

# pnpm links a worktree's node_modules into a shared content-addressed store
# rather than copying a tree into each one, which is the only way a package cache
# can be shared while no agent writes into another's workspace. The worker gets
# it the way it gets Node: installed by mise as the deploying user, copied to a
# root-owned directory, version-checked, and linked, so an agent cannot rewrite
# its own toolchain.
install_worker_pnpm() {
  "$worker_mise" install "pnpm@${pnpm_version}"
  pnpm_source=$("$worker_mise" where "pnpm@${pnpm_version}")

  case "$pnpm_source" in
    /home/agent/.local/share/mise/installs/pnpm/*) ;;
    *)
      echo "mise returned an unexpected pnpm installation path: $pnpm_source" >&2
      return 1
      ;;
  esac

  if [ ! -x "$pnpm_source/pnpm" ]; then
    echo "mise-managed pnpm executable is missing: $pnpm_source/pnpm" >&2
    return 1
  fi

  if ! sudo test -e "$worker_pnpm_dir"; then
    worker_pnpm_staging=$(sudo mktemp -d "/opt/ptc-manager-pnpm-${pnpm_version}.XXXXXX")
    sudo cp -a "$pnpm_source/." "$worker_pnpm_staging/"
    root_own_pinned_tree "$worker_pnpm_staging"

    if [ "$(sudo "$worker_pnpm_staging/pnpm" --version)" != "$pnpm_version" ]; then
      echo "staged worker pnpm has an unexpected version" >&2
      return 1
    fi

    sudo mv "$worker_pnpm_staging" "$worker_pnpm_dir"
    worker_pnpm_staging=
  fi

  if [ "$(sudo "$worker_pnpm_dir/pnpm" --version)" != "$pnpm_version" ]; then
    echo "installed worker pnpm has an unexpected version" >&2
    return 1
  fi

  sudo ln -sfn "$worker_pnpm_dir/pnpm" /usr/local/bin/pnpm

  # pnpm walks upward from the working directory looking for workspace and
  # config files. The deployment runs from the deploying user's home, which the
  # worker cannot read, so prove the command from a directory it can: an agent
  # only ever runs pnpm inside its own worktree.
  sudo -u ptc-manager-worker -H sh -c 'cd / && /usr/local/bin/pnpm --version' >/dev/null
}

# A repository's own bootstrap script runs the worker's mise to install its
# toolchain, so it is a program on the machine like any other rather than a copy
# of whatever the deploying user happens to have installed that week.
install_worker_mise() {
  if ! sudo test -f "$worker_mise_dir/mise"; then
    worker_tool_staging=$(mktemp -d "/tmp/ptc-manager-mise-${release_id}.XXXXXX")

    curl -fsSL -o "$worker_tool_staging/mise" \
      "https://github.com/jdx/mise/releases/download/v${mise_version}/mise-v${mise_version}-linux-x64"

    if [ "$(sha256sum "$worker_tool_staging/mise" | cut -d ' ' -f 1)" != "$mise_sha256" ]; then
      echo "downloaded mise does not match the sha256 this revision pins" >&2
      return 1
    fi

    sudo install -d -o root -g root -m 0755 "$worker_mise_dir"
    sudo install -o root -g root -m 0755 "$worker_tool_staging/mise" "$worker_mise_dir/mise"
    rm -rf -- "$worker_tool_staging"
    worker_tool_staging=
  fi

  if [ "$(sudo sha256sum "$worker_mise_dir/mise" | cut -d ' ' -f 1)" != "$mise_sha256" ]; then
    echo "installed mise does not match the sha256 this revision pins" >&2
    return 1
  fi

  sudo ln -sfn "$worker_mise_dir/mise" "$worker_mise"

  installed_mise=$(sudo -u ptc-manager-worker -H "$worker_mise" --version | cut -d ' ' -f 1)

  if [ "$installed_mise" != "$mise_version" ]; then
    echo "installed mise has an unexpected version: $installed_mise" >&2
    return 1
  fi
}

gate_mix() {
  sudo env -i HOME="$gate_tool_home" MIX_HOME="$gate_mix_home" \
    PATH="$gate_elixir_dir/bin:$gate_erlang_dir/bin:/usr/bin:/bin" LC_ALL=C \
    "$gate_elixir_dir/bin/mix" "$@"
}

# Mix keeps one Rebar per Elixir series under a directory it names after the
# series, so the digest has to come from the series this revision pins. A copy
# left by an older series would otherwise answer for one that has none.
gate_rebar_series() {
  series=$(printf '%s' "$elixir_version" |
    sed 's/^\([0-9][0-9]*\)\.\([0-9][0-9]*\)\.[0-9][0-9]*-otp-\([0-9][0-9]*\)$/\1-\2-otp-\3/')

  case "$series" in
    *[!0-9a-z-]*|*.*|'')
      echo "pinned Elixir version does not name a Mix series: $elixir_version" >&2
      return 1
      ;;
  esac

  printf '%s' "$series"
}

gate_rebar_digest() {
  sudo sha512sum "$gate_mix_home/elixir/$1/rebar3" 2>/dev/null | cut -d ' ' -f 1
}

install_gate_beam_toolchain() {
  sudo install -d -o root -g root -m 0755 "$gate_mise_root" "$gate_mise_data" \
    "$gate_mise_cache" "$gate_mise_state" "$gate_mise_config"

  sudo env -i HOME=/root PATH=/usr/local/bin:/usr/bin:/bin \
    MISE_DATA_DIR="$gate_mise_data" MISE_CACHE_DIR="$gate_mise_cache" \
    MISE_STATE_DIR="$gate_mise_state" MISE_CONFIG_DIR="$gate_mise_config" \
    "$worker_mise" install "erlang@${erlang_version}" "elixir@${elixir_version}"

  installed_erlang=$(sudo env -i HOME=/root PATH=/usr/local/bin:/usr/bin:/bin \
    MISE_DATA_DIR="$gate_mise_data" MISE_CACHE_DIR="$gate_mise_cache" \
    MISE_STATE_DIR="$gate_mise_state" MISE_CONFIG_DIR="$gate_mise_config" \
    "$worker_mise" where "erlang@${erlang_version}")
  installed_elixir=$(sudo env -i HOME=/root PATH=/usr/local/bin:/usr/bin:/bin \
    MISE_DATA_DIR="$gate_mise_data" MISE_CACHE_DIR="$gate_mise_cache" \
    MISE_STATE_DIR="$gate_mise_state" MISE_CONFIG_DIR="$gate_mise_config" \
    "$worker_mise" where "elixir@${elixir_version}")

  if [ "$installed_erlang" != "$gate_erlang_dir" ] ||
    [ "$installed_elixir" != "$gate_elixir_dir" ]; then
    echo "gate BEAM toolchain was installed outside its root-owned prefix" >&2
    return 1
  fi

  for executable in "$gate_erlang_dir/bin/erl" "$gate_erlang_dir/bin/erlc" \
    "$gate_erlang_dir/bin/escript" "$gate_elixir_dir/bin/elixir" \
    "$gate_elixir_dir/bin/elixirc" "$gate_elixir_dir/bin/iex" "$gate_elixir_dir/bin/mix"; do
    if ! sudo test -x "$executable"; then
      echo "gate BEAM command is missing or not executable: $executable" >&2
      return 1
    fi
  done

  if ! sudo find "$gate_erlang_dir" "$gate_elixir_dir" -type l -print |
    while IFS= read -r link; do
      target=$(sudo readlink -f "$link")
      case "$target" in
        "$gate_mise_root"/*) ;;
        *)
          echo "gate toolchain symlink escapes its root-owned prefix: $link" >&2
          exit 1
          ;;
      esac
    done; then
    return 1
  fi

  sudo install -d -o root -g root -m 0755 "$gate_mix_home"

  gate_tool_home=$(sudo mktemp -d /tmp/ptc-manager-gate-toolchain.XXXXXX)

  if ! sudo test -d "$gate_mix_home/archives/hex-${hex_version}"; then
    gate_mix local.hex "$hex_version" --force
  fi

  # Mix runs the newest archive it finds, so the pinned one is the only one that
  # stays.
  if sudo test -d "$gate_mix_home/archives"; then
    sudo find "$gate_mix_home/archives" -mindepth 1 -maxdepth 1 -name 'hex-*' \
      ! -name "hex-${hex_version}" -exec rm -rf -- {} +
  fi

  if ! sudo test -d "$gate_mix_home/archives/hex-${hex_version}"; then
    echo "the gate does not have the Hex version this revision pins" >&2
    return 1
  fi

  # Rebar has no version to ask for, and mix installs a mismatched --sha512
  # anyway once --force is given, so the digest of what landed is the check.
  rebar_series=$(gate_rebar_series)

  if sudo test -d "$gate_mix_home/elixir"; then
    sudo find "$gate_mix_home/elixir" -mindepth 1 -maxdepth 1 ! -name "$rebar_series" \
      -exec rm -rf -- {} +
  fi

  if [ "$(gate_rebar_digest "$rebar_series")" != "$rebar3_sha512" ]; then
    gate_mix local.rebar --force
  fi

  if [ "$(gate_rebar_digest "$rebar_series")" != "$rebar3_sha512" ]; then
    echo "the Rebar the gate installed for Elixir $rebar_series does not match the sha512 this revision pins" >&2
    return 1
  fi

  sudo rm -rf -- "$gate_tool_home"
  gate_tool_home=

  sudo chown -R root:root "$gate_mise_root" "$gate_mix_home"
  sudo chmod -R a+rX,go-w "$gate_mise_root" "$gate_mix_home"

  if ! sudo find "$gate_mix_home/archives" -maxdepth 1 -type d -name 'hex-*' \
    -print -quit | grep -q .; then
    echo "gate Mix home does not contain a Hex archive" >&2
    return 1
  fi

  if ! sudo find "$gate_mix_home" -type f -name rebar3 -perm -u+x -print -quit | grep -q .; then
    echo "gate Mix home does not contain an executable rebar3" >&2
    return 1
  fi

  for command in erl erlc escript; do
    sudo ln -sfn "$gate_erlang_dir/bin/$command" "/usr/local/bin/$command"
  done

  for command in elixir elixirc iex mix; do
    sudo ln -sfn "$gate_elixir_dir/bin/$command" "/usr/local/bin/$command"
  done

  sudo -u ptc-manager-gate env -i HOME=/var/lib/ptc_manager-gate \
    MIX_HOME="$gate_mix_home" PATH=/usr/local/bin:/usr/bin:/bin LC_ALL=C \
    /bin/sh -c 'cd /var/lib/ptc_manager-gate && exec /usr/local/bin/mix --version' >/dev/null
  sudo -u ptc-manager-gate env -i HOME=/var/lib/ptc_manager-gate \
    MIX_HOME="$gate_mix_home" PATH=/usr/local/bin:/usr/bin:/bin LC_ALL=C \
    /bin/sh -c 'cd /var/lib/ptc_manager-gate && exec /usr/local/bin/mix help hex' >/dev/null
}

prune_successful_backups() {
  sudo find /opt -maxdepth 1 -type d -name 'ptc_manager-before-*' -printf '%T@ %p\n' |
    sort -nr |
    awk 'NR > 3 {print $2}' |
    while IFS= read -r old_release; do
      case "$old_release" in
        /opt/ptc_manager-before-*) ;;
        *) continue ;;
      esac

      old_release_id=${old_release#/opt/ptc_manager-before-}
      old_database_backup="${database_path}-before-${old_release_id}"
      sudo rm -rf -- "$old_release"
      sudo rm -f -- "$old_database_backup"
    done
}

# A deployment that goes back to the previous release has to go back to the
# Herdr that release was built against. The coordinator reaches the server
# through this link, so leaving a newer one behind pairs an old coordinator with
# a protocol it does not expect, which is the mismatch the deferred link exists
# to prevent.
restore_worker_herdr() {
  [ -n "$herdr_link_backup" ] || return 0

  if ! sudo test -L "$herdr_link_backup" && ! sudo test -e "$herdr_link_backup"; then
    return 0
  fi

  echo "Restoring the Herdr this release was deployed against." >&2

  # This function is always called where its result is tested, which switches
  # `set -e` off for its body, so every step has to report for itself. Ending on
  # a command that cannot fail would let a rollback call itself healthy while
  # the link is missing and cleanup removes the only copy of what it replaced.
  restore_status=0
  sudo rm -f -- "$worker_herdr" || restore_status=1
  sudo cp -a "$herdr_link_backup" "$worker_herdr" || restore_status=1
  sudo systemctl restart ptc_manager-herdr || restore_status=1

  if [ "$restore_status" -ne 0 ]; then
    herdr_link_backup_retained=true
    echo "The Herdr this release was deployed against is kept at $herdr_link_backup; put it back at $worker_herdr by hand." >&2
  fi

  return "$restore_status"
}

backup_health_snapshot_file() {
  snapshot_file=$1
  snapshot_backup_name=$2

  if sudo test -e "$snapshot_file" || sudo test -L "$snapshot_file"; then
    sudo cp -a "$snapshot_file" "$health_snapshot_backup/$snapshot_backup_name"
  fi
}

backup_health_snapshot_installation() {
  sudo install -d -o root -g root -m 0700 "$health_snapshot_backup"

  if sudo systemctl is-enabled --quiet ptc_manager-health-snapshot.timer; then
    health_snapshot_timer_was_enabled=true
  fi

  if sudo systemctl is-active --quiet ptc_manager-health-snapshot.timer; then
    health_snapshot_timer_was_active=true
  fi

  if sudo systemctl is-active --quiet ptc_manager-health-snapshot.service; then
    health_snapshot_service_was_active=true
  fi

  backup_health_snapshot_file /usr/local/bin/ptc-manager-health-snapshot writer
  backup_health_snapshot_file /etc/systemd/system/ptc_manager-health-snapshot.service service
  backup_health_snapshot_file /etc/systemd/system/ptc_manager-health-snapshot.timer timer
  backup_health_snapshot_file /etc/ptc_manager/health-snapshot.env environment
  health_snapshot_installation_prepared=true

  if [ "$health_snapshot_timer_was_active" = true ]; then
    sudo systemctl stop ptc_manager-health-snapshot.timer
  fi

  # A timer-triggered oneshot must finish before its executable and unit are
  # replaced. Otherwise deployment verification could observe its output and
  # never exercise the collector from the revision being deployed.
  health_snapshot_service_load_state=$(
    sudo systemctl show --property=LoadState --value ptc_manager-health-snapshot.service
  )

  if [ "$health_snapshot_service_load_state" != not-found ]; then
    sudo systemctl stop ptc_manager-health-snapshot.service
  fi
}

restore_health_snapshot_file() {
  snapshot_file=$1
  snapshot_backup_name=$2

  sudo rm -f -- "$snapshot_file" || return 1

  if sudo test -e "$health_snapshot_backup/$snapshot_backup_name" ||
    sudo test -L "$health_snapshot_backup/$snapshot_backup_name"; then
    sudo cp -a "$health_snapshot_backup/$snapshot_backup_name" "$snapshot_file" || return 1
  fi
}

restore_health_snapshot_installation() {
  [ "$health_snapshot_installation_prepared" = true ] || return 0

  echo "Restoring the previous health snapshot collector." >&2
  restore_status=0
  if sudo systemctl is-active --quiet ptc_manager-health-snapshot.timer; then
    sudo systemctl stop ptc_manager-health-snapshot.timer || restore_status=1
  fi

  if sudo systemctl is-enabled --quiet ptc_manager-health-snapshot.timer; then
    sudo systemctl disable ptc_manager-health-snapshot.timer || restore_status=1
  fi

  restore_health_snapshot_file /usr/local/bin/ptc-manager-health-snapshot writer || restore_status=1
  restore_health_snapshot_file /etc/systemd/system/ptc_manager-health-snapshot.service service || restore_status=1
  restore_health_snapshot_file /etc/systemd/system/ptc_manager-health-snapshot.timer timer || restore_status=1
  restore_health_snapshot_file /etc/ptc_manager/health-snapshot.env environment || restore_status=1
  sudo systemctl daemon-reload || restore_status=1

  if [ "$health_snapshot_timer_was_enabled" = true ]; then
    sudo systemctl enable ptc_manager-health-snapshot.timer || restore_status=1
  fi

  if [ "$health_snapshot_timer_was_active" = true ]; then
    sudo systemctl start ptc_manager-health-snapshot.timer || restore_status=1
  fi

  if [ "$health_snapshot_service_was_active" = true ]; then
    sudo systemctl start ptc_manager-health-snapshot.service || restore_status=1
  fi

  if [ "$restore_status" -ne 0 ]; then
    health_snapshot_backup_retained=true
    echo "The previous health snapshot collector is kept at $health_snapshot_backup; restore it before deploying again." >&2
  fi

  return "$restore_status"
}

rollback() {
  deployment_phase=handling_failure
  rollback_status=0
  echo "New release did not become healthy; restoring the previous release and database." >&2
  sudo systemctl stop "$service_name" || rollback_status=1

  if [ -d "$release_backup" ]; then
    if [ -d "$application_dir" ]; then
      sudo mv "$application_dir" "$failed_release" || rollback_status=1
    fi

    sudo mv "$release_backup" "$application_dir" || rollback_status=1
  elif [ ! -d "$application_dir" ]; then
    rollback_status=1
  fi

  if [ -f "$database_path" ]; then
    sudo mv "$database_path" "$failed_database" || rollback_status=1
  fi

  if [ -f "${database_path}-wal" ]; then
    sudo mv "${database_path}-wal" "${failed_database}-wal" || rollback_status=1
  fi

  if [ -f "${database_path}-shm" ]; then
    sudo mv "${database_path}-shm" "${failed_database}-shm" || rollback_status=1
  fi

  sudo install -o ptc-manager -g ptc-manager -m 0600 "$database_backup" "$database_path" ||
    rollback_status=1
  restore_worker_herdr || rollback_status=1
  restore_preexisting_maintenance_override || rollback_status=1
  restore_health_snapshot_installation || rollback_status=1
  sudo systemctl start "$service_name" || rollback_status=1

  if [ "$rollback_status" -eq 0 ] && legacy_health_check; then
    echo "Rollback succeeded. Failed artifacts were retained with suffix ${release_id}." >&2
  else
    echo "Rollback did not restore service health; inspect systemd immediately." >&2
  fi
}

finish() {
  exit_status=$?
  trap - EXIT HUP INT TERM
  failure_action=$("$failure_policy" "$deployment_phase")

  case "$failure_action" in
    preserve_current)
      deployment_phase=handling_failure
      install_maintenance_override || true

      if ! pause_new_release; then
        sudo systemctl restart "$service_name" || true
      fi

      echo "Deployment stopped after the canary effect boundary; the new release and current database remain in maintenance mode for forward repair." >&2
      ;;
    restore_snapshot)
      rollback
      ;;
    restart_existing)
      deployment_phase=handling_failure
      echo "Deployment stopped before the release swap; restarting the existing release." >&2
      restore_worker_herdr ||
        echo "Restoring the previous Herdr failed; check $worker_herdr and ptc_manager-herdr before deploying again." >&2
      restore_preexisting_maintenance_override || true
      restore_health_snapshot_installation || true
      sudo systemctl start "$service_name" || true
      ;;
    no_action)
      if [ "$exit_status" -ne 0 ] && [ "$deployment_phase" = pre_stop ] &&
        [ "$health_snapshot_installation_prepared" = true ]; then
        restore_health_snapshot_installation || true
      fi
      ;;
  esac

  cleanup_remote
  exit "$exit_status"
}
