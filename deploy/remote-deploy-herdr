sudo install -o root -g root -m 0644 "$repositories_query" \
  /usr/local/libexec/ptc-manager-configured-repositories.sql
sudo install -o root -g root -m 0440 "$sudoers_candidate" \
  /etc/sudoers.d/ptc_manager

# Exercise the real SSH forced-command path during every deployment. The
# loopback-only key can reach only the bridge and is unreadable outside root.
if ! sudo test -f "$herdr_bridge_canary_key"; then
  sudo ssh-keygen -q -t ed25519 -N '' -C ptc-manager-herdr-canary \
    -f "$herdr_bridge_canary_key"
fi
sudo chown root:root "$herdr_bridge_canary_key" "$herdr_bridge_canary_key.pub"
sudo chmod 0600 "$herdr_bridge_canary_key"
sudo chmod 0644 "$herdr_bridge_canary_key.pub"
bridge_canary_public_key=$(sudo cat "$herdr_bridge_canary_key.pub")
case "$bridge_canary_public_key" in
  'ssh-ed25519 '*" ptc-manager-herdr-canary") ;;
  *) echo "invalid Herdr bridge canary public key" >&2; exit 1 ;;
esac
if sudo test -L /home/agent/.ssh || sudo test -L /home/agent/.ssh/authorized_keys; then
  echo "agent SSH authorization paths must not be symlinks" >&2
  exit 1
fi
sudo install -d -o agent -g agent -m 0700 /home/agent/.ssh
authorized_keys_candidate=$(mktemp "/tmp/ptc-manager-authorized-keys-${release_id}.XXXXXX")
if sudo test -f /home/agent/.ssh/authorized_keys; then
  sudo grep -v ' ptc-manager-herdr-canary$' /home/agent/.ssh/authorized_keys >"$authorized_keys_candidate" || true
fi
printf '%s\n' \
  "from=\"127.0.0.1\",restrict,command=\"/usr/local/bin/ptc-manager-herdr-ssh-bridge\" $bridge_canary_public_key" \
  >>"$authorized_keys_candidate"
sudo install -o agent -g agent -m 0600 "$authorized_keys_candidate" /home/agent/.ssh/authorized_keys
rm -f -- "$authorized_keys_candidate"
known_hosts_candidate=$(mktemp "/tmp/ptc-manager-known-hosts-${release_id}.XXXXXX")
for host_key in /etc/ssh/ssh_host_*_key.pub; do
  sudo awk '{print "ptc-manager-herdr-canary " $1 " " $2}' "$host_key" >>"$known_hosts_candidate"
done
sudo install -o root -g root -m 0644 "$known_hosts_candidate" /etc/ptc_manager/herdr-bridge-known-hosts
rm -f -- "$known_hosts_candidate"
sudo install -d -o root -g root -m 0755 /etc/ssh/ssh_config.d
printf '%s\n' \
  'Host ptc-manager-herdr-canary' \
  '  HostName 127.0.0.1' \
  '  User agent' \
  "  IdentityFile $herdr_bridge_canary_key" \
  '  IdentitiesOnly yes' \
  '  BatchMode yes' \
  '  StrictHostKeyChecking yes' \
  '  HostKeyAlias ptc-manager-herdr-canary' \
  '  UserKnownHostsFile /etc/ptc_manager/herdr-bridge-known-hosts' |
  sudo tee "$herdr_bridge_canary_ssh_config" >/dev/null
sudo chown root:root "$herdr_bridge_canary_ssh_config"
sudo chmod 0644 "$herdr_bridge_canary_ssh_config"

if ! getent group ptc-manager-deploy >/dev/null; then
  sudo groupadd --system ptc-manager-deploy
fi
sudo usermod -a -G ptc-manager-deploy ptc-manager
sudo usermod -a -G ptc-manager-deploy agent
sudo install -d -o ptc-manager -g ptc-manager-deploy -m 2770 /var/lib/ptc_manager-deploy
sudo install -o root -g root -m 0755 "$self_deploy_runner_candidate" \
  /usr/local/bin/ptc-manager-self-deploy-runner
sudo install -o root -g root -m 0644 "$self_deploy_service_candidate" \
  /etc/systemd/system/ptc-manager-self-deploy.service
sudo install -d -o root -g root -m 0755 /etc/systemd/system/ptc_manager.service.d
sudo install -o root -g root -m 0644 "$self_deploy_access_candidate" \
  /etc/systemd/system/ptc_manager.service.d/zz-ptc-manager-self-deploy-access.conf
backup_health_snapshot_installation
sudo install -o root -g root -m 0755 "$health_snapshot_candidate" \
  /usr/local/bin/ptc-manager-health-snapshot
sudo install -o root -g root -m 0644 "$health_snapshot_service_candidate" \
  /etc/systemd/system/ptc_manager-health-snapshot.service
sudo install -o root -g root -m 0644 "$health_snapshot_timer_candidate" \
