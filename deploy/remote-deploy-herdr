#!/bin/sh
set -eu

release_id=${1:-}
source_archive=${2:-}
failure_policy=${3:-}

case "$release_id" in
  *[!A-Za-z0-9.-]*|'')
    echo "invalid release id" >&2
    exit 2
    ;;
esac

case "$source_archive" in
  /tmp/ptc-manager-*.tar) ;;
  *)
    echo "invalid source archive path" >&2
    exit 2
    ;;
esac

case "$failure_policy" in
  /tmp/ptc-manager-failure-policy-*) ;;
  *)
    echo "invalid deployment failure policy path" >&2
    exit 2
    ;;
esac

service_name=ptc_manager
application_dir=/opt/ptc_manager
build_dir="/home/agent/src/ptc_manager-build-${release_id}"
new_release="$build_dir/_build/prod/rel/ptc_manager"
release_backup="/opt/ptc_manager-before-${release_id}"
failed_release="/opt/ptc_manager-failed-${release_id}"
database_path=
database_backup=
failed_database=
health_url=
maintenance_override=/etc/systemd/system/ptc_manager.service.d/90-ptc-manager-deploy-maintenance.conf
maintenance_override_backup="/etc/systemd/system/ptc_manager.service.d/.ptc-manager-maintenance-${release_id}.backup"
maintenance_override_preexisting=false
agent_result_dir=/var/lib/ptc_manager-worker/agent-results
agent_result_env=/etc/ptc_manager/agent-results.env
agent_result_override=/etc/systemd/system/ptc_manager.service.d/zz-ptc-manager-agent-results.conf
mise_binary=/home/agent/.local/bin/mise
worker_mise=/usr/local/bin/mise
node_version=22.23.2
worker_node_dir="/opt/ptc-manager-node-${node_version}"
worker_node_staging=
production_workspace_cache=/home/agent/.cache/ptc-manager/workspaces
erlang_version=29.0.3
elixir_version=1.20.2-otp-29
gate_mise_root=/opt/ptc-manager-gate-mise
gate_mise_data="$gate_mise_root/data"
gate_mise_cache="$gate_mise_root/cache"
gate_mise_state="$gate_mise_root/state"
gate_mise_config="$gate_mise_root/config"
gate_erlang_dir="$gate_mise_data/installs/erlang/${erlang_version}"
gate_elixir_dir="$gate_mise_data/installs/elixir/${elixir_version}"
gate_mix_home=/opt/ptc-manager-gate-mix
gate_tool_home=
manual_herdr=/home/agent/.local/bin/herdr
worker_herdr=/usr/local/bin/herdr
agent_filter="/tmp/ptc-manager-agent-filter-${release_id}.jq"
environment_file_parser="/tmp/ptc-manager-environment-files-${release_id}.awk"
worker_git_candidate="/tmp/ptc-manager-worker-git-${release_id}"
sudoers_candidate="/tmp/ptc-manager-sudoers-${release_id}"
coordinator_environment_files=
coordinator_session=
worker_session=
worktree_root=
remote_script=$0
deployment_phase=pre_stop

cleanup_remote() {
  rm -f -- "$source_archive" "$remote_script" "$failure_policy" "$agent_filter" "$environment_file_parser" \
    "$worker_git_candidate" "$sudoers_candidate"
  sudo rm -f -- "$maintenance_override_backup"

  case "$build_dir" in
    /home/agent/src/ptc_manager-build-*) rm -rf -- "$build_dir" ;;
  esac

  case "$worker_node_staging" in
    /opt/ptc-manager-node-*) sudo rm -rf -- "$worker_node_staging" ;;
  esac

  case "$gate_tool_home" in
    /tmp/ptc-manager-gate-toolchain.*) sudo rm -rf -- "$gate_tool_home" ;;
  esac
}

health_check() {
  expected_mode=$1
  attempt=1

  while [ "$attempt" -le 30 ]; do
    if curl -fsS "$health_url" |
      jq -e --arg mode "$expected_mode" \
        '.status == "ok" and .operational_mode == $mode' >/dev/null; then
      return 0
    fi

    sleep 1
    attempt=$((attempt + 1))
  done

  return 1
}

legacy_health_check() {
  attempt=1

  while [ "$attempt" -le 30 ]; do
    if curl -fsS -o /dev/null "http://127.0.0.1:${health_port}/"; then
      return 0
    fi

    sleep 1
    attempt=$((attempt + 1))
  done

  return 1
}

install_maintenance_override() {
  capture_maintenance_override

  sudo install -d -o root -g root -m 0755 "$(dirname "$maintenance_override")"
  printf '%s\n' '[Service]' 'Environment=PTC_OPERATIONAL_MODE=maintenance' |
    sudo tee "$maintenance_override" >/dev/null
  sudo chmod 0644 "$maintenance_override"
  sudo systemctl daemon-reload
}

capture_maintenance_override() {
  sudo install -d -o root -g root -m 0755 "$(dirname "$maintenance_override")"

  if sudo test -L "$maintenance_override"; then
    echo "maintenance override must not be a symlink: $maintenance_override" >&2
    return 1
  fi

  if sudo test -f "$maintenance_override" && [ "$maintenance_override_preexisting" = false ]; then
    if sudo test -e "$maintenance_override_backup"; then
      echo "maintenance override backup already exists: $maintenance_override_backup" >&2
      return 1
    fi

    sudo install -o root -g root -m 0600 "$maintenance_override" "$maintenance_override_backup"
    maintenance_override_preexisting=true
  fi
}

remove_maintenance_override() {
  sudo rm -f -- "$maintenance_override"
  sudo systemctl daemon-reload
}

restore_preexisting_maintenance_override() {
  if [ "$maintenance_override_preexisting" = true ]; then
    sudo install -o root -g root -m 0644 "$maintenance_override_backup" "$maintenance_override"
  else
    sudo rm -f -- "$maintenance_override"
  fi

  sudo systemctl daemon-reload
}

pause_new_release() {
  sudo -u ptc-manager -H "$application_dir/bin/ptc_manager" rpc \
    'PtcManager.OperationalMode.enter_maintenance()' >/dev/null
}

read_process_setting() {
  process_id=$1
  setting_name=$2
  default_value=$3
  setting_value=$(
    sudo cat "/proc/${process_id}/environ" |
      tr '\000' '\n' |
      awk -F= -v setting="$setting_name" '
        $1 == setting {
          sub(/^[^=]*=/, "")
          print
          found = 1
          exit
        }
        END { if (!found) print "" }
      '
  )

  if [ -n "$setting_value" ]; then
    printf '%s\n' "$setting_value"
  else
    printf '%s\n' "$default_value"
  fi
}

read_environment_setting() {
  setting_name=$1
  shift

  sudo awk -v setting="$setting_name" '
    /^[[:space:]]*($|#)/ { next }
    {
      equals = index($0, "=")
      if (equals == 0) next

      key = substr($0, 1, equals - 1)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)

      if (key == setting) {
        value = substr($0, equals + 1)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)

        if ((value ~ /^".*"$/) || (value ~ /^\047.*\047$/)) {
          value = substr(value, 2, length(value) - 2)
        }

        result = value
      }
    }
    END { print result }
  ' "$@"
}

active_managed_runs() {
  sudo sqlite3 -readonly "$database_path" \
    "select count(*) from agent_runs where state in ('queued','starting','working','blocked','unknown');"
}

ensure_no_managed_runs() {
  active_runs=$(active_managed_runs)

  if [ "$active_runs" -ne 0 ]; then
    echo "refusing to deploy while $active_runs managed agent run(s) are active" >&2
    return 1
  fi
}

busy_agent_count() {
  jq -f "$agent_filter"
}

ensure_no_busy_herdr_agents() {
  manual_session_running=$(
    "$manual_herdr" session list --json |
      jq --arg session "$coordinator_session" \
        '[.sessions[]? | select(.name == $session and .running == true)] | length'
  )

  if [ "$manual_session_running" -gt 0 ]; then
    manual_busy=$(
      "$manual_herdr" --session "$coordinator_session" agent list | busy_agent_count
    )
  else
    manual_busy=0
  fi

  if [ -n "$worker_session" ]; then
    worker_busy=$(
      sudo -u ptc-manager-worker -H "$worker_herdr" --session "$worker_session" agent list |
        busy_agent_count
    )
  else
    worker_busy=0
  fi

  busy_total=$((manual_busy + worker_busy))

  if [ "$busy_total" -ne 0 ]; then
    echo "refusing to deploy while $busy_total Herdr agent(s) are not idle" >&2
    return 1
  fi
}

ensure_private_worktree_root() {
  root=$1

  case "$root" in
    /*) ;;
    *)
      echo "configured worktree root is not absolute: $root" >&2
      return 1
      ;;
  esac

  if sudo test -L "$root" || ! sudo test -d "$root"; then
    echo "configured worktree root must be an existing, non-symlink directory: $root" >&2
    return 1
  fi

  owner_group=$(sudo stat -c '%U:%G' "$root")

  if [ "$owner_group" != "ptc-manager-worker:ptc-manager-repo" ]; then
    echo "configured worktree root has unexpected ownership: $owner_group" >&2
    return 1
  fi

  # The worker owns this directory and creates every checkout through Herdr.
  # The coordinator needs group read/traverse access, but never group write.
  sudo chmod 2750 "$root"

  current=$root
  root_component=true

  while :; do
    if sudo test -L "$current"; then
      echo "worktree ancestor must not be a symlink: $current" >&2
      return 1
    fi

    symbolic_mode=$(sudo stat -c '%A' "$current")
    owner=$(sudo stat -c '%U' "$current")
    group_write=$(printf '%s' "$symbolic_mode" | cut -c 6)
    other_write=$(printf '%s' "$symbolic_mode" | cut -c 9)

    if [ "$group_write" = "w" ] || [ "$other_write" = "w" ]; then
      echo "worktree ancestor is writable by another identity: $current" >&2
      return 1
    fi

    if [ "$root_component" = true ]; then
      expected_owner=ptc-manager-worker
      root_component=false
    else
      expected_owner=root
    fi

    if [ "$owner" != "$expected_owner" ]; then
      echo "worktree ancestor has an untrusted owner: $current" >&2
      return 1
    fi

    [ "$current" = "/" ] && break
    current=$(dirname "$current")
  done
}

install_worker_node() {
  node_source=$("$mise_binary" where "node@${node_version}")

  case "$node_source" in
    /home/agent/.local/share/mise/installs/node/*) ;;
    *)
      echo "mise returned an unexpected Node installation path: $node_source" >&2
      return 1
      ;;
  esac

  if [ ! -x "$node_source/bin/node" ]; then
    echo "mise-managed Node executable is missing: $node_source/bin/node" >&2
    return 1
  fi

  if ! sudo test -e "$worker_node_dir"; then
    worker_node_staging=$(sudo mktemp -d "/opt/ptc-manager-node-${node_version}.XXXXXX")
    sudo cp -a "$node_source/." "$worker_node_staging/"
    sudo chown -R root:root "$worker_node_staging"

    if [ "$(sudo "$worker_node_staging/bin/node" --version)" != "v${node_version}" ]; then
      echo "staged worker Node runtime has an unexpected version" >&2
      return 1
    fi

    sudo mv "$worker_node_staging" "$worker_node_dir"
    worker_node_staging=
  fi

  if [ "$(sudo "$worker_node_dir/bin/node" --version)" != "v${node_version}" ]; then
    echo "installed worker Node runtime has an unexpected version" >&2
    return 1
  fi

  npm_cli="$worker_node_dir/lib/node_modules/npm/bin/npm-cli.js"
  npx_cli="$worker_node_dir/lib/node_modules/npm/bin/npx-cli.js"
  corepack_cli="$worker_node_dir/lib/node_modules/corepack/dist/corepack.js"

  for executable in "$worker_node_dir/bin/node" "$npm_cli" "$npx_cli" "$corepack_cli"; do
    if ! sudo test -x "$executable"; then
      echo "worker Node command is missing or not executable: $executable" >&2
      return 1
    fi
  done

  sudo ln -sfn "$worker_node_dir/bin/node" /usr/local/bin/node
  sudo ln -sfn "$npm_cli" /usr/local/bin/npm
  sudo ln -sfn "$npx_cli" /usr/local/bin/npx
  sudo ln -sfn "$corepack_cli" /usr/local/bin/corepack

  sudo -u ptc-manager-worker -H /usr/local/bin/node --version >/dev/null
  sudo -u ptc-manager-worker -H /usr/local/bin/npm --version >/dev/null
  sudo -u ptc-manager-worker -H /usr/local/bin/npx --version >/dev/null
  sudo -u ptc-manager-worker -H /usr/local/bin/corepack --version >/dev/null
}

install_worker_mise() {
  sudo install -o root -g root -m 0755 "$mise_binary" "$worker_mise"
  sudo -u ptc-manager-worker -H "$worker_mise" --version >/dev/null
}

install_gate_beam_toolchain() {
  sudo install -d -o root -g root -m 0755 "$gate_mise_root" "$gate_mise_data" \
    "$gate_mise_cache" "$gate_mise_state" "$gate_mise_config"

  sudo env -i HOME=/root PATH=/usr/local/bin:/usr/bin:/bin \
    MISE_DATA_DIR="$gate_mise_data" MISE_CACHE_DIR="$gate_mise_cache" \
    MISE_STATE_DIR="$gate_mise_state" MISE_CONFIG_DIR="$gate_mise_config" \
    "$mise_binary" install "erlang@${erlang_version}" "elixir@${elixir_version}"

  installed_erlang=$(sudo env -i HOME=/root PATH=/usr/local/bin:/usr/bin:/bin \
    MISE_DATA_DIR="$gate_mise_data" MISE_CACHE_DIR="$gate_mise_cache" \
    MISE_STATE_DIR="$gate_mise_state" MISE_CONFIG_DIR="$gate_mise_config" \
    "$mise_binary" where "erlang@${erlang_version}")
  installed_elixir=$(sudo env -i HOME=/root PATH=/usr/local/bin:/usr/bin:/bin \
    MISE_DATA_DIR="$gate_mise_data" MISE_CACHE_DIR="$gate_mise_cache" \
    MISE_STATE_DIR="$gate_mise_state" MISE_CONFIG_DIR="$gate_mise_config" \
    "$mise_binary" where "elixir@${elixir_version}")

  if [ "$installed_erlang" != "$gate_erlang_dir" ] ||
    [ "$installed_elixir" != "$gate_elixir_dir" ]; then
    echo "gate BEAM toolchain was installed outside its root-owned prefix" >&2
    return 1
  fi

  for executable in "$gate_erlang_dir/bin/erl" "$gate_erlang_dir/bin/erlc" \
    "$gate_erlang_dir/bin/escript" "$gate_elixir_dir/bin/elixir" \
    "$gate_elixir_dir/bin/elixirc" "$gate_elixir_dir/bin/iex" "$gate_elixir_dir/bin/mix"; do
    if ! sudo test -x "$executable"; then
      echo "gate BEAM command is missing or not executable: $executable" >&2
      return 1
    fi
  done

  if ! sudo find "$gate_erlang_dir" "$gate_elixir_dir" -type l -print |
    while IFS= read -r link; do
      target=$(sudo readlink -f "$link")
      case "$target" in
        "$gate_mise_root"/*) ;;
        *)
          echo "gate toolchain symlink escapes its root-owned prefix: $link" >&2
          exit 1
          ;;
      esac
    done; then
    return 1
  fi

  sudo install -d -o root -g root -m 0755 "$gate_mix_home"

  gate_tool_home=$(sudo mktemp -d /tmp/ptc-manager-gate-toolchain.XXXXXX)
  sudo env -i HOME="$gate_tool_home" MIX_HOME="$gate_mix_home" \
    PATH="$gate_elixir_dir/bin:$gate_erlang_dir/bin:/usr/bin:/bin" LC_ALL=C \
    "$gate_elixir_dir/bin/mix" local.hex --force --if-missing
  sudo env -i HOME="$gate_tool_home" MIX_HOME="$gate_mix_home" \
    PATH="$gate_elixir_dir/bin:$gate_erlang_dir/bin:/usr/bin:/bin" LC_ALL=C \
    "$gate_elixir_dir/bin/mix" local.rebar --force --if-missing
  sudo rm -rf -- "$gate_tool_home"
  gate_tool_home=

  sudo chown -R root:root "$gate_mise_root" "$gate_mix_home"
  sudo chmod -R a+rX,go-w "$gate_mise_root" "$gate_mix_home"

  if ! sudo find "$gate_mix_home/archives" -maxdepth 1 -type d -name 'hex-*' \
    -print -quit | grep -q .; then
    echo "gate Mix home does not contain a Hex archive" >&2
    return 1
  fi

  if ! sudo find "$gate_mix_home" -type f -name rebar3 -perm -u+x -print -quit | grep -q .; then
    echo "gate Mix home does not contain an executable rebar3" >&2
    return 1
  fi

  for command in erl erlc escript; do
    sudo ln -sfn "$gate_erlang_dir/bin/$command" "/usr/local/bin/$command"
  done

  for command in elixir elixirc iex mix; do
    sudo ln -sfn "$gate_elixir_dir/bin/$command" "/usr/local/bin/$command"
  done

  sudo -u ptc-manager-gate env -i HOME=/var/lib/ptc_manager-gate \
    MIX_HOME="$gate_mix_home" PATH=/usr/local/bin:/usr/bin:/bin LC_ALL=C \
    /bin/sh -c 'cd /var/lib/ptc_manager-gate && exec /usr/local/bin/mix --version' >/dev/null
  sudo -u ptc-manager-gate env -i HOME=/var/lib/ptc_manager-gate \
    MIX_HOME="$gate_mix_home" PATH=/usr/local/bin:/usr/bin:/bin LC_ALL=C \
    /bin/sh -c 'cd /var/lib/ptc_manager-gate && exec /usr/local/bin/mix help hex' >/dev/null
}

prune_successful_backups() {
  sudo find /opt -maxdepth 1 -type d -name 'ptc_manager-before-*' -printf '%T@ %p\n' |
    sort -nr |
    awk 'NR > 3 {print $2}' |
    while IFS= read -r old_release; do
      case "$old_release" in
        /opt/ptc_manager-before-*) ;;
        *) continue ;;
      esac

      old_release_id=${old_release#/opt/ptc_manager-before-}
      old_database_backup="${database_path}-before-${old_release_id}"
      sudo rm -rf -- "$old_release"
      sudo rm -f -- "$old_database_backup"
    done
}

rollback() {
  deployment_phase=handling_failure
  rollback_status=0
  echo "New release did not become healthy; restoring the previous release and database." >&2
  sudo systemctl stop "$service_name" || rollback_status=1

  if [ -d "$release_backup" ]; then
    if [ -d "$application_dir" ]; then
      sudo mv "$application_dir" "$failed_release" || rollback_status=1
    fi

    sudo mv "$release_backup" "$application_dir" || rollback_status=1
  elif [ ! -d "$application_dir" ]; then
    rollback_status=1
  fi

  if [ -f "$database_path" ]; then
    sudo mv "$database_path" "$failed_database" || rollback_status=1
  fi

  if [ -f "${database_path}-wal" ]; then
    sudo mv "${database_path}-wal" "${failed_database}-wal" || rollback_status=1
  fi

  if [ -f "${database_path}-shm" ]; then
    sudo mv "${database_path}-shm" "${failed_database}-shm" || rollback_status=1
  fi

  sudo install -o ptc-manager -g ptc-manager -m 0600 "$database_backup" "$database_path" ||
    rollback_status=1
  restore_preexisting_maintenance_override || rollback_status=1
  sudo systemctl start "$service_name" || rollback_status=1

  if [ "$rollback_status" -eq 0 ] && legacy_health_check; then
    echo "Rollback succeeded. Failed artifacts were retained with suffix ${release_id}." >&2
  else
    echo "Rollback did not restore service health; inspect systemd immediately." >&2
  fi
}

finish() {
  exit_status=$?
  trap - EXIT HUP INT TERM
  failure_action=$("$failure_policy" "$deployment_phase")

  case "$failure_action" in
    preserve_current)
      deployment_phase=handling_failure
      install_maintenance_override || true

      if ! pause_new_release; then
        sudo systemctl restart "$service_name" || true
      fi

      echo "Deployment stopped after the canary effect boundary; the new release and current database remain in maintenance mode for forward repair." >&2
      ;;
    restore_snapshot)
      rollback
      ;;
    restart_existing)
      deployment_phase=handling_failure
      echo "Deployment stopped before the release swap; restarting the existing release." >&2
      restore_preexisting_maintenance_override || true
      sudo systemctl start "$service_name" || true
      ;;
    no_action) ;;
  esac

  cleanup_remote
  exit "$exit_status"
}
trap finish EXIT
trap 'exit 130' HUP INT TERM

command -v git >/dev/null
command -v tar >/dev/null
command -v curl >/dev/null
command -v sqlite3 >/dev/null
command -v flock >/dev/null
command -v jq >/dev/null
command -v python3 >/dev/null
[ -x "$failure_policy" ]
[ -x "$mise_binary" ]
[ -x "$manual_herdr" ]
[ -x "$worker_herdr" ]
[ -f "$source_archive" ]
[ -d "$application_dir" ]
[ ! -e "$build_dir" ]
[ ! -e "$release_backup" ]
sudo -n true
tar -xOf "$source_archive" deploy/herdr-busy-agent-count.jq >"$agent_filter"
tar -xOf "$source_archive" deploy/systemd-environment-file-paths.awk >"$environment_file_parser"
tar -xOf "$source_archive" deploy/ptc-manager-worker-git >"$worker_git_candidate"
tar -xOf "$source_archive" deploy/ptc_manager.sudoers >"$sudoers_candidate"
chmod 0755 "$worker_git_candidate"
chmod 0440 "$sudoers_candidate"
sudo visudo -cf "$sudoers_candidate" >/dev/null

coordinator_environment_files=$(
  sudo systemctl show -p EnvironmentFiles --value "$service_name" |
    awk -f "$environment_file_parser"
)

if [ -z "$coordinator_environment_files" ]; then
  echo "PtcManager systemd unit does not declare an environment file" >&2
  exit 1
fi

# EnvironmentFile paths are root-controlled systemd configuration and this
# installation uses paths without whitespace.
# shellcheck disable=SC2086
for environment_file in $coordinator_environment_files; do
  if ! sudo test -f "$environment_file"; then
    echo "configured systemd environment file is missing: $environment_file" >&2
    exit 1
  fi
done

service_pid=$(sudo systemctl show -p MainPID --value "$service_name")
case "$service_pid" in
  *[!0-9]*|''|0)
    echo "PtcManager service does not have a running process" >&2
    exit 1
    ;;
esac

# shellcheck disable=SC2086
configured_database_path=$(read_environment_setting DATABASE_PATH $coordinator_environment_files)
# shellcheck disable=SC2086
configured_health_port=$(read_environment_setting PORT $coordinator_environment_files)
# shellcheck disable=SC2086
configured_coordinator_session=$(read_environment_setting PTC_HERDR_SESSION $coordinator_environment_files)
# shellcheck disable=SC2086
configured_worktree_root=$(read_environment_setting PTC_WORKTREE_ROOT $coordinator_environment_files)
# shellcheck disable=SC2086
configured_gate_user=$(read_environment_setting PTC_PRE_PUBLICATION_RUN_AS_USER $coordinator_environment_files)
# shellcheck disable=SC2086
configured_gate_home=$(read_environment_setting PTC_PRE_PUBLICATION_HOME $coordinator_environment_files)
# shellcheck disable=SC2086
configured_gate_mix_home=$(read_environment_setting PTC_PRE_PUBLICATION_MIX_HOME $coordinator_environment_files)

running_database_path=$(read_process_setting "$service_pid" DATABASE_PATH "")
running_health_port=$(read_process_setting "$service_pid" PORT 4000)
running_coordinator_session=$(read_process_setting "$service_pid" PTC_HERDR_SESSION default)
running_worktree_root=$(read_process_setting "$service_pid" PTC_WORKTREE_ROOT "")

configured_health_port=${configured_health_port:-4000}
configured_coordinator_session=${configured_coordinator_session:-default}
configured_gate_user=${configured_gate_user:-ptc-manager-gate}
configured_gate_home=${configured_gate_home:-/var/lib/ptc_manager-gate}
configured_gate_mix_home=${configured_gate_mix_home:-/opt/ptc-manager-gate-mix}

if [ "$configured_gate_user" != "ptc-manager-gate" ] ||
  [ "$configured_gate_home" != "/var/lib/ptc_manager-gate" ] ||
  [ "$configured_gate_mix_home" != "/opt/ptc-manager-gate-mix" ]; then
  echo "pre-publication gates must use the isolated ptc-manager-gate identity" >&2
  exit 1
fi

if [ "$running_database_path" != "$configured_database_path" ] ||
  [ "$running_health_port" != "$configured_health_port" ] ||
  [ "$running_coordinator_session" != "$configured_coordinator_session" ] ||
  [ "$running_worktree_root" != "$configured_worktree_root" ]; then
  echo "systemd environment files differ from the running services; restart them before deploying" >&2
  exit 1
fi

coordinator_session=$configured_coordinator_session

if sudo systemctl is-active --quiet ptc_manager-herdr; then
  worker_service_pid=$(sudo systemctl show -p MainPID --value ptc_manager-herdr)

  case "$worker_service_pid" in
    *[!0-9]*|''|0)
      echo "active PtcManager Herdr service does not have a running process" >&2
      exit 1
      ;;
  esac

  worker_session=$(read_process_setting "$worker_service_pid" HERDR_SESSION default)
fi

database_path=$configured_database_path
health_port=$configured_health_port
worktree_root=$configured_worktree_root

case "$database_path" in
  /*) ;;
  *)
    echo "running service does not expose an absolute DATABASE_PATH" >&2
    exit 1
    ;;
esac

case "$health_port" in
  *[!0-9]*|'')
    echo "running service exposes an invalid PORT" >&2
    exit 1
    ;;
esac

database_backup="${database_path}-before-${release_id}"
failed_database="${database_path}-failed-${release_id}"
health_url="http://127.0.0.1:${health_port}/health"

if ! sudo test -f "$database_path"; then
  echo "configured SQLite database is missing: $database_path" >&2
  exit 1
fi

if sudo test -e "$database_backup"; then
  echo "database backup path already exists: $database_backup" >&2
  exit 1
fi

exec 9>/run/lock/ptc-manager-deploy.lock
if ! flock -n 9; then
  echo "another PtcManager deployment is already running" >&2
  exit 1
fi

ensure_no_managed_runs
ensure_no_busy_herdr_agents
capture_maintenance_override
ensure_private_worktree_root "$worktree_root"
if ! id -u ptc-manager-gate >/dev/null 2>&1; then
  sudo useradd --system --home /var/lib/ptc_manager-gate --gid ptc-manager-repo \
    --shell /usr/sbin/nologin ptc-manager-gate
fi
if id -nG ptc-manager-gate | tr ' ' '\n' | grep -Fx ptc-manager-publish >/dev/null; then
  echo "ptc-manager-gate must not belong to the publication-staging group" >&2
  exit 1
fi
sudo install -d -o ptc-manager-gate -g ptc-manager-repo -m 0700 \
  /var/lib/ptc_manager-gate
sudo chmod 3770 /var/lib/ptc_manager-output
sudo install -d -o ptc-manager -g ptc-manager-output -m 2750 \
  /var/lib/ptc_manager-output/planning-snapshots
sudo chown ptc-manager-worker:ptc-manager-output /var/lib/ptc_manager-worker
sudo chmod 0710 /var/lib/ptc_manager-worker
sudo install -d -o ptc-manager -g ptc-manager-output -m 3770 "$agent_result_dir"
sudo install -d -o root -g root -m 0755 "$(dirname "$agent_result_env")"
printf '%s\n' "PTC_AGENT_ACTION_OUTPUT_DIR=$agent_result_dir" |
  sudo tee "$agent_result_env" >/dev/null
sudo chmod 0644 "$agent_result_env"
sudo install -d -o root -g root -m 0755 "$(dirname "$agent_result_override")"
printf '%s\n' '[Service]' "EnvironmentFile=$agent_result_env" |
  sudo tee "$agent_result_override" >/dev/null
sudo chmod 0644 "$agent_result_override"
sudo rm -f -- \
  /etc/systemd/system/ptc_manager.service.d/80-ptc-manager-agent-results.conf \
  /etc/systemd/system/ptc_manager.service.d/99-ptc-manager-agent-results.conf
sudo systemctl daemon-reload
install_worker_mise
install_worker_node

# Keep the worker Git bridge and its exact sudo authorization versioned with
# the release so a fresh deploy cannot leave runtime code ahead of host setup.
sudo install -o root -g root -m 0755 "$worker_git_candidate" \
  /usr/local/bin/ptc-manager-worker-git
sudo install -o root -g root -m 0440 "$sudoers_candidate" \
  /etc/sudoers.d/ptc_manager
sudo rm -f -- /etc/sudoers.d/ptc_manager-codex
mkdir -p "$build_dir"
tar -xf "$source_archive" -C "$build_dir"
cd "$build_dir"

echo "Building production release..."
"$mise_binary" x erlang@29.0.3 elixir@1.20.2-otp-29 "node@${node_version}" -- \
  env MIX_ENV=prod PTC_WORKSPACE_CACHE_ROOT="$production_workspace_cache" \
  ./scripts/ptc/bootstrap
"$mise_binary" x erlang@29.0.3 elixir@1.20.2-otp-29 "node@${node_version}" -- \
  env MIX_ENV=prod mix compile
"$mise_binary" x erlang@29.0.3 elixir@1.20.2-otp-29 "node@${node_version}" -- \
  env MIX_ENV=prod mix assets.deploy
"$mise_binary" x erlang@29.0.3 elixir@1.20.2-otp-29 "node@${node_version}" -- \
  env MIX_ENV=prod mix release
install_gate_beam_toolchain

[ -x "$new_release/bin/ptc_manager" ]
ensure_no_busy_herdr_agents

echo "Stopping service and backing up SQLite..."
deployment_phase=service_stopped
sudo systemctl stop "$service_name"
ensure_no_managed_runs
sudo sqlite3 "$database_path" ".backup '$database_backup'"
sudo chown ptc-manager:ptc-manager "$database_backup"
sudo chmod 0600 "$database_backup"

deployment_phase=swapping_pre_effect
sudo mv "$application_dir" "$release_backup"
sudo mv "$new_release" "$application_dir"
sudo chown -R root:root "$application_dir"

echo "Starting release; startup applies pending database migrations..."
install_maintenance_override
sudo systemctl start "$service_name"

health_check maintenance

migration_version=$(sudo sqlite3 -readonly "$database_path" \
  "select coalesce(max(version), 0) from schema_migrations;")

echo "Maintenance health passed. Latest database migration: $migration_version"
echo "Running one allowlisted read-only deployment canary..."
deployment_phase=post_effect
sudo -u ptc-manager -H "$application_dir/bin/ptc_manager" rpc \
  "case PtcManager.DeploymentCanary.run(\"deploy-${release_id}\") do {:ok, result} -> result; {:error, reason} -> raise \"deployment canary failed: #{inspect(reason)}\" end"
health_check canary
remove_maintenance_override

sudo -u ptc-manager -H "$application_dir/bin/ptc_manager" rpc \
  "case PtcManager.DeploymentCanary.activate(\"deploy-${release_id}\") do :ok -> :ok; {:error, reason} -> raise \"deployment activation failed: #{inspect(reason)}\" end"
deployment_phase=complete
echo "Service is healthy and ordinary work is active."
echo "Release backup: $release_backup"
echo "Database backup: $database_backup"
prune_successful_backups
