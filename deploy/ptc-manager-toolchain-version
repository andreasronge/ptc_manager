#!/bin/sh
set -eu

# Print one pinned version from deploy/toolchain-versions.
#
# The deployment builds installation paths out of what this prints, so the whole
# manifest is validated on every read: a line that is not a pin, a key written
# twice, or a key with no usable value stops the deployment. Accepting a
# malformed line would leave the previous version installed while the maintainer
# believes the edit took effect, which is the drift this manifest exists to end.

usage() {
  echo "Usage: ptc-manager-toolchain-version MANIFEST KEY" >&2
  exit 2
}

[ "$#" -eq 2 ] || usage
manifest=$1
key=$2

case "$key" in
  *[!a-z0-9_]*|'')
    echo "toolchain manifest key is not a lowercase word: $key" >&2
    exit 2
    ;;
esac

[ -f "$manifest" ] || { echo "toolchain manifest is missing: $manifest" >&2; exit 2; }

awk -v key="$key" -v manifest="$manifest" '
  /^[ \t]*$/ { next }
  /^#/ { next }

  !/^[a-z0-9_]+=[A-Za-z0-9][A-Za-z0-9._-]*$/ {
    printf "%s line %d is not a pinned version: %s\n", manifest, NR, $0 > "/dev/stderr"
    malformed = 1
    next
  }

  {
    name = substr($0, 1, index($0, "=") - 1)

    if (name in seen) {
      printf "%s pins %s more than once\n", manifest, name > "/dev/stderr"
      malformed = 1
    }

    seen[name] = 1

    if (name == key) {
      value = substr($0, index($0, "=") + 1)
    }
  }

  END {
    if (malformed) {
      exit 2
    }

    if (value == "") {
      printf "%s pins no version for %s\n", manifest, key > "/dev/stderr"
      exit 2
    }

    print value
  }
' "$manifest"
