#!/bin/sh
# Publishes a bounded, read-only view of the console's own runtime so the
# health-watch automation can inspect it.
#
# Root reads the private database and the service journal; the result lands in
# the ptc-manager-output group, which the managed agent user already belongs
# to, so the agent itself needs no privilege. Mirrors
# ptc_manager-herdr-snapshot-write: build a temporary file, fix its mode, then
# move it into place atomically.
#
# Every privileged read is checked before anything is written. A run that
# cannot reach the database or the journal fails loudly and leaves the previous
# snapshot alone, because a snapshot with empty sections is indistinguishable
# from a console that is simply healthy.

set -eu

db="${PTC_HEALTH_DB:-${DATABASE_PATH:-/var/lib/ptc_manager/ptc_manager.db}}"
out="${PTC_HEALTH_OUT:-/var/lib/ptc_manager-output/ptc-health.json}"
unit="${PTC_HEALTH_UNIT:-ptc_manager.service}"
since="${PTC_HEALTH_SINCE:--6 hours}"
max_log_lines=10000
freshness_budget_seconds=3600

fail() {
  echo "ptc-manager-health-snapshot: $1" >&2
  exit 1
}

[ -r "$db" ] || fail "cannot read the database at $db; run this as root"
journalctl -u "$unit" -n 1 --no-pager >/dev/null 2>&1 ||
  fail "cannot read the journal for $unit; run this as root"

# Exclusive creation prevents a guessed temporary-file symlink from turning
# this root write into an overwrite. Raw journal data stays private throughout.
umask 0077
tmp_dir="$(mktemp -d "${out}.tmp.XXXXXX")" || fail "cannot create private staging directory"
tmp="$tmp_dir/snapshot.json"
log="$tmp_dir/journal"
diagnostics="$tmp_dir/diagnostics"
diagnostic_error="$tmp_dir/diagnostic-error"

cleanup() {
  rm -rf "$tmp_dir"
}

trap cleanup EXIT HUP INT TERM


# sqlite3 prints nothing at all for an empty result set, which would leave a
# bare "key": in the object, so an empty answer becomes an empty JSON array. A
# genuine read failure is fatal rather than a third indistinguishable empty
# array.
query() {
  rows="$(sqlite3 -readonly -json "$db" "$1" 2>&1)" ||
    fail "database query failed: $rows"

  if [ -z "$rows" ]; then
    printf '[]'
  else
    printf '%s' "$rows"
  fi
}

# Read once, check the actual read, and bound the privileged input. A successful
# preflight cannot prove this later read succeeded.
journalctl -u "$unit" --since "$since" -n "$max_log_lines" --no-pager \
  --quiet -o json >"$log" 2>/dev/null ||
  fail "cannot read the journal; leaving the previous snapshot in place"

# Search before applying the line cap. A busy service can otherwise fill the
# tail with sudo session messages and hide older SQLite failures in the window.
if journalctl -u "$unit" --since "$since" -n "$max_log_lines" --no-pager \
  --quiet -o json \
  -g '\[(error|warning)\]|SQLite|[Dd]atabase (busy|is locked)|\*\* \(|terminating|Function: ' \
  >"$diagnostics" 2>"$diagnostic_error"; then
  :
else
  status=$?
  # journalctl returns 1 when --grep has no matches. Quiet mode leaves both
  # streams empty in that case; a read failure still preserves the old file.
  if [ "$status" -ne 1 ] || [ -s "$diagnostics" ] || [ -s "$diagnostic_error" ]; then
    fail "cannot read diagnostic journal lines; leaving the previous snapshot in place"
  fi
fi

diagnostic_count="$(jq -s 'length' "$diagnostics")" ||
  fail "cannot parse diagnostic journal entries; leaving the previous snapshot in place"

live_run_states="'queued','starting','working','idle','blocked','waiting','unknown'"

{
  printf '{"captured_at":"%s"' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf ',"freshness_budget_seconds":%s' "$freshness_budget_seconds"

  printf ',"capacity_settings":'
  query "select light_agent_capacity, heavy_agent_capacity, operation_capacity
         from capacity_settings;"

  printf ',"live_agent_runs":'
  query "select id, job_id, agent_action_id, role, state, worker_id, started_at, last_heartbeat_at
         from agent_runs
         where state in ($live_run_states)
         order by id limit 500;"

  printf ',"live_agent_actions":'
  query "select id, repository_id, state, target_type, target_id,
                attempt_count, requested_at, started_at
         from agent_actions
         where state in ('queued','running','sync_pending')
         order by id limit 500;"

  printf ',"live_resource_operations":'
  query "select id, state, slot_number, job_id, agent_action_id, agent_run_id,
                queued_at, started_at
         from resource_operations
         where state in ('queued','starting','running','cancelling','recovery_pending')
         order by id limit 500;"

  printf ',"recent_resource_operations":'
  query "select id, state, agent_run_id, agent_action_id, job_id, queued_at,
                started_at, finished_at, wait_duration_ms, run_duration_ms
         from resource_operations
         order by id desc
         limit 40;"

  printf ',"live_jobs":'
  query "select id, state, fencing_token, lease_expires_at, updated_at
         from jobs
         where state not in ('done','failed','cancelled')
         order by id limit 500;"

  # Never export exception text: it may contain SQL parameters, credentials,
  # private summaries, or instructions planted in an agent-controlled value.
  printf ',"service_log_volume":'
  jq -s --arg window "$since" --argjson limit "$max_log_lines" \
    --argjson diagnostic_count "$diagnostic_count" '
    map(.MESSAGE // "" | tostring) as $messages |
    {window: $window, line_limit: $limit, at_limit: ($messages | length >= $limit),
     total_lines: ($messages | length),
     session_noise_lines: ($messages | map(select(test("sudo\\[|pam_unix"))) | length),
     error_lines: $diagnostic_count,
     diagnostic_at_limit: ($diagnostic_count >= $limit)}
  ' "$log"

  printf '}\n'
} >"$tmp"

jq -e 'type == "object"' <"$tmp" >/dev/null ||
  fail "produced invalid JSON; leaving the previous snapshot in place"

chmod 0640 "$tmp"
chgrp ptc-manager-output "$tmp"
# Unlike mv, replace never interprets an existing symlink as a destination
# directory. The output directory is shared (sticky), so an agent can precreate
# this name before the first root-owned snapshot exists.
/usr/bin/python3 -I -c 'import os, sys; os.replace(sys.argv[1], sys.argv[2])' "$tmp" "$out"
cleanup

trap - EXIT HUP INT TERM
