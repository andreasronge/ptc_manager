[Unit]
Description=Herdr worker for PtcManager
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ptc-manager-worker
Group=ptc-manager-worker
WorkingDirectory=/srv/ptc_runner
EnvironmentFile=/etc/ptc_manager/herdr.env
ExecStart=/usr/local/bin/herdr --session ${HERDR_SESSION} server
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ptc_manager-worker /srv/ptc_runner

[Install]
WantedBy=multi-user.target
