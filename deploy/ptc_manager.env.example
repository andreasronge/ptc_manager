DATABASE_PATH=/var/lib/ptc_manager/ptc_manager.db
SECRET_KEY_BASE=replace-with-mix-phx-gen-secret-output
PTC_MANAGER_PASSWORD=replace-with-a-unique-password-of-at-least-16-characters
PHX_HOST=replace-with-your-server-name.your-tailnet.ts.net
PORT=4000
PTC_DEPLOYMENT_START_TIMEOUT_MS=60000
PTC_DEPLOYMENT_COMPLETION_GRACE_MS=60000

# Initial repository checkout used to seed or reconcile the original single
# repository. Remove this legacy variable before adding another repository;
# each repository then owns its persisted absolute checkout path.
# Required before enabling GitHub issue synchronization. Use a fine-grained,
# read-only token as documented in README.md.
GITHUB_READ_TOKEN=
PTC_REPOSITORY_PATH=/srv/ptc_runner
PTC_GITHUB_SYNC_INTERVAL_MS=0

# Observe and optionally control one Herdr session owned by the isolated worker.
PTC_HERDR_SESSION=default
PTC_HERDR_BINARY=/usr/local/bin/herdr
PTC_HERDR_RUN_AS_USER=ptc-manager-worker
PTC_HERDR_GIT_BINARY=/usr/local/bin/ptc-manager-worker-git
PTC_WORKSPACE_BOOTSTRAP_WRAPPER=/usr/local/bin/ptc-manager-worker-bootstrap
PTC_HERDR_SOCKET_PATH=
PTC_HERDR_SYNC_INTERVAL_MS=10000
PTC_HERDR_TIMEOUT_MS=15000
PTC_HERDR_STALE_AFTER_MS=60000

# Leave dispatch false until the worker has Codex/Claude authentication and a
# writable checkout. Maintainer actions additionally require authenticated gh.
PTC_DISPATCH_ENABLED=false
PTC_AGENT_ACTIONS_ENABLED=false
PTC_AGENT_ACTION_INTERVAL_MS=5000
PTC_LIGHT_AGENT_CAPACITY=2
PTC_HEAVY_AGENT_CAPACITY=1
PTC_OPERATION_CAPACITY=1
PTC_OPERATION_SOCKET_PATH=/var/lib/ptc_manager-worker/agent-results/operations.sock
PTC_OPERATION_WRAPPER=/usr/local/bin/ptc-operation
PTC_OPERATION_CONTEXT_DIR=/var/lib/ptc_manager-worker/agent-results/operation-contexts
PTC_OPERATION_CGROUPS=true
PTC_OPERATION_AGENT_CONTEXT=/usr/local/libexec/ptc-manager-agent-context
PTC_OPERATION_RECOVERY_COMMAND=/usr/bin/sudo
PTC_OPERATION_RECOVERY_HELPER=/usr/local/bin/ptc-manager-operation-recover
PTC_AGENT_MEMORY_HIGH_BYTES=2684354560
PTC_AGENT_MEMORY_MAX_BYTES=3221225472
PTC_OPERATION_MEMORY_HIGH_BYTES=2147483648
PTC_OPERATION_MEMORY_MAX_BYTES=2684354560
PTC_AGENT_ACTION_TIMEOUT_MS=7200000
PTC_AGENT_ACTION_SYNC_RETRY_BASE_MS=5000
PTC_AGENT_ACTION_SYNC_RETRY_MAX_MS=300000
PTC_AGENT_ACTION_RUN_AS_USER=ptc-manager-worker
PTC_AGENT_ACTION_OUTPUT_DIR=/var/lib/ptc_manager-worker/agent-results
PTC_DAILY_DIGEST_ENABLED=false
PTC_DAILY_DIGEST_HOUR=2
PTC_DAILY_DIGEST_TIME_ZONE=Europe/Stockholm
PTC_DAILY_DIGEST_INTERVAL_MS=60000
PTC_PLANNING_SNAPSHOT_ROOT=/var/lib/ptc_manager-output/planning-snapshots
PTC_PLANNING_GIT_BINARY=/usr/bin/git
PTC_PLANNING_SNAPSHOT_PERMISSION_CHECK=true
# Legacy external-repair broker settings retained for compatible installations.
# Current imported PR repair runs use the configured Herdr worker identity,
# session, repository checkout, and PTC_WORKTREE_ROOT above/below.
PTC_EXTERNAL_PR_RUN_AS_USER=ptc-manager-external
PTC_EXTERNAL_PR_GROUP=ptc-manager-external
PTC_EXTERNAL_PR_WORKTREE_ROOT=/srv/ptc_manager-external
PTC_EXTERNAL_PR_PUSH_RUN_AS_USER=ptc-manager-worker
PTC_EXTERNAL_PR_PUSH_WRAPPER=/usr/local/bin/ptc-manager-external-push
PTC_EXTERNAL_PR_CLEANUP_WRAPPER=/usr/local/bin/ptc-manager-external-cleanup
PTC_EXTERNAL_PR_GIT_WRAPPER=/usr/local/bin/ptc-manager-external-git
PTC_DISPATCH_INTERVAL_MS=5000
PTC_DISPATCH_LEASE_MS=1800000
# An implementation agent that returns idle without finishing releases its
# execution slot after this deadline. Its worktree and partial work are kept.
PTC_IMPLEMENTATION_IDLE_TIMEOUT_MS=300000
PTC_DISPATCH_RECONCILE_AFTER_MS=60000
PTC_IMPLEMENTATION_AGENT_KIND=codex
PTC_IMPLEMENTATION_AGENT_ARGS=--dangerously-bypass-approvals-and-sandbox
# Generic Herdr profiles. Each key is passed to `herdr agent start --kind`.
# Add Claude/Cursor only after their worker identity is installed and authenticated.
# Arguments may use {{workspace_path}} or the quoted/escaped
# {{workspace_path_toml}} placeholder. Codex needs the latter to trust each
# ephemeral managed worktree without an interactive startup prompt.
PTC_AGENT_PROFILES_JSON={"codex":{"enabled":true,"args":["--dangerously-bypass-approvals-and-sandbox","-c","projects={{{workspace_path_toml}}={trust_level=\"trusted\"}}"]}}
PTC_IMPLEMENTATION_AGENT_START_TIMEOUT_MS=120000
# Trial mode: let the authenticated coding agent push its fenced branch and
# create the PR. Keep false when using PtcManager's GitHub App publisher.
PTC_IMPLEMENTATION_AGENT_PUBLISHES_PR=false
PTC_WORKTREE_ROOT=/srv/ptc_manager-worktrees
PTC_WORKTREE_RECONCILE_INTERVAL_MS=30000
PTC_RESULT_RECONCILE_INTERVAL_MS=10000
PTC_RESULT_CLAIM_TIMEOUT_MS=180000
PTC_PR_RECONCILE_ENABLED=true
PTC_PR_STATUS_INTERVAL_MS=60000
PTC_GIT_BINARY=/usr/bin/git
PTC_GIT_RUN_AS_USER=ptc-manager-verifier
PTC_GIT_VERIFIER_HOME=/var/lib/ptc_manager-verifier
PTC_GIT_TIMEOUT_MS=15000
PTC_GIT_TIMEOUT_BINARY=/usr/bin/timeout
PTC_EXTERNAL_PR_COMMAND_TIMEOUT_MS=180000
PTC_GIT_DIFF_MAX_BYTES=50000000
PTC_GIT_MAX_COMMITS=100
PTC_GIT_MAX_CHANGED_PATHS=100
PTC_GIT_MAX_BLOB_BYTES=10000000
PTC_GIT_MAX_TOTAL_BLOB_BYTES=50000000
PTC_GIT_MEMORY_LIMIT_BINARY=/usr/bin/prlimit
PTC_GIT_MEMORY_LIMIT_BYTES=268435456

# Exact-SHA repository gates run in a disposable checkout owned by the
# credential-free gate account. The contract supplies the commands and
# timeouts; these settings supply only the trusted execution boundary.
PTC_PRE_PUBLICATION_RUN_AS_USER=ptc-manager-gate
PTC_PRE_PUBLICATION_HOME=/var/lib/ptc_manager-gate
PTC_PRE_PUBLICATION_MIX_HOME=/opt/ptc-manager-gate-mix
PTC_PRE_PUBLICATION_PATH=/usr/local/bin:/usr/bin:/bin
PTC_PRE_PUBLICATION_GIT_BINARY=/usr/bin/git
PTC_PRE_PUBLICATION_TIMEOUT_BINARY=/usr/bin/timeout

# Publication starts after PtcManager verifies the exact committed branch result.
# Review passes are requested in the coding-agent prompt. The App is installed
# only on this repository.
PTC_PUBLICATION_ENABLED=false
PTC_PUBLICATION_INTERVAL_MS=5000
PTC_PUBLICATION_CLAIM_TIMEOUT_MS=180000
# Renew a fenced publication claim while a long exact-SHA gate is running.
PTC_PUBLICATION_GATE_RENEWAL_INTERVAL_MS=60000
PTC_PUBLICATION_MAX_ATTEMPTS=5
PTC_PUBLICATION_RETRY_BASE_MS=5000
PTC_PUBLICATION_RETRY_MAX_MS=300000
PTC_GITHUB_APP_ID=
PTC_GITHUB_APP_INSTALLATION_ID=
PTC_GITHUB_APP_PRIVATE_KEY_PATH=/etc/ptc_manager/github-app.pem
PTC_GITHUB_BROKER_HOME=/var/lib/ptc_manager
PTC_GITHUB_PUBLISH_STAGING_ROOT=/var/lib/ptc_manager-publish
PTC_GITHUB_PUBLISH_STAGING_STALE_MS=3600000
PTC_GITHUB_PUBLISH_BUNDLE_MAX_BYTES=250000000
PTC_GITHUB_PUSH_TIMEOUT_BINARY=/usr/bin/timeout
PTC_GITHUB_PUSH_TIMEOUT_MS=60000
