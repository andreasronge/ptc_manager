DATABASE_PATH=/var/lib/ptc_manager/ptc_manager.db
SECRET_KEY_BASE=replace-with-mix-phx-gen-secret-output
PTC_MANAGER_PASSWORD=replace-with-a-unique-password-of-at-least-16-characters
PHX_HOST=replace-with-your-server-name.your-tailnet.ts.net
PORT=4000

# One read-only GitHub repository and its checkout on this server.
GITHUB_READ_TOKEN=
PTC_REPOSITORY_PATH=/srv/ptc_runner
PTC_GITHUB_SYNC_INTERVAL_MS=300000

# Observe and optionally control one Herdr session owned by the isolated worker.
PTC_HERDR_SESSION=default
PTC_HERDR_BINARY=/usr/local/bin/herdr
PTC_HERDR_RUN_AS_USER=ptc-manager-worker
PTC_HERDR_SOCKET_PATH=
PTC_HERDR_SYNC_INTERVAL_MS=10000
PTC_HERDR_TIMEOUT_MS=15000
PTC_HERDR_STALE_AFTER_MS=60000

# Leave dispatch false until the worker has Codex/Claude authentication and a
# writable checkout. Maintainer actions additionally require authenticated gh.
PTC_DISPATCH_ENABLED=false
PTC_AGENT_ACTIONS_ENABLED=false
PTC_AGENT_ACTION_INTERVAL_MS=5000
PTC_AGENT_ACTION_TIMEOUT_MS=1800000
PTC_AGENT_ACTION_SYNC_RETRY_BASE_MS=5000
PTC_AGENT_ACTION_SYNC_RETRY_MAX_MS=300000
PTC_AGENT_ACTION_RUN_AS_USER=ptc-manager-worker
PTC_AGENT_ACTION_OUTPUT_DIR=/var/lib/ptc_manager-output
PTC_DISPATCH_INTERVAL_MS=5000
PTC_DISPATCH_LEASE_MS=1800000
PTC_DISPATCH_RECONCILE_AFTER_MS=60000
PTC_IMPLEMENTATION_AGENT_CAPACITY=1
PTC_IMPLEMENTATION_AGENT_KIND=codex
PTC_IMPLEMENTATION_AGENT_ARGS=--full-auto
PTC_IMPLEMENTATION_AGENT_START_TIMEOUT_MS=60000
# Trial mode: let the authenticated coding agent push its fenced branch and
# create the PR. Keep false when using PtcManager's GitHub App publisher.
PTC_IMPLEMENTATION_AGENT_PUBLISHES_PR=false
PTC_WORKTREE_ROOT=/srv/ptc_manager-worktrees
PTC_WORKTREE_RECONCILE_INTERVAL_MS=30000
# Optional global override. Leave blank/omit to use each repository's stored value.
PTC_REQUIRED_PRE_PR_REVIEWS=2
# Optional exact command included in each implementation task.
PTC_IMPLEMENTATION_TEST_COMMAND=
PTC_RESULT_RECONCILE_INTERVAL_MS=10000
PTC_RESULT_CLAIM_TIMEOUT_MS=180000
PTC_PR_RECONCILE_ENABLED=true
PTC_PR_STATUS_INTERVAL_MS=60000
PTC_GIT_BINARY=/usr/bin/git
PTC_GIT_RUN_AS_USER=ptc-manager-verifier
PTC_GIT_VERIFIER_HOME=/var/lib/ptc_manager-verifier
PTC_GIT_TIMEOUT_MS=15000
PTC_GIT_TIMEOUT_BINARY=/usr/bin/timeout
PTC_GIT_DIFF_MAX_BYTES=50000000
PTC_GIT_MAX_COMMITS=100
PTC_GIT_MAX_CHANGED_PATHS=100
PTC_GIT_MAX_BLOB_BYTES=10000000
PTC_GIT_MAX_TOTAL_BLOB_BYTES=50000000
PTC_GIT_MEMORY_LIMIT_BINARY=/usr/bin/prlimit
PTC_GIT_MEMORY_LIMIT_BYTES=268435456

# Publication starts after PtcManager verifies the exact committed branch result.
# Review passes are requested in the coding-agent prompt. The App is installed
# only on this repository.
PTC_PUBLICATION_ENABLED=false
PTC_PUBLICATION_INTERVAL_MS=5000
PTC_PUBLICATION_CLAIM_TIMEOUT_MS=180000
PTC_PUBLICATION_MAX_ATTEMPTS=5
PTC_PUBLICATION_RETRY_BASE_MS=5000
PTC_PUBLICATION_RETRY_MAX_MS=300000
PTC_GITHUB_APP_ID=
PTC_GITHUB_APP_INSTALLATION_ID=
PTC_GITHUB_APP_PRIVATE_KEY_PATH=/etc/ptc_manager/github-app.pem
PTC_GITHUB_BROKER_HOME=/var/lib/ptc_manager
PTC_GITHUB_PUBLISH_STAGING_ROOT=/var/lib/ptc_manager-publish
PTC_GITHUB_PUBLISH_STAGING_STALE_MS=3600000
PTC_GITHUB_PUBLISH_BUNDLE_MAX_BYTES=250000000
PTC_GITHUB_PUSH_TIMEOUT_BINARY=/usr/bin/timeout
PTC_GITHUB_PUSH_TIMEOUT_MS=60000

# Codex runs as a separate OS user that cannot read this service's secrets.
PTC_CODEX_MANAGER_ENABLED=false
PTC_CODEX_BINARY=/usr/local/bin/ptc-manager-codex-exec
PTC_CODEX_RUN_AS_USER=ptc-manager-codex
PTC_CODEX_OUTPUT_DIR=/var/lib/ptc_manager-output
PTC_CODEX_MANAGER_TIMEOUT_MS=120000
PTC_CODEX_MANAGER_CONCURRENCY=1
