#!/bin/sh
set -eu

# Runs a repository's workspace setup command as the worker in one managed
# worktree. The command is a maintainer's repository setting, not repository
# content. An optional environment file carries the repository's agent
# variables, since sudo passes no environment.

worktree_root=/srv/ptc_manager-worktrees

fail() {
  echo "ptc-manager-worker-bootstrap: $1" >&2
  exit 2
}

[ "$#" -eq 2 ] || [ "$#" -eq 3 ] || fail "expected WORKTREE COMMAND [ENVIRONMENT_FILE]"

worktree=$1
command=$2

[ -n "$command" ] || fail "command must not be empty"
[ ! -L "$worktree" ] || fail "worktree must not be a symlink"

root_real=$(/usr/bin/realpath -e -- "$worktree_root") || fail "worktree root is unavailable"
worktree_real=$(/usr/bin/realpath -e -- "$worktree") || fail "worktree is unavailable"

case "$worktree_real" in
  "$root_real"/*) ;;
  *) fail "worktree is outside the managed root" ;;
esac

if [ "$#" -eq 3 ]; then
  environment_file=$3
  [ ! -L "$environment_file" ] || fail "environment file must not be a symlink"
  [ -f "$environment_file" ] || fail "environment file is not a regular file"
  set -a
  . "$environment_file"
  set +a
fi

cd "$worktree_real"
exec /bin/sh -c "$command" </dev/null
