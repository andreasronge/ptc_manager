#!/bin/sh
set -eu

# Validates a generated repository access drop-in before it is installed into a
# unit that runs as root.
#
# systemd only warns about a directive it cannot parse, so asking it to verify a
# drop-in proves nothing: an unknown key is ignored and the unit still starts.
# The generated content is checked here instead. Every line must be the header,
# the section, or one grant of an absolute path under /srv, so a checkout path
# carrying a newline or a stray character cannot become a silent directive.

fail() {
  echo "ptc-manager-check-access-dropin: $1" >&2
  exit 1
}

[ "$#" -eq 1 ] || fail "expected one drop-in path"
candidate=$1
[ -f "$candidate" ] || fail "drop-in does not exist: $candidate"

grants=0

while IFS= read -r line; do
  case "$line" in
    '# Generated by the PtcManager deployment. Do not edit.'|'[Service]'|'') continue ;;
    'ReadWritePaths=-/srv/'*) ;;
    *) fail "unexpected line: $line" ;;
  esac

  case "$line" in
    *[!A-Za-z0-9_./=-]*) fail "unsafe characters in grant: $line" ;;
    *..*) fail "unnormalized path in grant: $line" ;;
  esac

  grants=$((grants + 1))
done <"$candidate"

case "$(head -n 2 "$candidate")" in
  '# Generated by the PtcManager deployment. Do not edit.'*'[Service]') ;;
  *) fail "drop-in does not begin with the generated header and [Service]" ;;
esac

[ "$grants" -gt 0 ] || fail "drop-in grants nothing; refusing to install an empty override"
