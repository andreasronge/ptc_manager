#!/bin/sh
set -eu

# Prepares every configured repository so both services can write its checkout,
# without building a release.
#
# PtcManager cannot do this itself: the coordinator runs with
# ProtectSystem=strict, so /srv is read-only inside its mount namespace even for
# root. This runs from its own unit, outside that namespace, triggered through
# the one narrowly scoped sudo rule the coordinator holds — the same escape
# hatch self-deployment uses.
#
# It deliberately restarts nothing. A grant only enters a namespace when the
# service starts, and restarting ptc_manager-herdr ends every retained agent
# session, so which services restart and when stays a maintainer's decision.
# Configuration reports what is still outstanding.

database_path=${PTC_PROVISION_DATABASE_PATH:-/var/lib/ptc_manager/ptc_manager.db}
unit_root=${PTC_PROVISION_UNIT_ROOT:-/etc/systemd/system}
repositories_query=${PTC_PROVISION_REPOSITORIES_QUERY:-/usr/local/libexec/ptc-manager-configured-repositories.sql}
dropin_check=${PTC_PROVISION_DROPIN_CHECK:-/usr/local/bin/ptc-manager-check-access-dropin}
lock=/run/lock/ptc-manager-provision-repository.lock

fail() {
  echo "ptc-manager-provision-repository: $1" >&2
  exit 1
}

exec 9>"$lock"
flock -n 9 || fail "another repository provisioning run is already active"

[ -f "$database_path" ] || fail "database not found: $database_path"
[ -r "$repositories_query" ] || fail "repositories query not found: $repositories_query"
[ -x "$dropin_check" ] || fail "drop-in check not found: $dropin_check"

# Every path under /srv belongs to the worker identity with a group the
# deployment user is not in, so a bare test would report an existing checkout as
# missing. Ask through sudo, as every other access to these paths does.
checkout_prepared() { sudo test -d "$1/.git"; }
checkout_occupied() { sudo test -e "$1"; }


configured=$(sudo sqlite3 -readonly "$database_path" <"$repositories_query")

printf '%s\n' "$configured" | while IFS='|' read -r owner name checkout; do
  [ -n "$checkout" ] || continue

  case "$owner$name" in
    *[!A-Za-z0-9_.-]*|'') fail "configured repository name is unsafe: $owner/$name" ;;
  esac
  case "$checkout" in
    /srv/*) ;;
    *) fail "configured checkout path is not under /srv: $checkout" ;;
  esac
  case "$checkout" in
    *..*) fail "configured checkout path is not normalized: $checkout" ;;
  esac

  checkout_prepared "$checkout" && continue

  if checkout_occupied "$checkout"; then
    fail "configured checkout path exists but is not a Git repository: $checkout"
  fi

  echo "Preparing checkout for $owner/$name at $checkout"
  sudo git clone --quiet "https://github.com/$owner/$name" "$checkout"
  sudo chown -R ptc-manager-worker:ptc-manager-repo "$checkout"
  sudo chmod -R g-w,g+rX,o-rwx "$checkout"
  sudo find "$checkout" -type d -exec chmod g+s {} +
done

write_dropin() {
  suffix=$1
  target=$2

  {
    printf '# Generated by the PtcManager deployment. Do not edit.\n'
    printf '[Service]\n'
    printf '%s\n' "$configured" | while IFS='|' read -r _owner _name checkout; do
      [ -n "$checkout" ] || continue
      printf 'ReadWritePaths=-%s%s\n' "$checkout" "$suffix"
    done
  } >"$target"
}

manager_dropin=$(mktemp)
worker_dropin=$(mktemp)
trap 'rm -f -- "$manager_dropin" "$worker_dropin"' EXIT HUP INT TERM

write_dropin /.git "$manager_dropin"
write_dropin "" "$worker_dropin"
"$dropin_check" "$manager_dropin"
"$dropin_check" "$worker_dropin"
chmod 0644 "$manager_dropin" "$worker_dropin"

sudo install -d -o root -g root -m 0755 "$unit_root/ptc_manager.service.d"
sudo install -d -o root -g root -m 0755 "$unit_root/ptc_manager-herdr.service.d"
sudo install -o root -g root -m 0644 "$manager_dropin" \
  "$unit_root/ptc_manager.service.d/zz-ptc-manager-repositories.conf"
sudo install -o root -g root -m 0644 "$worker_dropin" \
  "$unit_root/ptc_manager-herdr.service.d/zz-ptc-manager-repositories.conf"
sudo systemctl daemon-reload

echo "Repository access prepared. Restart the services to take it up."
