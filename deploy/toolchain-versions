# Every third-party program the deployment installs on the Herdr machine, and
# the only place its version is written. The deployment installs exactly what
# this file names, checks the version it actually got, and links it onto the
# worker's PATH; the release compiles the same values in, so the Deployments
# page can report what the machine links against what this commit pins.
#
# Updating a program is a change to this file and a deployment, never a command
# run on the host. Every line is either blank, a comment starting with "#", or
# one "key=value" pin; anything else stops the deployment rather than silently
# leaving the previous version in place.

node=22.23.2
pnpm=10.34.5
erlang=29.0.3
elixir=1.20.2-otp-29
codex=0.156.1
claude_code=2.1.280
cursor_agent=2026.09.18-9a7762b

# The Cursor CLI publishes no digest of its own, so this one was taken from the
# pinned archive and holds it still: a deployment refuses an archive whose
# sha256 differs, and a version bump comes with a new digest.
cursor_agent_sha256=b1308f5a2fc05458b9d8966752986bb23a971bbcc67c842c1df94c4b8132bad9

# Herdr publishes each release and its digest at https://herdr.dev/latest.json.
# Its remote protocol pin is checked by the deployment bridge canary, so a
# version bump must verify and update both values. Mise publishes SHASUMS256.txt
# beside each release. The deployment refuses a download whose sha256 is not
# exactly the one named here.
herdr=0.9.1
herdr_protocol=22
herdr_sha256=2a02fed16beb651ef006e1d43f048f652ca4dc58ad053cd2d44450563d5c54b7
mise=2026.8.14
mise_sha256=7cd12d6002d5b3c83a89cad79023712faf2a36f9e8b2ee2061dac5135b3de0ed

# The pre-publication gate builds with these. Hex is pinned by version, while
# Rebar has no version to ask for, so it is pinned by the digest of the script
# Hex's CDN serves; the deployment hashes what it installed, because mix accepts
# a mismatched --sha512 when --force is given.
hex=2.5.1
rebar3_sha512=992fd755b7926fae455e5e07d9d195f4d3e7f181609eed1b9cabfe548624df10d148cd4b59bda40bebb185d3d68f9a9fd68a70b294101c8ad9cf0fadcc683d24
