ptc-manager ALL=(ptc-manager-worker) NOPASSWD: /usr/local/bin/herdr
agent ALL=(ptc-manager-worker) NOPASSWD: /usr/local/bin/ptc-manager-herdr-worker-bridge
ptc-manager ALL=(ptc-manager-worker) NOPASSWD: /usr/local/bin/ptc-manager-worker-git
ptc-manager ALL=(ptc-manager-worker) NOPASSWD: /usr/local/bin/ptc-manager-worker-bootstrap
ptc-manager ALL=(ptc-manager-worker) NOPASSWD: /usr/local/bin/ptc-manager-worker-claude-trust
ptc-manager ALL=(ptc-manager-worker) NOPASSWD: /usr/local/bin/ptc-manager-worker-codex-arm
ptc-manager ALL=(ptc-manager-worker) NOPASSWD: /usr/local/bin/ptc-manager-worker-agent-login
ptc-manager ALL=(ptc-manager-worker) NOPASSWD: /usr/local/bin/ptc-manager-worker-gh-label
ptc-manager ALL=(ptc-manager-external) NOPASSWD: /usr/local/bin/ptc-manager-external-git
ptc-manager ALL=(ptc-manager-external) NOPASSWD: /usr/local/bin/ptc-manager-external-cleanup
ptc-manager ALL=(ptc-manager-worker) NOPASSWD: /usr/local/bin/ptc-manager-external-push
ptc-manager ALL=(ptc-manager-verifier) NOPASSWD: /usr/bin/env
