# Example environment for a macOS PtcManager host (launchd, same account).
# The launchers in deploy/launchd source this file; keep it readable only by
# the maintainer account. See docs/maintainers/host-profiles.md.

# --- Host profile ------------------------------------------------------------
# A Darwin release selects the macOS profile and refuses to boot without an
# absolute service root, with PTC_HERDR_RUN_AS_USER set, or with
# PTC_OPERATION_CGROUPS=true. Every host path defaults to a location under it.
export PTC_MACOS_SERVICE_ROOT=/Users/Shared/ptc-services
# The registered ptc_manager checkout this member deploys its own release from.
export PTC_MACOS_SOURCE=/Users/MAINTAINER/developer/ptc_manager

# --- Release ------------------------------------------------------------------
export HOME=/Users/MAINTAINER
export PATH=/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin
export DATABASE_PATH=/Users/Shared/ptc-services/data/ptc_manager.db
export SECRET_KEY_BASE=replace-with-mix-phx.gen.secret
export PTC_MANAGER_PASSWORD=replace-with-at-least-16-characters
export PHX_SERVER=true
export PHX_HOST=mac-mini.tailnet.ts.net
export PORT=4000
export GITHUB_READ_TOKEN=replace-with-a-read-only-token

# --- Herdr and agents ---------------------------------------------------------
export PTC_HERDR_BINARY=/opt/homebrew/bin/herdr
export PTC_HERDR_SESSION=default
export PTC_HERDR_SYNC_INTERVAL_MS=5000
export PTC_WORKTREE_ROOT=/Users/MAINTAINER/developer/worktrees
export PTC_RETAINED_ARTIFACT_ROOT=/Users/Shared/ptc-services/data/retained
export PTC_AGENT_ACTION_OUTPUT_DIR=/Users/Shared/ptc-services/data/agent-results
# Unattended launch flags (Codex's update check) are added in code.
export PTC_AGENT_PROFILES_JSON='{"codex":{"enabled":true,"args":["--dangerously-bypass-approvals-and-sandbox"]}}'

# --- Work -----------------------------------------------------------------------
export PTC_DISPATCH_ENABLED=true
export PTC_AGENT_ACTIONS_ENABLED=true
# Agents publish their own pull requests with the account's `gh` login.
export PTC_IMPLEMENTATION_AGENT_PUBLISHES_PR=true
# Finished jobs reconcile every 10 seconds by default on macOS while
# dispatching; an explicit 0 fails the reconcile readiness check.
# export PTC_RESULT_RECONCILE_INTERVAL_MS=10000
# Import pull requests PtcManager did not open (follows PR reconciliation).
# export PTC_EXTERNAL_PR_RECONCILE_ENABLED=false

# --- Host paths (each defaults under PTC_MACOS_SERVICE_ROOT) -------------------
# export PTC_OPERATION_WRAPPER=/Users/Shared/ptc-services/bin/ptc-operation
# export PTC_OPERATION_SOCKET_PATH=/Users/Shared/ptc-services/run/operations.sock
# export PTC_OPERATION_CONTEXT_DIR=/Users/Shared/ptc-services/data/operation-contexts
# export PTC_EXECUTION_ARTIFACT_ROOT=/Users/Shared/ptc-services/data/execution-artifacts
# export PTC_PLANNING_SNAPSHOT_ROOT=/Users/Shared/ptc-services/data/planning-snapshots
# export PTC_DAILY_DIGEST_BUNDLE_ROOT=/Users/Shared/ptc-services/data/daily-digest-bundles
# export PTC_TOOL_INVENTORY_DIR=/Users/Shared/ptc-services/data/tool-inventory
# export PTC_HEALTH_OUT=/Users/Shared/ptc-services/data/health.json

# --- Several machines (optional) -------------------------------------------------
# export PTC_MACHINE_ID=mac-mini
# export PTC_MACHINE_NAME="Mac mini"
# export PTC_CLUSTER_MEMBERS='{"herdr-build-01":"https://herdr-build-01.tailnet.ts.net","mac-mini":"https://mac-mini.tailnet.ts.net"}'
# export PTC_CLUSTER_SECRET=replace-with-at-least-32-bytes
