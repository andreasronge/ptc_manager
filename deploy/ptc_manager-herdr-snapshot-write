#!/bin/sh

set -eu

session="${HERDR_SESSION:-default}"
snapshot_path="${HERDR_SNAPSHOT_PATH:-/var/lib/ptc_manager-output/herdr-agents.json}"
temporary_path="${snapshot_path}.tmp.$$"

cleanup() {
  rm -f "$temporary_path"
}

trap cleanup EXIT HUP INT TERM
umask 0027

/usr/local/bin/herdr --session "$session" agent list >"$temporary_path"
chmod 0640 "$temporary_path"
mv -f "$temporary_path" "$snapshot_path"

trap - EXIT HUP INT TERM
